<%- include('partials/header') %>

<div class="main-homepage-wrapper">

    <!-- ===== HERO SECTION (Clean & Modern) ===== -->
    <section class="hero-clean-modern py-5 position-relative overflow-hidden">
        <div class="container text-center py-2 py-md-4">
            
            <!-- Badge -->
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill hero-badge mb-3">
                <span class="live-dot-pulse"></span>
                <span class="fw-bold small text-primary">300+ Smart Financial Calculators · 100% Free & Private</span>
            </div>

            <!-- Main Heading -->
            <h1 class="hero-main-title fw-extrabold mb-3">
                Free Financial <span class="gradient-text">Calculators for India</span>
            </h1>
            
            <!-- Subtitle -->
            <p class="hero-main-subtitle text-muted mx-auto mb-4" style="max-width: 760px;">
                Calculate Mutual Fund SIP growth, loan EMIs, New Tax Regime FY 2026-27 liability, in-hand salary, FD rates, and early retirement across 300+ fast, accurate tools.
            </p>

            <!-- ===== LIVE CONTINUOUS MOVING MARKET TICKER (HERO SECTION) ===== -->
            <div class="hero-live-ticker-container" id="heroLiveTicker">
                <div class="hero-ticker-badge">
                    <span class="pulse-circle"></span> LIVE RATES
                </div>
                <div class="hero-ticker-viewport">
                    <div class="hero-ticker-track" id="heroTickerTrack">
                        <!-- First Segment -->
                        <div class="hero-ticker-segment">
                            <div class="hero-ticker-item">
                                <span class="tk-name">USD/INR</span>
                                <span class="tk-val tk-live-usd">₹95.58</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">EUR/INR</span>
                                <span class="tk-val tk-live-eur">₹110.85</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">GBP/INR</span>
                                <span class="tk-val tk-live-gbp">₹129.47</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">BTC/INR</span>
                                <span class="tk-val tk-live-btc">₹74,86,000</span>
                                <span class="tk-change-pos tk-live-btc-chg">-0.4%</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">ETH/INR</span>
                                <span class="tk-val tk-live-eth">₹2,35,400</span>
                                <span class="tk-change-pos tk-live-eth-chg">-0.5%</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">🥇 GOLD 24K (10g)</span>
                                <span class="tk-val tk-live-gold">₹97,180</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">🥈 SILVER (1kg)</span>
                                <span class="tk-val tk-live-silver">₹1,14,850</span>
                                <span class="tk-dot">•</span>
                            </div>
                        </div>

                        <!-- Duplicate Segment for Seamless Infinite Loop -->
                        <div class="hero-ticker-segment" aria-hidden="true">
                            <div class="hero-ticker-item">
                                <span class="tk-name">USD/INR</span>
                                <span class="tk-val tk-live-usd">₹95.58</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">EUR/INR</span>
                                <span class="tk-val tk-live-eur">₹110.85</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">GBP/INR</span>
                                <span class="tk-val tk-live-gbp">₹129.47</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">BTC/INR</span>
                                <span class="tk-val tk-live-btc">₹74,86,000</span>
                                <span class="tk-change-pos tk-live-btc-chg">-0.4%</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">ETH/INR</span>
                                <span class="tk-val tk-live-eth">₹2,35,400</span>
                                <span class="tk-change-pos tk-live-eth-chg">-0.5%</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">🥇 GOLD 24K (10g)</span>
                                <span class="tk-val tk-live-gold">₹97,180</span>
                                <span class="tk-dot">•</span>
                            </div>
                            <div class="hero-ticker-item">
                                <span class="tk-name">🥈 SILVER (1kg)</span>
                                <span class="tk-val tk-live-silver">₹1,14,850</span>
                                <span class="tk-dot">•</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Suggestion Pills -->
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-4">
                <span class="text-muted small fw-semibold">Popular:</span>
                <a href="/sip-calculator" class="quick-link-pill">📊 SIP Returns</a>
                <a href="/in-hand-salary-calculator" class="quick-link-pill">💼 In-Hand Salary</a>
                <a href="/emi-calculator" class="quick-link-pill">🏠 Loan EMI</a>
                <a href="/income-tax-calculator" class="quick-link-pill">🧾 Income Tax FY 26-27</a>
                <a href="/fd-calculator" class="quick-link-pill">🏦 Bank FD Rates</a>
                <a href="/fire-calculator" class="quick-link-pill">🏖️ FIRE Freedom</a>
                <a href="/gold-calculator" class="quick-link-pill">🥇 Gold SGB</a>
            </div>

            <!-- Stats Bar -->
            <div class="row g-3 justify-content-center pt-2" style="max-width: 700px; margin: 0 auto;">
                <div class="col-4 col-sm-4 border-end">
                    <div class="h4 fw-bold text-primary mb-0"><%= calculators.length %>+</div>
                    <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Calculators</div>
                </div>
                <div class="col-4 col-sm-4 border-end">
                    <div class="h4 fw-bold text-success mb-0">100%</div>
                    <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Free & Private</div>
                </div>
                <div class="col-4 col-sm-4">
                    <div class="h4 fw-bold text-info mb-0">⚡ Live</div>
                    <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Interactive Charts</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CONTAINER FOR DIRECTORY ===== -->
    <div class="container my-4 my-md-5">

        <!-- ===== REAL-TIME LIVE MARKET PULSE & FOREX/CRYPTO WIDGET ===== -->
        <section class="live-market-card p-4 p-md-4 mb-5 shadow-sm">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="live-badge-pulse"><span class="pulse-circle"></span> REAL-TIME RATES</span>
                    <h3 class="h5 fw-bold mb-0 text-body-emphasis">Live Market Intelligence & Forex</h3>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="small text-muted" id="hpLiveTime">Fetching live data...</span>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="refreshLiveMarketRates()">🔄 Refresh</button>
                </div>
            </div>

            <!-- Quick Live Rates Grid -->
            <div class="row g-3">
                <div class="col-6 col-md-3">
                    <div class="rate-tile">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small text-muted fw-semibold">💵 USD to INR</span>
                            <span class="badge bg-success-subtle text-success py-1">Forex</span>
                        </div>
                        <div class="h5 fw-bold mb-0 text-body-emphasis" id="hpLiveUsd">₹87.50</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="rate-tile">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small text-muted fw-semibold">🟡 Bitcoin (BTC)</span>
                            <span class="badge bg-warning-subtle text-warning py-1">Crypto</span>
                        </div>
                        <div class="h5 fw-bold mb-0 text-body-emphasis" id="hpLiveBtc">₹74,70,000</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="rate-tile">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small text-muted fw-semibold">🔵 Ethereum (ETH)</span>
                            <span class="badge bg-info-subtle text-info py-1">Crypto</span>
                        </div>
                        <div class="h5 fw-bold mb-0 text-body-emphasis" id="hpLiveEth">₹2,35,000</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="rate-tile">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small text-muted fw-semibold">🥇 Gold 24K (10g)</span>
                            <span class="badge bg-warning-subtle text-warning py-1">Bullion</span>
                        </div>
                        <div class="h5 fw-bold mb-0 text-body-emphasis" id="hpLiveGold">₹84,500</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===== POPULAR CALCULATORS SHOWCASE ===== -->
        <section class="popular-showcase-section mb-5" id="popularSection">
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
                <div>
                    <h2 class="h3 fw-extrabold text-body-emphasis mb-1">⭐ Popular Financial Calculators</h2>
                    <p class="text-muted small mb-0">Our most-used tools for instant tax savings, wealth compounding, and loan planning.</p>
                </div>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold">Top Highlights</span>
            </div>

            <div class="row g-3 g-md-4">
                <% popularCalculators.slice(0, 9).forEach(function(calc) { %>
                    <div class="col-lg-4 col-md-6 calc-card-col" data-title="<%= calc.title.toLowerCase() %>" data-desc="<%= calc.desc.toLowerCase() %>" data-category="<%= calc.category %>">
                        <a href="/<%= calc.slug %>" class="card calc-card h-100 p-4 rounded-4 shadow-sm text-decoration-none border transition-all">
                            <!-- Card Top Bar: Icon on Left, Status Badge on Right -->
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="calc-icon-tile shadow-2xs">
                                    <span><%= calc.icon %></span>
                                </div>
                                <% if (calc.badge) { %>
                                    <span class="badge bg-gradient-pill text-white shadow-2xs fw-bold px-2.5 py-1" style="font-size: 0.68rem; border-radius: 50px;"><%= calc.badge %></span>
                                <% } %>
                            </div>

                            <!-- Card Title & Category -->
                            <div class="mb-2">
                                <h3 class="h6 fw-bold text-body-emphasis mb-1" style="line-height: 1.35;"><%= calc.title %></h3>
                                <span class="badge bg-secondary-subtle text-secondary small text-uppercase" style="font-size: 0.65rem;"><%= calc.category %></span>
                            </div>

                            <!-- Card Description -->
                            <p class="text-muted small mb-4 line-clamp-2"><%= calc.desc %></p>

                            <!-- Card Footer -->
                            <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                                <span class="fw-bold small text-primary calc-cta-link">Calculate Now</span>
                                <span class="calc-arrow-icon text-primary">→</span>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- ===== CALCULATOR DIRECTORY & SEARCH HUB ===== -->
        <div class="directory-search-hub-section mb-4" id="directorySearchHub">
            <div class="card p-3 p-md-4 rounded-4 shadow-sm border mb-3" style="background: rgba(255,255,255,0.025); border-color: rgba(255,255,255,0.08) !important;">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <div>
                        <h3 class="h5 fw-bold text-body-emphasis mb-1">🔍 Search & Filter 300+ Calculators</h3>
                        <p class="text-muted small mb-0">Instant live search across all categories (SIP, Loans, Taxes, FD, FIRE, Business)</p>
                    </div>
                </div>

                <!-- Instant Search Input Box -->
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border bg-body search-pill-box mb-3">
                    <span class="input-group-text bg-transparent border-0 ps-3 ps-md-4 text-primary">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </span>
                    <input type="text" 
                           id="globalCalcSearchInput" 
                           class="form-control border-0 py-3 ps-2 shadow-none" 
                           placeholder="Type to search 300+ calculators (e.g. SIP, Home Loan, 44ADA, FD, HRA, NPS)..." 
                           autocomplete="off">
                    <span class="input-group-text bg-transparent border-0 pe-3 pe-md-4 d-none d-sm-flex align-items-center">
                        <kbd class="kbd-badge shadow-2xs">Ctrl + K</kbd>
                    </span>
                </div>

                <!-- Category Filter Tabs -->
                <div class="category-filter-nav">
                    <div class="d-flex flex-nowrap overflow-x-auto gap-2 pb-1 hide-scrollbar">
                        <button type="button" class="btn btn-sm btn-category-pill active" data-filter="all">
                            ✨ All Calculators (<%= calculators.length %>)
                        </button>
                        <% categories.forEach(function(cat) { %>
                            <button type="button" class="btn btn-sm btn-category-pill" data-filter="<%= cat.id %>">
                                <%= cat.icon %> <%= cat.name %> (<%= cat.count %>)
                            </button>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search Results Count Notification (hidden by default) -->
        <div id="searchNotice" class="alert alert-info py-2 px-3 small rounded-3 mb-4 d-none">
            Showing <strong id="matchCount">0</strong> matching calculators for "<span id="queryText"></span>". <button type="button" class="btn btn-link btn-sm p-0 ms-2" id="clearSearchBtn">Clear search</button>
        </div>

        <!-- Empty state when no search matches -->
        <div id="noResultsState" class="card text-center p-5 rounded-4 border shadow-sm my-5 d-none">
            <div class="display-5 mb-3">🔍</div>
            <h3 class="h5 fw-bold text-body-emphasis mb-2">No Calculators Found</h3>
            <p class="text-muted small mb-4">We couldn't find any financial calculator matching your keyword.</p>
            <button type="button" class="btn btn-primary rounded-pill px-4 mx-auto" onclick="document.getElementById('clearSearchBtn').click()">View All 300+ Calculators</button>
        </div>

        <!-- ===== CATEGORIZED CALCULATOR SECTIONS ===== -->
        <div id="categorizedDirectory">
            <% categories.forEach(function(cat) { 
                const catItems = calculators.filter(c => c.category === cat.id);
                if (catItems.length > 0) {
            %>
                <section class="category-section mb-5" data-section-category="<%= cat.id %>">
                    
                    <!-- Category Header -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 border-bottom pb-2 gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4"><%= cat.icon %></span>
                            <h2 class="h4 fw-bold text-body-emphasis mb-0"><%= cat.name %></h2>
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small fw-bold"><%= catItems.length %> Tools</span>
                        </div>
                        <p class="text-muted small mb-0 d-none d-md-block"><%= cat.desc %></p>
                    </div>

                    <!-- Cards Grid -->
                    <div class="row g-3 g-md-4">
                        <% catItems.forEach(function(calc) { %>
                            <div class="col-lg-4 col-md-6 calc-card-col" data-title="<%= calc.title.toLowerCase() %>" data-desc="<%= calc.desc.toLowerCase() %>" data-category="<%= calc.category %>">
                                <a href="/<%= calc.slug %>" class="card calc-card h-100 p-4 rounded-4 shadow-sm text-decoration-none border transition-all">
                                    <!-- Card Top Bar: Icon on Left, Status Badge on Right -->
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <div class="calc-icon-tile shadow-2xs">
                                            <span><%= calc.icon %></span>
                                        </div>
                                        <% if (calc.badge) { %>
                                            <span class="badge calc-badge-pill"><%= calc.badge %></span>
                                        <% } %>
                                    </div>

                                    <!-- Card Title & Category -->
                                    <div class="mb-2">
                                        <h3 class="h6 fw-bold text-body-emphasis mb-1" style="line-height: 1.35;"><%= calc.shortTitle || calc.title %></h3>
                                        <span class="badge bg-secondary-subtle text-secondary small text-uppercase" style="font-size: 0.65rem;"><%= calc.category %></span>
                                    </div>

                                    <!-- Card Description -->
                                    <p class="text-muted small mb-4 line-clamp-2"><%= calc.desc %></p>

                                    <!-- Card Footer -->
                                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                                        <span class="fw-bold small text-primary calc-cta-link">Calculate Now</span>
                                        <span class="calc-arrow-icon text-primary">→</span>
                                    </div>
                                </a>
                            </div>
                        <% }); %>
                    </div>
                </section>
            <% } }); %>
        </div>

        <!-- ===== GOAL FINDER WIZARD ===== -->
        <div class="goal-wizard-card rounded-4 p-4 p-md-5 my-5 shadow-sm border position-relative overflow-hidden">
            <div class="goal-wizard-header mb-4">
                <h3 class="h4 fw-bold text-body-emphasis mb-2">🎯 What is your financial goal today?</h3>
                <p class="text-muted small mb-0">Pick your goal — we'll take you to the right calculator instantly.</p>
            </div>
            <div class="row g-3">
                <div class="col-md-4 col-sm-6">
                    <a href="/sip-calculator" class="btn-goal-card p-3 rounded-3 border d-flex flex-column text-decoration-none h-100">
                        <span class="fs-3 mb-2">🚀</span>
                        <span class="fw-bold text-body-emphasis">Build Wealth (SIP)</span>
                        <span class="small text-muted">Target ₹1 Cr+ with mutual funds</span>
                    </a>
                </div>
                <div class="col-md-4 col-sm-6">
                    <a href="/emi-calculator" class="btn-goal-card p-3 rounded-3 border d-flex flex-column text-decoration-none h-100">
                        <span class="fs-3 mb-2">🏠</span>
                        <span class="fw-bold text-body-emphasis">Buy Home or Car</span>
                        <span class="small text-muted">Calculate lowest EMI</span>
                    </a>
                </div>
                <div class="col-md-4 col-sm-6">
                    <a href="/income-tax-calculator" class="btn-goal-card p-3 rounded-3 border d-flex flex-column text-decoration-none h-100">
                        <span class="fs-3 mb-2">🧾</span>
                        <span class="fw-bold text-body-emphasis">Save Income Tax</span>
                        <span class="small text-muted">New vs Old Tax Regime FY 26-27</span>
                    </a>
                </div>
                <div class="col-md-4 col-sm-6">
                    <a href="/retirement-calculator" class="btn-goal-card p-3 rounded-3 border d-flex flex-column text-decoration-none h-100">
                        <span class="fs-3 mb-2">🌴</span>
                        <span class="fw-bold text-body-emphasis">Plan Early Retirement</span>
                        <span class="small text-muted">FIRE & Pension Corpus</span>
                    </a>
                </div>
                <div class="col-md-4 col-sm-6">
                    <a href="/loan-prepayment-calculator" class="btn-goal-card p-3 rounded-3 border d-flex flex-column text-decoration-none h-100">
                        <span class="fs-3 mb-2">⚡</span>
                        <span class="fw-bold text-body-emphasis">Prepay Loan & Save</span>
                        <span class="small text-muted">Cut 5–10 yrs of interest</span>
                    </a>
                </div>
                <div class="col-md-4 col-sm-6">
                    <a href="/ssy-calculator" class="btn-goal-card p-3 rounded-3 border d-flex flex-column text-decoration-none h-100">
                        <span class="fs-3 mb-2">👧</span>
                        <span class="fw-bold text-body-emphasis">Daughter's Future (SSY)</span>
                        <span class="small text-muted">Govt 8.2% Tax-Free</span>
                    </a>
                </div>
        </div>

        <!-- ===== SEO EDITORIAL GUIDE & SEARCH AUTHORITY SECTION ===== -->
        <article class="card shadow-sm rounded-4 p-4 p-md-5 my-5 border">
            <h2 class="h3 fw-bold text-body-emphasis mb-3">India's Premier Financial Intelligence & Calculation Platform</h2>
            <p class="lead text-secondary mb-4" style="font-size: 1.05rem;">
                <strong>FinancialHub</strong> provides India's largest suite of <strong>330+ free, accurate, and private financial calculators</strong> spanning mutual fund compounding, banking deposits, mortgage amortization, Union Budget tax slabs (FY 2026-27), early retirement FIRE models, and corporate valuation.
            </p>

            <div class="row g-4 my-2">
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-body-tertiary h-100">
                        <h3 class="h6 fw-bold text-primary mb-2">📈 Wealth & Investment Compounding</h3>
                        <p class="small text-muted mb-0">From monthly SIP to Step-Up SIP and CAGR models, calculate long-term wealth growth across Nifty 50, Mid Cap, and Small Cap mutual funds with annual compounding schedules.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-body-tertiary h-100">
                        <h3 class="h6 fw-bold text-primary mb-2">🧾 Tax Planning (FY 2026-27)</h3>
                        <p class="small text-muted mb-0">Compare New vs Old Tax Regime, calculate 44ADA freelance presumptive tax, assess Section 112A 12.5% LTCG capital gains, and optimize take-home CTC salaries with ₹75,000 standard deductions.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-body-tertiary h-100">
                        <h3 class="h6 fw-bold text-primary mb-2">🏠 Loans & Debt Management</h3>
                        <p class="small text-muted mb-0">Simulate home loan and car loan EMIs, evaluate 1-extra EMI prepayment savings, compare balance transfer interest cuts, and optimize multi-card debt avalanche payoff schedules.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 bg-body-tertiary h-100">
                        <h3 class="h6 fw-bold text-primary mb-2">🎯 FIRE & Early Retirement</h3>
                        <p class="small text-muted mb-0">Plan Coast FIRE, Lean FIRE, and Fat FIRE milestones, calculate NPS Tier-1 & Tier-2 pension growth, and model 4% safe withdrawal rate (SWR) survival through market cycles.</p>
                    </div>
                </div>
            </div>

            <!-- Homepage FAQs -->
            <h3 class="h4 fw-bold text-body-emphasis mt-5 mb-3">Frequently Asked Questions</h3>

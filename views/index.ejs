<!-- Instant Client Search & Category Filtering Script -->
<script>
(function() {
    const searchInput = document.getElementById('globalCalcSearchInput');
    const categoryButtons = document.querySelectorAll('.btn-category-pill');
    const allCards = document.querySelectorAll('.calc-card-col');
    const allSections = document.querySelectorAll('.category-section');
    const popularSection = document.getElementById('popularSection');
    const searchNotice = document.getElementById('searchNotice');
    const matchCountEl = document.getElementById('matchCount');
    const queryTextEl = document.getElementById('queryText');
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const noResultsState = document.getElementById('noResultsState');

    let currentCategory = 'all';
    let searchQuery = '';

    function filterDirectory() {
        let visibleCount = 0;
        const q = searchQuery.toLowerCase().trim();

        allCards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const desc = card.getAttribute('data-desc') || '';
            const cat = card.getAttribute('data-category') || '';

            const matchesCategory = (currentCategory === 'all' || cat === currentCategory);
            const matchesSearch = (q === '' || title.includes(q) || desc.includes(q) || cat.includes(q));

            if (matchesCategory && matchesSearch) {
                card.style.display = 'block';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Hide empty category sections
        allSections.forEach(section => {
            const secCat = section.getAttribute('data-section-category');
            if (currentCategory !== 'all' && secCat !== currentCategory) {
                section.style.display = 'none';
            } else {
                // Check if this section has at least one visible card
                const visibleInSec = section.querySelectorAll('.calc-card-col[style="display: block;"]').length;
                section.style.display = visibleInSec > 0 ? 'block' : 'none';
            }
        });

        // Hide/Show Popular Section if searching or filtering
        if (popularSection) {
            popularSection.style.display = (q === '' && currentCategory === 'all') ? 'block' : 'none';
        }

        // Search Notice Alert
        if (q !== '') {
            searchNotice.classList.remove('d-none');
            matchCountEl.textContent = visibleCount;
            queryTextEl.textContent = q;
        } else {
            searchNotice.classList.add('d-none');
        }

        // No results state
        if (visibleCount === 0) {
            noResultsState.classList.remove('d-none');
        } else {
            noResultsState.classList.add('d-none');
        }
    }

    // Search Input Listener
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            searchQuery = this.value;
            filterDirectory();
        });
    }

    // Category Buttons Listener
    categoryButtons.forEach(btn => {
        btn.addEventListener('click', function() {
            categoryButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentCategory = this.getAttribute('data-filter');
            filterDirectory();
        });
    });

    // Clear search
    if (clearSearchBtn) {
        clearSearchBtn.addEventListener('click', function() {
            if (searchInput) searchInput.value = '';
            searchQuery = '';
            filterDirectory();
        });
    }

    // Keyboard Shortcut (Ctrl+K / Cmd+K)
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            if (searchInput) {
                searchInput.focus();
                searchInput.select();
            }
        }
    });
})();
</script>


<%- include('partials/header') %>
<div class="form-card">
    <div class="p-3 mb-3 rounded-3 border" style="background: rgba(13, 110, 253, 0.05); border-color: rgba(13, 110, 253, 0.2) !important;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span style="font-size: 1.25rem;">🏛️</span>
                <div>
                    <strong class="text-body-emphasis small d-block">PFRDA & CBDT Compliant Pension Engine</strong>
                    <span class="text-muted" style="font-size: 0.78rem;">Calculates Tier-I retirement corpus, 60% tax-free lump-sum exit, 40% annuity, and Section 80CCD tax benefits.</span>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.75rem;">✓ 100% Verified Actuarial Math</span>
        </div>
    </div>

    <h1 class="h3 fw-bold mb-1">NPS Calculator (National Pension System FY 2026-27)</h1>
    <p class="text-secondary mb-4" style="font-size:0.95rem;">Calculate your total retirement corpus, 60% tax-free lump sum withdrawal, and monthly lifetime pension under the National Pension System.</p>
    
    <div class="row g-5">
        <div class="col-lg-5">
            <div class="slider-container">
                <label class="form-label d-flex justify-content-between fw-bold">Monthly Contribution <span id="contribDisplay" style="color:var(--gold);font-weight:600;">₹5,000</span></label>
                <input type="range" id="contribSlider" min="500" max="100000" step="500" value="5000" oninput="s('contrib',this.value);calc();" class="form-range">
                <div class="input-group mt-2"><span class="input-group-text">₹</span><input type="number" class="form-control fw-bold" id="contribInput" value="5000" oninput="ss('contrib',this.value);calc();"></div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Current Age</label>
                <div class="input-group"><input type="number" class="form-control" id="currentAge" value="30" min="18" max="59" oninput="calc()"><span class="input-group-text">Years</span></div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Retirement Age (Max 60)</label>
                <div class="input-group"><input type="number" class="form-control" id="retireAge" value="60" min="18" max="60" oninput="calc()"><span class="input-group-text">Years</span></div>
            </div>
            <div class="slider-container">
                <label class="form-label d-flex justify-content-between fw-bold">Expected Annual Return <span id="retDisplay" style="color:var(--gold);font-weight:600;">10%</span></label>
                <input type="range" id="retSlider" min="6" max="14" step="0.5" value="10" oninput="s('ret',this.value);calc();" class="form-range">
                <div class="input-group mt-2"><input type="number" class="form-control" id="retInput" value="10" step="0.5" oninput="ss('ret',this.value);calc();"><span class="input-group-text">%</span></div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Annuity Rate (Expected Pension Yield)</label>
                <div class="input-group"><input type="number" class="form-control" id="annuityRate" value="6" step="0.5" oninput="calc()"><span class="input-group-text">%</span></div>
                <small style="color:var(--text-muted);font-size:0.78rem;">Typical insurer annuity yield in India: 5.5% – 6.5% p.a.</small>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="emi-result-display mb-3 p-3 text-center rounded-3" style="background:rgba(13,110,253,0.08); border:1px solid rgba(13,110,253,0.2);">
                <p class="label small text-muted text-uppercase fw-bold mb-1">Total Accumulated NPS Corpus at 60</p>
                <p class="amount display-6 fw-extrabold mb-0 text-primary" id="corpus">₹0</p>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-6"><div class="summary-card p-3 rounded-3 border" style="background:rgba(255,255,255,0.02);"><div class="label small text-muted">Total Invested</div><div class="value fw-bold text-body-emphasis" id="totalInv">₹0</div></div></div>
                <div class="col-6"><div class="summary-card p-3 rounded-3 border" style="background:rgba(255,255,255,0.02);"><div class="label small text-muted">Interest / Growth Earned</div><div class="value fw-bold text-success" id="interest">₹0</div></div></div>
                <div class="col-6"><div class="summary-card p-3 rounded-3 border" style="background:rgba(255,255,255,0.02);"><div class="label small text-muted">60% Tax-Free Lump Sum</div><div class="value fw-bold" style="color:var(--gold, #f59e0b);" id="lumpsum">₹0</div></div></div>
                <div class="col-6"><div class="summary-card p-3 rounded-3 border" style="background:rgba(255,255,255,0.02);"><div class="label small text-muted">Monthly Lifetime Pension (40%)</div><div class="value fw-bold text-success" id="pension">₹0</div></div></div>
            </div>
            <div class="highlight-box p-3 rounded" style="background:var(--bg-input, rgba(255,255,255,0.03)); border:1px solid var(--border);">
                <h6 class="fw-bold text-warning mb-1">💡 NPS Tax Benefits Summary</h6>
                <p class="small text-muted mb-0">Under Section 80CCD(1), contributions up to ₹1.5L are deductible within the 80C umbrella. Additionally, Section 80CCD(1B) provides an <strong>exclusive extra ₹50,000 tax deduction</strong> over and above 80C limits (total ₹2,00,000 tax deduction under Old Regime).</p>
            </div>
        </div>
    </div>

    <!-- AEO Quick Definition Box -->
    <div class="card p-4 rounded-4 my-4 border" style="background: var(--bg-card, #0f172a);">
        <h2 class="h4 fw-bold mb-3" style="color: var(--heading-color, #f8fafc);">What is the National Pension System (NPS)?</h2>
        <p class="lead mb-3 text-secondary" style="font-size: 1.02rem; line-height: 1.7;">
            The <strong>National Pension System (NPS)</strong> is a voluntary, long-term retirement savings scheme regulated by the Pension Fund Regulatory and Development Authority (PFRDA) and backed by the Government of India. It allows citizen investors to contribute systematically towards an equity and debt portfolio during their working life to secure financial independence post-retirement.
        </p>
        <p class="text-muted small mb-0">
            Upon reaching age 60, NPS subscribers are permitted to withdraw <strong>up to 60% of the accumulated corpus completely tax-free</strong>, while the remaining <strong>minimum 40% must be invested in a life annuity</strong> to generate guaranteed monthly pension income.
        </p>
    </div>

    <!-- Comparison Table: NPS vs PPF vs Mutual Fund Retirement Funds -->
    <div class="card p-4 rounded-4 my-4 border" style="background: var(--bg-card, #0f172a);">
        <h3 class="h5 fw-bold mb-3" style="color: var(--heading-color, #f8fafc);">📊 Retirement Comparison: NPS vs PPF vs Mutual Fund (ELSS/Retirement)</h3>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">Feature</th>
                        <th>National Pension System (NPS)</th>
                        <th>Public Provident Fund (PPF)</th>
                        <th>Mutual Fund Retirement / ELSS</th>
                    </tr>
                </thead>
                <tbody class="text-muted">
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">Historical Return</td>
                        <td>9% – 12% p.a. (Market linked)</td>
                        <td>7.10% (Govt Fixed)</td>
                        <td>12% – 15% (Equity linked)</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">Tax Benefit on Investment</td>
                        <td>₹1.5L (80C) + ₹50k (80CCD 1B)</td>
                        <td>Up to ₹1.5L under 80C</td>
                        <td>Up to ₹1.5L under 80C</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">Maturity Taxability</td>
                        <td>60% Tax-Free / 40% Annuity</td>
                        <td>100% Tax-Free (EEE)</td>
                        <td>12.5% LTCG above ₹1.25L</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">Mandatory Annuity?</td>
                        <td>Yes (Min 40% for pension)</td>
                        <td>No (Full lump sum exit)</td>
                        <td>No (Full SWP or lump sum)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- FAQs Section -->
    <h3 class="h4 fw-bold mt-5 mb-3" style="color: var(--heading-color, #f8fafc);">❓ Frequently Asked Questions (NPS FAQs)</h3>
    <div class="accordion" id="npsFaqAccordion">
        <div class="accordion-item">
            <h4 class="accordion-header" id="nH1">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#nC1" aria-expanded="true">
                    How is the NPS maturity lump sum and pension calculated?
                </button>
            </h4>
            <div id="nC1" class="accordion-collapse collapse show" data-bs-parent="#npsFaqAccordion">
                <div class="accordion-body text-muted">
                    Your monthly deposits compound periodically based on your chosen asset allocation (Equity, Corporate Debt, Govt Securities). At age 60, 60% of the total accumulated wealth is disbursed as a tax-free lump-sum, while 40% is transferred to an Annuity Service Provider (e.g., LIC, SBI Life) which pays a fixed monthly pension for life.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h4 class="accordion-header" id="nH2">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nC2">
                    What is the additional ₹50,000 tax deduction under Section 80CCD(1B)?
                </button>
            </h4>
            <div id="nC2" class="accordion-collapse collapse" data-bs-parent="#npsFaqAccordion">
                <div class="accordion-body text-muted">
                    Under the Old Tax Regime, Section 80CCD(1B) provides an exclusive deduction of up to <strong>₹50,000</strong> for investments in NPS Tier 1 accounts. This is over and above the regular ₹1,50,000 limit available under Section 80C, allowing a total deduction of up to ₹2,00,000.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h4 class="accordion-header" id="nH3">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nC3">
                    Can I withdraw my money from NPS before age 60?
                </button>
            </h4>
            <div id="nC3" class="accordion-collapse collapse" data-bs-parent="#npsFaqAccordion">
                <div class="accordion-body text-muted">
                    Premature exit is permitted after completing 5 years, but at least <strong>80% of the accumulated corpus must be utilized to purchase an annuity</strong>, and only 20% can be withdrawn as a lump sum. Partial withdrawals up to 25% of own contributions are allowed for specific milestones (child higher education, marriage, or critical illness).
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h4 class="accordion-header" id="nH4">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nC4">
                    What is the difference between NPS Tier 1 and Tier 2 accounts?
                </button>
            </h4>
            <div id="nC4" class="accordion-collapse collapse" data-bs-parent="#npsFaqAccordion">
                <div class="accordion-body text-muted">
                    <strong>Tier 1</strong> is the primary retirement account with lock-in until age 60 and tax benefits. <strong>Tier 2</strong> is an optional, liquid savings account with zero withdrawal restrictions or lock-in, but it does not offer standard tax deductions.
                </div>
            </div>
        </div>
    </div>

    <!-- Embedded FAQPage JSON-LD -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "How is the NPS maturity lump sum and pension calculated?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "At age 60, up to 60% of accumulated NPS corpus is paid out tax-free as a lump sum, and the remaining minimum 40% is converted into an annuity that pays a lifelong monthly pension."
                }
            },
            {
                "@type": "Question",
                "name": "What is the additional ₹50,000 tax deduction under Section 80CCD(1B)?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Section 80CCD(1B) allows an extra deduction of ₹50,000 exclusively for NPS Tier-1 investments, above the general ₹1.5L Section 80C limit."
                }
            },
            {
                "@type": "Question",
                "name": "Can I withdraw my money from NPS before age 60?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Premature exit requires at least 80% to be invested in an annuity. Partial withdrawals up to 25% of employee contributions are permitted for higher education or critical medical treatment."
                }
            },
            {
                "@type": "Question",
                "name": "What is the difference between NPS Tier 1 and Tier 2 accounts?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Tier 1 is a mandatory pension account with tax benefits and lock-in till age 60. Tier 2 is an open-ended investment account with no lock-in and no tax deductions."
                }
            }
        ]
    }
    </script>

    <div class="related-section mt-5"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/ppf-calculator" class="related-card"><span class="icon">🏛️</span><div class="title">PPF Calculator</div><div class="desc">Tax-free long-term savings</div></a></div>
            <div class="col-md-4"><a href="/retirement-calculator" class="related-card"><span class="icon">🌅</span><div class="title">Retirement Planning</div><div class="desc">Full retirement planning</div></a></div>
            <div class="col-md-4"><a href="/gratuity-calculator" class="related-card"><span class="icon">🏅</span><div class="title">Gratuity Calculator</div><div class="desc">Retirement benefits</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>

<!-- Save & Share Toolbar -->
<div class="action-toolbar" id="npsToolbar" style="display:none;">
    <span class="toolbar-label">Tools:</span>
    <button type="button" class="btn-action-tool" id="npsBtnSave">💾 Save Calculation</button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="npsBtnShare">💬 Share on WhatsApp</button>
    <button type="button" class="btn-action-tool" id="npsBtnCopy">🔗 Copy Link</button>
</div>
<script>
const fmt=n=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function s(f,v){const m={contrib:['contribInput','contribDisplay'],ret:['retInput','retDisplay']};const[i,d]=m[f];document.getElementById(i).value=v;document.getElementById(d).textContent=(f==='contrib'?'₹'+parseInt(v).toLocaleString('en-IN'):parseFloat(v).toFixed(1)+'%');}
function ss(f,v){const m={contrib:'contribSlider',ret:'retSlider'};document.getElementById(m[f]).value=v;s(f,v);}
function calc(){
    const contrib=parseFloat(document.getElementById('contribInput').value)||0;
    const cur=parseInt(document.getElementById('currentAge').value)||30;
    const ret=parseInt(document.getElementById('retireAge').value)||60;
    const rate=parseFloat(document.getElementById('retInput').value)/100||0.10;
    const annuity=parseFloat(document.getElementById('annuityRate').value)/100||0.06;
    const yrs=Math.max(0,ret-cur);
    const r=rate/12;
    const n=yrs*12;
    const corpus=n>0?contrib*(Math.pow(1+r,n)-1)*(1+r)/r:0;
    const totalInv=contrib*n;
    const lumpsum=corpus*0.6;
    const annuityCorpus=corpus*0.4;
    const monthlyPension=annuityCorpus*annuity/12;
    document.getElementById('corpus').textContent=fmt(corpus);
    document.getElementById('totalInv').textContent=fmt(totalInv);
    document.getElementById('interest').textContent=fmt(corpus-totalInv);
    document.getElementById('lumpsum').textContent=fmt(lumpsum);
    document.getElementById('pension').textContent=fmt(monthlyPension);
    document.getElementById('npsToolbar').style.display='flex';
    window._lastNps={contrib,cur,ret,rate:parseFloat(document.getElementById('retInput').value),corpus,totalInv,lumpsum,monthlyPension};
}
calc();
document.addEventListener('DOMContentLoaded',function(){
    document.getElementById('npsBtnSave').addEventListener('click',function(){
        const d=window._lastNps; if(!d)return;
        const name=prompt('Save this NPS calculation as:','NPS Corpus: '+fmt(d.corpus));
        if(name) saveCalculation(name,{monthly:fmt(d.contrib),years:(d.ret-d.cur)+' Yrs',rate:d.rate+'%',corpus:fmt(d.corpus),lumpsum:fmt(d.lumpsum),pension:fmt(d.monthlyPension)+'/mo'});
    });
    document.getElementById('npsBtnShare').addEventListener('click',function(){
        const d=window._lastNps; if(!d)return;
        shareViaWhatsApp('NPS Calculator','Monthly: '+fmt(d.contrib)+'\nYears: '+(d.ret-d.cur)+'\nTotal Corpus: '+fmt(d.corpus)+'\nLump Sum (60%): '+fmt(d.lumpsum)+'\nMonthly Pension: '+fmt(d.monthlyPension));
    });
    document.getElementById('npsBtnCopy').addEventListener('click',copyShareableURL);
});
</script>
<%- include('partials/footer') %>

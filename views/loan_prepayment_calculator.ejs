<%- include('partials/header') %>

<div class="page-title-section fade-in-up">
    <h1>Loan Prepayment Calculator</h1>
    <p>See exactly how much interest money and loan years you save by making extra monthly or lump-sum prepayments on your loan.</p>
</div>

<div class="form-card fade-in-up">
    <%- include('partials/ad_unit') %>

    <div class="row g-5">
        <!-- Left Column: Inputs -->
        <div class="col-lg-5">
            <h5 class="mb-3 text-gold-custom fw-bold">Original Loan Details</h5>
            <div class="mb-3">
                <label for="loanAmountInput" class="form-label fw-semibold">Loan Amount</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="loanAmountInput" placeholder="e.g., 25,00,000" min="10000">
                </div>
                <div id="loanAmountWords" class="number-words-preview"></div>
                <div id="loanPresets"></div>
            </div>

            <div class="mb-3">
                <label for="interestRateInput" class="form-label fw-semibold">Annual Interest Rate (%)</label>
                <input type="number" class="form-control" id="interestRateInput" placeholder="e.g., 8.5" step="0.1" min="1">
            </div>

            <div class="mb-3">
                <label for="loanTenureInput" class="form-label fw-semibold">Loan Tenure (Years)</label>
                <input type="number" class="form-control" id="loanTenureInput" placeholder="e.g., 20" min="1" max="35">
            </div>

            <hr class="my-4" style="border-color: var(--border);">
            <h5 class="mb-3 text-gold-custom fw-bold">Prepayment Strategy</h5>
            <div class="btn-group w-100 mb-3" role="group">
                <input type="radio" class="btn-check" name="prepaymentType" id="typeRecurring" autocomplete="off" checked>
                <label class="btn btn-outline-primary btn-sm" for="typeRecurring">Recurring Monthly Extra</label>
                <input type="radio" class="btn-check" name="prepaymentType" id="typeOneTime" autocomplete="off">
                <label class="btn btn-outline-primary btn-sm" for="typeOneTime">One-Time Lumpsum</label>
            </div>

            <div class="mb-3">
                <label for="prepaymentAmountInput" class="form-label fw-semibold">Prepayment Amount</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="prepaymentAmountInput" placeholder="e.g., 5,000" min="0">
                </div>
                <div id="prepAmountWords" class="number-words-preview"></div>
                <div id="prepPresets"></div>
            </div>

            <div class="mb-3" id="oneTimePaymentMonthWrapper" style="display: none;">
                <label for="oneTimePaymentMonthInput" class="form-label fw-semibold">Make One-Time Payment After (months)</label>
                <input type="number" class="form-control" id="oneTimePaymentMonthInput" value="12" min="1">
            </div>
        </div>
        
        <!-- Right Column: Results -->
        <div class="col-lg-7 d-flex flex-column">
            <div id="initialState" class="d-flex flex-grow-1 align-items-center justify-content-center h-100 text-center text-muted p-4" style="background-color: var(--bg-input); border-radius: 12px; border: 1px solid var(--border);">
                <h4>Enter your loan and prepayment details to see how much you can save.</h4>
            </div>

            <div id="resultsState" class="flex-grow-1" style="display: none;">
                <h4 class="text-center mb-4 text-gold-custom fw-bold">Your Prepayment Savings</h4>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="summary-card text-center p-3" style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); border-radius:12px;">
                            <div class="label" style="font-size:0.8rem; color:var(--text-muted);">Interest Saved</div>
                            <div class="value fw-bold fs-4" style="color:#10b981;" id="interestSaved">₹0</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="summary-card text-center p-3" style="background:rgba(56,189,248,0.1); border:1px solid rgba(56,189,248,0.3); border-radius:12px;">
                            <div class="label" style="font-size:0.8rem; color:var(--text-muted);">Time Saved</div>
                            <div class="value fw-bold fs-4 text-info" id="emisReduced">0 mos</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="summary-card text-center p-3" style="background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.3); border-radius:12px;">
                            <div class="label" style="font-size:0.8rem; color:var(--text-muted);">New Debt-Free Date</div>
                            <div class="value fw-bold fs-5 text-warning" id="newEndDate">-</div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="chart-container p-3 rounded" style="background: var(--bg-input); border: 1px solid var(--border);">
                            <h6 class="text-center mb-3">Total Interest Paid</h6>
                            <canvas id="interestChart"></canvas>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="chart-container p-3 rounded" style="background: var(--bg-input); border: 1px solid var(--border);">
                            <h6 class="text-center mb-3">Loan Tenure (Years)</h6>
                            <canvas id="tenureChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="action-toolbar" id="prepActionToolbar" style="display: none;">
        <span class="toolbar-label">Tools & Export:</span>
        <button type="button" class="btn-action-tool" id="btnExportPDF">
            <span>📄</span> Download Prepayment PDF
        </button>
        <button type="button" class="btn-action-tool btn-whatsapp" id="btnShareWA">
            <span>💬</span> Share on WhatsApp
        </button>
        <button type="button" class="btn-action-tool" id="btnCopyLink">
            <span>🔗</span> Copy Link
        </button>
        <button type="button" class="btn-action-tool" id="btnSaveCalc">
            <span>💾</span> Save Calculation
        </button>
    </div>
    
    <!-- Comparison Table -->
    <div id="comparisonSection" class="mt-5" style="display: none;">
        <h4 class="text-center mb-4">Before vs After Prepayment Comparison</h4>
        <div class="table-responsive">
            <table class="table table-bordered text-center" id="prepTable">
                <thead class="table-dark">
                    <tr><th>Details</th><th>Original Plan</th><th>With Prepayment</th></tr>
                </thead>
                <tbody>
                    <tr><td>Monthly Payment</td><td id="originalEMI"></td><td id="newEMI" class="fw-bold text-info"></td></tr>
                    <tr><td>Total Loan Tenure</td><td id="originalTenure"></td><td id="newTenure" class="fw-bold text-success"></td></tr>
                    <tr><td>Total Interest Paid</td><td id="originalInterest"></td><td id="newInterest" class="fw-bold text-success"></td></tr>
                    <tr><td>Total Amount Paid</td><td id="originalTotal"></td><td id="newTotal" class="fw-bold"></td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Related Calculators Section -->
    <div class="related-calculators-section">
        <h5 class="related-calc-title">💡 Related Loan Tools</h5>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <a href="/emi-calculator" class="related-mini-card">
                    <span class="icon">🏠</span>
                    <div>
                        <div class="title">Loan EMI</div>
                        <div class="desc">Monthly Payment</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/car-loan-calculator" class="related-mini-card">
                    <span class="icon">🚗</span>
                    <div>
                        <div class="title">Car Loan EMI</div>
                        <div class="desc">Down Payment Plan</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/sip-calculator" class="related-mini-card">
                    <span class="icon">📊</span>
                    <div>
                        <div class="title">SIP Calculator</div>
                        <div class="desc">Prepay vs Invest</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/hra-calculator" class="related-mini-card">
                    <span class="icon">🏢</span>
                    <div>
                        <div class="title">HRA Exemption</div>
                        <div class="desc">Tax Relief on Rent</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Information Accordion -->
    <div class="info-accordion mt-5">
        <div class="accordion" id="calculatorInfoAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
                        Why Prepaying Your Loan Early Saves Huge Money
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show">
                    <div class="accordion-body">
                        <p>In a typical 20-year home loan, you often end up paying almost <strong>as much in interest as your original principal loan amount</strong>!</p>
                        <p>When you make even a small recurring prepayment of ₹2,000 to ₹5,000 every month, 100% of that extra payment directly cuts down your outstanding principal balance, skipping years of compounding interest!</p>
                    </div>
                </div>
            </div>
        </div>
        <%- include('partials/ad_unit') %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const inputs = {
            amount: document.getElementById('loanAmountInput'),
            rate: document.getElementById('interestRateInput'),
            tenure: document.getElementById('loanTenureInput'),
            prepTypeRecurring: document.getElementById('typeRecurring'),
            prepTypeOneTime: document.getElementById('typeOneTime'),
            prepAmount: document.getElementById('prepaymentAmountInput'),
            prepMonth: document.getElementById('oneTimePaymentMonthInput')
        };
        const oneTimeWrapper = document.getElementById('oneTimePaymentMonthWrapper');
        const initialState = document.getElementById('initialState'), resultsState = document.getElementById('resultsState'), comparisonSection = document.getElementById('comparisonSection');
        const actionToolbar = document.getElementById('prepActionToolbar');
        let interestChart, tenureChart;
        let lastPrepData = null;

        const formatCurrency = (num) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num);

        // Attach Number to Words
        attachNumberToWords('loanAmountInput', 'loanAmountWords');
        attachNumberToWords('prepaymentAmountInput', 'prepAmountWords');

        // Presets
        createPresetChips('loanPresets', 'loanAmountInput', null, [
            { label: '₹15L', value: 1500000 },
            { label: '₹25L', value: 2500000 },
            { label: '₹50L', value: 5000000 },
            { label: '₹75L', value: 7500000 }
        ], calculateAndDisplay);

        createPresetChips('prepPresets', 'prepaymentAmountInput', null, [
            { label: '+₹2,000/mo', value: 2000 },
            { label: '+₹5,000/mo', value: 5000 },
            { label: '+₹10,000/mo', value: 10000 },
            { label: '+₹25,000/mo', value: 25000 }
        ], calculateAndDisplay);

        // Load URL Params
        const urlParams = loadParamsFromURL();
        inputs.amount.value = urlParams.p || 3000000;
        inputs.rate.value = urlParams.r || 8.5;
        inputs.tenure.value = urlParams.t || 20;
        inputs.prepAmount.value = urlParams.prep || 5000;

        function calculateAndDisplay() {
            const P = parseFloat(inputs.amount.value);
            const r_annual = parseFloat(inputs.rate.value);
            const t_years = parseFloat(inputs.tenure.value);

            if (isNaN(P) || isNaN(r_annual) || isNaN(t_years) || P <= 0 || r_annual <= 0 || t_years <= 0) {
                initialState.style.display = 'flex';
                resultsState.style.display = 'none';
                comparisonSection.style.display = 'none';
                if (actionToolbar) actionToolbar.style.display = 'none';
                return;
            }

            initialState.style.display = 'none';
            resultsState.style.display = 'block';
            comparisonSection.style.display = 'block';
            if (actionToolbar) actionToolbar.style.display = 'flex';

            const R = r_annual / 100 / 12;
            const N = t_years * 12;
            const emi = (P * R * Math.pow(1 + R, N)) / (Math.pow(1 + R, N) - 1);
            const originalTotalInterest = (emi * N) - P;
            const originalTotalPayment = P + originalTotalInterest;

            let newBalance = P;
            let totalInterestPaidNew = 0;
            let monthsPaid = 0;
            const prepAmount = parseFloat(inputs.prepAmount.value) || 0;
            const isRecurring = inputs.prepTypeRecurring.checked;
            const oneTimeMonth = parseInt(inputs.prepMonth.value) || 12;

            for (let i = 1; i <= N; i++) {
                const interestForMonth = newBalance * R;
                let principalForMonth = emi - interestForMonth;
                totalInterestPaidNew += interestForMonth;
                if (isRecurring && prepAmount > 0) principalForMonth += prepAmount;
                if (!isRecurring && i === oneTimeMonth && prepAmount > 0) principalForMonth += prepAmount;
                newBalance -= principalForMonth;
                monthsPaid = i;
                if (newBalance <= 0) break;
            }

            const newTotalPayment = P + totalInterestPaidNew;
            const interestSaved = originalTotalInterest - totalInterestPaidNew;
            const emisReduced = N - monthsPaid;
            const yearsReduced = (emisReduced / 12).toFixed(1);

            const endDate = new Date();
            endDate.setMonth(endDate.getMonth() + monthsPaid);
            const newEndDate = endDate.toLocaleString('default', { month: 'short', year: 'numeric' });

            document.getElementById('interestSaved').textContent = formatCurrency(interestSaved);
            document.getElementById('emisReduced').textContent = `${yearsReduced} Yrs (${emisReduced} mos)`;
            document.getElementById('newEndDate').textContent = newEndDate;

            // Sync URL
            syncParamsToURL({
                p: P, r: r_annual, t: t_years, prep: prepAmount, type: isRecurring ? 'rec' : 'once'
            });

            // Charts
            if (interestChart) interestChart.destroy();
            if (tenureChart) tenureChart.destroy();

            const interestCtx = document.getElementById('interestChart').getContext('2d');
            interestChart = new Chart(interestCtx, {
                type: 'bar',
                data: {
                    labels: ['Original', 'With Prepayment'],
                    datasets: [{
                        label: 'Total Interest Paid',
                        data: [originalTotalInterest, totalInterestPaidNew],
                        backgroundColor: ['#ef4444', '#10b981']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });

            const tenureCtx = document.getElementById('tenureChart').getContext('2d');
            tenureChart = new Chart(tenureCtx, {
                type: 'bar',
                data: {
                    labels: ['Original', 'With Prepayment'],
                    datasets: [{
                        label: 'Loan Tenure (Years)',
                        data: [t_years, monthsPaid / 12],
                        backgroundColor: ['#0d6efd', '#f59e0b']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });

            document.getElementById('originalEMI').textContent = formatCurrency(emi);
            document.getElementById('newEMI').textContent = isRecurring ? formatCurrency(emi + prepAmount) : formatCurrency(emi);
            document.getElementById('originalTenure').textContent = `${t_years} Years (${N} months)`;
            document.getElementById('newTenure').textContent = `${(monthsPaid/12).toFixed(1)} Years (${monthsPaid} months)`;
            document.getElementById('originalInterest').textContent = formatCurrency(originalTotalInterest);
            document.getElementById('newInterest').textContent = formatCurrency(totalInterestPaidNew);
            document.getElementById('originalTotal').textContent = formatCurrency(originalTotalPayment);
            document.getElementById('newTotal').textContent = formatCurrency(newTotalPayment);

            lastPrepData = {
                P, r_annual, t_years, prepAmount, isRecurring, interestSaved, emisReduced, yearsReduced,
                originalTotalInterest, totalInterestPaidNew, originalTotalPayment, newTotalPayment, newEndDate
            };
        }

        function togglePrepaymentType() {
            oneTimeWrapper.style.display = inputs.prepTypeOneTime.checked ? 'block' : 'none';
            calculateAndDisplay();
        }

        Object.values(inputs).forEach(input => {
            input.addEventListener('input', calculateAndDisplay);
            input.addEventListener('change', calculateAndDisplay);
        });

        inputs.prepTypeRecurring.addEventListener('change', togglePrepaymentType);
        inputs.prepTypeOneTime.addEventListener('change', togglePrepaymentType);

        // Toolbar
        document.getElementById('btnExportPDF').addEventListener('click', () => {
            if (!lastPrepData) return;
            exportCalculatorPDF({
                docTitle: `Loan Prepayment Savings Report (${formatCurrency(lastPrepData.P)} @ ${lastPrepData.r_annual}%)`,
                summaryData: [
                    { label: 'Total Interest Saved', value: formatCurrency(lastPrepData.interestSaved), highlight: true },
                    { label: 'Tenure Reduced', value: `${lastPrepData.yearsReduced} Years` },
                    { label: 'Original Interest', value: formatCurrency(lastPrepData.originalTotalInterest) },
                    { label: 'New Debt-Free Date', value: lastPrepData.newEndDate }
                ],
                tableHeaders: ['Loan Comparison Metric', 'Original Loan Plan', 'With Prepayment Plan'],
                tableRows: [
                    ['Loan Principal', formatCurrency(lastPrepData.P), formatCurrency(lastPrepData.P)],
                    ['Loan Tenure', `${lastPrepData.t_years} Years`, `${(lastPrepData.t_years - lastPrepData.yearsReduced).toFixed(1)} Years`],
                    ['Total Interest Payable', formatCurrency(lastPrepData.originalTotalInterest), formatCurrency(lastPrepData.totalInterestPaidNew)],
                    ['Total Amount Paid', formatCurrency(lastPrepData.originalTotalPayment), formatCurrency(lastPrepData.newTotalPayment)],
                    ['Net Cash Savings', '₹0', formatCurrency(lastPrepData.interestSaved)]
                ],
                filename: 'loan_prepayment_savings_report'
            });
        });

        document.getElementById('btnShareWA').addEventListener('click', () => {
            if (!lastPrepData) return;
            const summary = `🏠 *Loan Amount:* ${formatCurrency(lastPrepData.P)}\n💡 *Prepayment:* ${formatCurrency(lastPrepData.prepAmount)} ${lastPrepData.isRecurring ? '/month' : 'lump sum'}\n\n🎉 *Total Interest Saved:* ${formatCurrency(lastPrepData.interestSaved)}\n⚡ *Tenure Cut:* ${lastPrepData.yearsReduced} Years earlier!\n🏆 *New Loan End Date:* ${lastPrepData.newEndDate}`;
            shareViaWhatsApp('Loan Prepayment Savings Analysis', summary);
        });

        document.getElementById('btnCopyLink').addEventListener('click', copyShareableURL);

        document.getElementById('btnSaveCalc').addEventListener('click', () => {
            if (!lastPrepData) return;
            const name = prompt('Label this prepayment calculation:', `Save ${formatCurrency(lastPrepData.interestSaved)} on ${formatCurrency(lastPrepData.P)}`);
            if (name) {
                saveCalculation(name, {
                    saved: formatCurrency(lastPrepData.interestSaved),
                    loan: formatCurrency(lastPrepData.P)
                });
            }
        });

        calculateAndDisplay();
    });
</script>

<%- include('partials/footer') %>
<%- include('partials/header') %>
<div class="form-card">
    <h3 class="mb-1">📈 Mutual Fund Returns Calculator</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">Calculate Absolute, Annualized & CAGR returns on your mutual fund portfolios</p>
<%- include('partials/ad_unit') %>
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="mb-4">
                <label class="form-label">Initial Investment / Total Invested (₹)</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="mfInvested" value="200000" step="5000" oninput="calculate()"></div>
                <div id="mfAmtWords" class="words-helper" style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Current Value / Redemption Amount (₹)</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="mfCurrent" value="380000" step="5000" oninput="calculate()"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Holding Period (Years)</label>
                <div class="input-group"><input type="number" class="form-control" id="mfYears" value="4" step="0.5" min="0.1" max="50" oninput="calculate()"><span class="input-group-text">Years</span></div>
            </div>
            <div class="highlight-box">
                <h4>💡 Returns Explained</h4>
                <p><strong>Absolute Return:</strong> Total gain percentage regardless of time.<br><strong>CAGR:</strong> True annualized compound growth rate per year.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div id="resultsState">
                <div class="emi-result-display"><p class="label">CAGR (Annualized Return)</p><p class="amount" id="mfCagr">17.41%</p></div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">Total Capital Invested</div><div class="value" id="rInvested">₹2,00,000</div></div>
                    <div class="summary-item"><div class="label">Current Portfolio Value</div><div class="value" id="rCurrent">₹3,80,000</div></div>
                    <div class="summary-item"><div class="label">Net Profit / Gain</div><div class="value" style="color:var(--accent-green);" id="rGain">+₹1,80,000</div></div>
                    <div class="summary-item"><div class="label">Absolute Return</div><div class="value" style="color:var(--gold);" id="rAbs">90.00%</div></div>
                    <div class="summary-item"><div class="label">Holding Duration</div><div class="value" id="rPeriod">4 Years</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="related-section"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/sip-calculator" class="related-card"><span class="icon">📊</span><div class="title">SIP Calculator</div><div class="desc">Monthly SIP returns</div></a></div>
            <div class="col-md-4"><a href="/lumpsum-calculator" class="related-card"><span class="icon">💎</span><div class="title">Lump Sum Calculator</div><div class="desc">One-time wealth growth</div></a></div>
            <div class="col-md-4"><a href="/capital-gains-tax-calculator" class="related-card"><span class="icon">📉</span><div class="title">Capital Gains Tax</div><div class="desc">LTCG & STCG tax</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>
<!-- Toolbar -->
<div class="action-toolbar" id="mfToolbar">
    <span class="toolbar-label">Tools:</span>
    <button type="button" class="btn-action-tool" id="mfBtnSave">💾 Save Calculation</button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="mfBtnShare">💬 Share on WhatsApp</button>
    <button type="button" class="btn-action-tool" id="mfBtnCopy">🔗 Copy Link</button>
</div>
<script>
const fmt = n => new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function calculate() {
    const inv = parseFloat(document.getElementById('mfInvested').value)||0;
    const cur = parseFloat(document.getElementById('mfCurrent').value)||0;
    const yr = parseFloat(document.getElementById('mfYears').value)||0;

    if(typeof attachNumberToWords === 'function') {
        const el = document.getElementById('mfAmtWords');
        if(el) el.textContent = convertNumberToIndianWords(inv);
    }

    if(inv <= 0 || cur <= 0 || yr <= 0) return;
    const gain = cur - inv;
    const absReturn = (gain / inv) * 100;
    const cagr = (Math.pow(cur / inv, 1 / yr) - 1) * 100;

    document.getElementById('mfCagr').textContent = cagr.toFixed(2) + '%';
    document.getElementById('rInvested').textContent = fmt(inv);
    document.getElementById('rCurrent').textContent = fmt(cur);
    document.getElementById('rGain').textContent = (gain >= 0 ? '+' : '') + fmt(gain);
    document.getElementById('rAbs').textContent = absReturn.toFixed(2) + '%';
    document.getElementById('rPeriod').textContent = yr + ' Years';

    window._lastMF = { inv, cur, yr, gain, absReturn, cagr };
}
document.addEventListener('DOMContentLoaded', () => {
    calculate();
    document.getElementById('mfBtnSave').addEventListener('click', () => {
        const d = window._lastMF; if(!d) return;
        const name = prompt('Save as:', `Mutual Fund CAGR ${d.cagr.toFixed(1)}%`);
        if(name) saveCalculation(name, { Invested: fmt(d.inv), Current: fmt(d.cur), CAGR: d.cagr.toFixed(2)+'%', Gain: fmt(d.gain) });
    });
    document.getElementById('mfBtnShare').addEventListener('click', () => {
        const d = window._lastMF; if(!d) return;
        shareViaWhatsApp('Mutual Fund Returns Calculator', `Invested: ${fmt(d.inv)}\nCurrent: ${fmt(d.cur)}\nCAGR: ${d.cagr.toFixed(2)}%\nAbsolute Return: ${d.absReturn.toFixed(2)}%`);
    });
    document.getElementById('mfBtnCopy').addEventListener('click', copyShareableURL);
});
</script>
<%- include('partials/footer') %>

<!-- Standard Action Toolbar Reusable Across All Calculators -->
<div class="action-toolbar" id="standardActionToolbar">
    <span class="toolbar-label">Tools & Export:</span>
    <button type="button" class="btn-action-tool" id="btnExportPDF" title="Download Official PDF Statement with Charts">
        <span>📄</span> Download PDF Report
    </button>
    <button type="button" class="btn-action-tool" id="btnExportCSV" title="Export Schedule as CSV/Excel Spreadsheet">
        <span>📊</span> Export Excel/CSV
    </button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="btnShareWA" title="Share Calculation Summary on WhatsApp">
        <span>💬</span> Share on WhatsApp
    </button>
    <button type="button" class="btn-action-tool" id="btnCopyLink" title="Copy Link with Current Calculation Parameters">
        <span>🔗</span> Copy Link
    </button>
    <button type="button" class="btn-action-tool" id="btnSaveCalc" title="Save Calculation to Local Storage">
        <span>💾</span> Save Calculation
    </button>
</div>

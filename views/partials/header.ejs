<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DSS4N95B8B"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-DSS4N95B8B');
    </script>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8732458645979427"
            crossorigin="anonymous"></script>

    <!-- SEO Meta Tags for Top Google SERP Rankings -->
    <title><%= title %></title>
    <meta name="description" content="<%= locals.description || 'A collection of 330+ free, accurate financial calculators for investment, mutual fund SIP, home loan EMI, New Tax Regime FY 2026-27, salary and retirement planning.' %>">
    <meta name="keywords" content="financial calculators India, SIP calculator, EMI calculator, New Tax Regime FY 2026-27, in hand salary calculator, FD calculator, PPF calculator, FIRE calculator, corporate finance tools">
    <meta name="author" content="FinancialHub">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large">
    <meta name="theme-color" content="#070d1a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="format-detection" content="telephone=no">

    <!-- PWA Manifest & App Icons -->
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon.svg">

    <!-- Canonical URL -->
    <link rel="canonical" href="https://financialhub.calculatorfree.in<%= locals.canonicalPath || '/' %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="<%= locals.isHomePage ? 'website' : 'article' %>">
    <meta property="og:site_name" content="FinancialHub">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= locals.description || 'India\'s most accurate suite of 330+ free financial calculators.' %>">
    <meta property="og:url" content="https://financialhub.calculatorfree.in<%= locals.canonicalPath || '/' %>">
    <meta property="og:image" content="https://www.calculatorfree.in/wp-content/uploads/2025/07/cropped-calculatorfree.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="en_IN">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@FinancialHubIN">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= locals.description || 'India\'s most accurate suite of 330+ free financial calculators.' %>">
    <meta name="twitter:image" content="https://www.calculatorfree.in/wp-content/uploads/2025/07/cropped-calculatorfree.png">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
    <link rel="alternate icon" type="image/png" href="https://www.calculatorfree.in/wp-content/uploads/2025/07/cropped-calculatorfree.png">

    <!-- Schema.org Structured Data -->
    <% if (locals.schema) { %>
    <script type="application/ld+json">
        <%- schema %>
    </script>
    <% } %>

    <!-- Fonts & Core Assets Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <!-- Core Calculator Dependencies & Charting Engine -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script src="/js/financial-core.js"></script>
</head>
<body>

    <!-- Immediate Theme Init (prevents flash) -->
    <script>
        (function() {
            const saved = localStorage.getItem('fh-theme') || 'dark';
            if (saved === 'light') document.documentElement.setAttribute('data-theme', 'light');
        })();
    </script>

    <!-- PWA Install Banner -->
    <div id="pwaInstallBanner" class="pwa-top-banner" style="display: none;">
        <div class="container-fluid px-lg-5 px-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <span class="pwa-banner-icon">📱</span>
                <div>
                    <strong>Install Financial Hub App</strong>
                    <span class="d-none d-md-inline ms-2 text-muted-custom">— Fast, lightweight & 100% offline ready!</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-warning btn-sm fw-bold px-3" onclick="installPWAApp()">Install App</button>
                <button type="button" class="btn-close btn-close-white" onclick="document.getElementById('pwaInstallBanner').style.display='none'" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand site-header sticky-top">
        <div class="container-fluid px-lg-5 px-3 d-flex align-items-center justify-content-between">
            
            <!-- Left: Brand Logo & Portal Links -->
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a class="navbar-brand d-inline-flex align-items-center m-0" href="/" style="white-space: nowrap;">
                    <span class="brand-badge-icon">₹</span>
                    <span class="fw-bold">Financial</span><span class="fw-normal ms-1 brand-subtext">Hub</span>
                </a>

                <!-- Navigation Portal Links -->
                <div class="d-none d-lg-flex align-items-center gap-1 ms-2">
                    <a href="/" class="nav-portal-link <%= (locals.isHomePage) ? 'active' : '' %>" title="Financial Hub Home">
                        <span>🏠</span> <span>Home</span>
                    </a>
                    <a href="https://health-hub.calculatorfree.in/" target="_blank" rel="noopener noreferrer" class="nav-portal-link" title="Health Hub Calculators">
                        <span>❤️</span> <span>HealthHub</span>
                    </a>
                    <a href="https://engineering.calculatorfree.in/" target="_blank" rel="noopener noreferrer" class="nav-portal-link" title="Engineering Hub Tools">
                        <span>⚙️</span> <span>EnggHub</span>
                    </a>
                </div>
            </div>

            <!-- Center: Spotlight Search Bar -->
            <div class="d-none d-xl-flex align-items-center flex-grow-1 justify-content-center mx-3" style="max-width: 420px;">
                <button type="button" class="nav-search-trigger w-100" onclick="openSpotlightSearch()">
                    <span class="search-icon">🔍</span>
                    <span class="search-placeholder-text">Search 300+ calculators...</span>
                    <span class="search-badge ms-auto">Ctrl K</span>
                </button>
            </div>

            <!-- Right: Actions (Mobile Links, Saved, Theme, Main Button) -->
            <div class="d-flex align-items-center gap-2">
                <!-- Mobile / Tablet Quick Links -->
                <a href="/" class="btn btn-nav-action d-lg-none p-1 px-2" title="Home">🏠</a>
                <a href="https://health-hub.calculatorfree.in/" target="_blank" rel="noopener noreferrer" class="btn btn-nav-action d-lg-none p-1 px-2" title="HealthHub">❤️</a>
                <a href="https://engineering.calculatorfree.in/" target="_blank" rel="noopener noreferrer" class="btn btn-nav-action d-lg-none p-1 px-2" title="EnggHub">⚙️</a>

                <!-- Spotlight Search Trigger Icon -->
                <button type="button" class="btn btn-link btn-nav-action d-xl-none p-1 px-2" onclick="openSpotlightSearch()" aria-label="Search" title="Search Calculators">
                    🔍
                </button>

                <!-- Saved Calculations Button -->
                <button type="button" class="btn btn-nav-action" onclick="openSavedModal()" title="Saved Calculations">
                    <span>💾</span>
                    <span class="d-none d-sm-inline ms-1">Saved</span>
                </button>

                <!-- Theme Toggle -->
                <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" id="themeToggleBtn" aria-label="Toggle Light/Dark Theme">
                    <span class="theme-icon" id="themeIcon">🌙</span>
                    <span class="theme-label d-none d-sm-inline" id="themeLabel">Dark</span>
                </button>

                <!-- Main Portal Button -->
                <a href="https://www.calculatorfree.in" target="_blank" rel="noopener noreferrer" class="nav-portal-main ms-1 d-inline-flex align-items-center gap-1" title="Go to Main CalculatorFree Portal">
                    <span>Main</span> ↗
                </a>
            </div>
        </div>
    </nav>

    <!-- Spotlight Search Overlay Modal -->
    <div id="spotlightModal" class="spotlight-overlay" onclick="if(event.target === this) closeSpotlightSearch()">
        <div class="spotlight-dialog">
            <div class="spotlight-header">
                <span class="spotlight-search-icon">🔍</span>
                <input 
                    type="text" 
                    id="spotlightInput" 
                    class="spotlight-input" 
                    placeholder="Type to search all 300+ calculators (SIP, Salary, EMI, Tax, PPF, FIRE...)" 
                    autocomplete="off"
                    autofocus
                >
                <button type="button" class="spotlight-close-btn" onclick="closeSpotlightSearch()">ESC</button>
            </div>
            <div id="spotlightResults" class="spotlight-results">
                <!-- Results injected dynamically via financial-core.js -->
            </div>
            <div class="spotlight-footer">
                <span>Navigate <kbd>↑</kbd> <kbd>↓</kbd></span>
                <span>Open <kbd>↵</kbd></span>
                <span>Close <kbd>Esc</kbd></span>
            </div>
        </div>
    </div>

    <!-- ===== SAVED CALCULATIONS MODAL ===== -->
    <div id="savedCalcsModal" class="spotlight-overlay" onclick="if(event.target === this) closeSavedModal()">
        <div class="spotlight-dialog">
            <div class="spotlight-header justify-content-between">
                <h5 class="m-0 text-gold-custom fw-bold d-flex align-items-center gap-2">
                    <span>💾</span> Saved Calculations <span style="font-size:0.7rem; color:var(--text-muted); font-weight:400;">(Local & Private)</span>
                </h5>
                <button type="button" class="spotlight-close-btn" onclick="closeSavedModal()">✕</button>
            </div>
            <div id="savedCalcsList" class="spotlight-results p-3">
                <!-- Injected via financial-core.js -->
            </div>
        </div>
    </div>

    <div class="container-fluid px-lg-5 px-3 mt-3">

    <% if (typeof path !== 'undefined' && path !== '/') { %>
        <!-- ===== CALCULATOR TOP NAVIGATION / BACK TO HOME BAR ===== -->
        <div class="calc-top-nav-bar fade-in-up">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <!-- Back to Home Button -->
                <a href="/" class="btn-back-home" title="Return to Homepage">
                    <span class="back-arrow">←</span>
                    <span>All 50 Calculators</span>
                </a>

                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="calc-breadcrumb d-none d-md-flex align-items-center">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/">🏠 Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><%= typeof title !== 'undefined' ? title.split('—')[0].split('-')[0].trim() : 'Calculator' %></li>
                    </ol>
                </nav>

                <!-- Quick Switch Calculator (Ctrl + K) -->
                <button type="button" class="btn-quick-switch" onclick="openSpotlightSearch()" title="Switch Calculator">
                    <span>🔍 Switch Calculator</span>
                    <kbd>Ctrl K</kbd>
                </button>
            </div>
        </div>
    <% } %>

<script>
    function toggleTheme() {
        const html  = document.documentElement;
        const next  = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        html.setAttribute('data-theme', next);
        localStorage.setItem('fh-theme', next);
        updateToggleUI(next);
    }

    function updateToggleUI(theme) {
        const icon  = document.getElementById('themeIcon');
        const label = document.getElementById('themeLabel');
        if (!icon || !label) return;
        if (theme === 'light') {
            icon.textContent  = '☀️';
            label.textContent = 'Light';
        } else {
            icon.textContent  = '🌙';
            label.textContent = 'Dark';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        updateToggleUI(localStorage.getItem('fh-theme') || 'dark');
    });
</script>
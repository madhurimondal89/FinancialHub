            ]
        }
        </script>

        <%- include('partials/ad_unit') %>
    </div>
</div>

<!-- JavaScript Integration -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const monthlyInput = document.getElementById('monthlyInput'), monthlySlider = document.getElementById('monthlySlider');
        const rateInput = document.getElementById('rateInput'), rateSlider = document.getElementById('rateSlider');
        const periodInput = document.getElementById('periodInput'), periodSlider = document.getElementById('periodSlider');
        const periodTypeYears = document.getElementById('periodTypeYears'), periodTypeMonths = document.getElementById('periodTypeMonths');
        const periodUnitLabel = document.getElementById('periodUnitLabel');
        const inflationToggle = document.getElementById('inflationToggle');
        const inflationBadge = document.getElementById('inflationAdjustedBadge');
        const realValueText = document.getElementById('realValueText');
        const wealthMultiplier = document.getElementById('wealthMultiplier');
        
        const initialState = document.getElementById('initialState');
        const resultsState = document.getElementById('resultsState');
        const yearlyBreakdownSection = document.getElementById('yearlyBreakdownSection');
        const actionToolbar = document.getElementById('sipActionToolbar');
        
        const futureValue = document.getElementById('futureValue');
        const investedAmount = document.getElementById('investedAmount');
        const estimatedReturns = document.getElementById('estimatedReturns');
        const projectionTitle = document.getElementById('projectionTitle');
        const projectionHead = document.getElementById('projectionHead');
        const projectionBody = document.getElementById('projectionBody');
        const pieChartCanvas = document.getElementById('sipPieChart');
        
        let sipPieChart;
        let lastCalcResult = null;

        const formatCurrency = (num) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num);

        // 1. Attach Number-to-Words
        attachNumberToWords('monthlyInput', 'monthlyWords');

        // 2. Preset Chips
        createPresetChips('monthlyPresets', 'monthlyInput', 'monthlySlider', [
            { label: '₹2.5K', value: 2500 },
            { label: '₹5K', value: 5000 },
            { label: '₹10K', value: 10000 },
            { label: '₹25K', value: 25000 },
            { label: '₹50K', value: 50000 },
            { label: '₹1 Lakh', value: 100000 }
        ], calculateAndDisplay);

        createPresetChips('ratePresets', 'rateInput', 'rateSlider', [
            { label: '8% (Conservative)', value: 8 },
            { label: '12% (Balanced)', value: 12 },
            { label: '15% (Aggressive)', value: 15 }
        ], calculateAndDisplay);

        createPresetChips('periodPresets', 'periodInput', 'periodSlider', [
            { label: '5 Yrs', value: 5 },
            { label: '10 Yrs', value: 10 },
            { label: '15 Yrs', value: 15 },
            { label: '20 Yrs', value: 20 },
            { label: '25 Yrs', value: 25 }
        ], calculateAndDisplay);

        // 3. Load initial values from URL params or default
        const urlParams = loadParamsFromURL();
        if (urlParams.p) monthlyInput.value = monthlySlider.value = urlParams.p;
        else monthlyInput.value = monthlySlider.value = 10000;

        if (urlParams.r) rateInput.value = rateSlider.value = urlParams.r;
        else rateInput.value = rateSlider.value = 12;

        if (urlParams.t) {
            periodInput.value = periodSlider.value = urlParams.t;
            if (urlParams.type === 'm') periodTypeMonths.checked = true;
        } else {
            periodInput.value = periodSlider.value = 15;
        }

        // 4. Main Calculation Function
        function calculateAndDisplay() {
            const P = parseFloat(monthlyInput.value);
            const r = parseFloat(rateInput.value) / 100;
            const periodValue = parseInt(periodInput.value);
            const isYears = periodTypeYears.checked;
            const n = isYears ? periodValue * 12 : periodValue;

            if (isNaN(P) || isNaN(r) || isNaN(n) || P <= 0 || r < 0 || n <= 0) {
                initialState.style.display = 'flex';
                resultsState.style.display = 'none';
                yearlyBreakdownSection.style.display = 'none';
                if (actionToolbar) actionToolbar.style.display = 'none';
                if (sipPieChart) sipPieChart.destroy();
                return;
            }

            initialState.style.display = 'none';
            resultsState.style.display = 'block';
            yearlyBreakdownSection.style.display = 'block';
            if (actionToolbar) actionToolbar.style.display = 'flex';

            const i = r / 12;
            const totalValue = P * ((Math.pow(1 + i, n) - 1) / i) * (1 + i);
            const totalInvested = P * n;
            const totalReturns = totalValue - totalInvested;
            const mult = totalInvested > 0 ? (totalValue / totalInvested).toFixed(2) : '1.00';

            futureValue.textContent = formatCurrency(totalValue);
            investedAmount.textContent = formatCurrency(totalInvested);
            estimatedReturns.textContent = formatCurrency(totalReturns);
            wealthMultiplier.textContent = `${mult}x`;

            // Inflation calculation (6% default)
            if (inflationToggle && inflationToggle.checked) {
                const yearsCount = isYears ? periodValue : (periodValue / 12);
                const realPurchasingPower = totalValue / Math.pow(1 + 0.06, yearsCount);
                realValueText.textContent = formatCurrency(realPurchasingPower);
                inflationBadge.style.display = 'block';
            } else {
                inflationBadge.style.display = 'none';
            }

            // Sync with URL params
            syncParamsToURL({
                p: P,
                r: rateInput.value,
                t: periodValue,
                type: isYears ? 'y' : 'm'
            });

            // Pie/Doughnut Chart
            if (sipPieChart) sipPieChart.destroy();
            sipPieChart = new Chart(pieChartCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Invested Amount', 'Est. Returns'],
                    datasets: [{
                        data: [totalInvested, totalReturns],
                        backgroundColor: ['#0d6efd', '#10b981'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });

            // Table Breakdown
            projectionBody.innerHTML = '';
            let balance = 0, totalInvestmentToDate = 0;
            const tableRows = [];

            if (isYears) {
                projectionTitle.textContent = 'Year-by-Year Wealth Growth';
                projectionHead.innerHTML = `<tr><th>Year</th><th>Invested Amount</th><th>Est. Returns</th><th>Ending Balance</th></tr>`;
                for (let year = 1; year <= periodValue; year++) {
                    for (let month = 1; month <= 12; month++) { balance = (balance + P) * (1 + i); }
                    totalInvestmentToDate += P * 12;
                    const returnsToDate = balance - totalInvestmentToDate;
                    const rowData = [
                        `Year ${year}`,
                        formatCurrency(totalInvestmentToDate),
                        formatCurrency(returnsToDate),
                        formatCurrency(balance)
                    ];
                    tableRows.push(rowData);
                    projectionBody.innerHTML += `<tr><td>${year}</td><td>${formatCurrency(totalInvestmentToDate)}</td><td>${formatCurrency(returnsToDate)}</td><td><strong>${formatCurrency(balance)}</strong></td></tr>`;
                }
            } else {
                projectionTitle.textContent = 'Month-by-Month Wealth Growth';
                projectionHead.innerHTML = `<tr><th>Month</th><th>Invested Amount</th><th>Est. Returns</th><th>Ending Balance</th></tr>`;
                for (let month = 1; month <= n; month++) {
                    balance = (balance + P) * (1 + i);
                    totalInvestmentToDate += P;
                    const returnsToDate = balance - totalInvestmentToDate;
                    const rowData = [
                        `Month ${month}`,
                        formatCurrency(totalInvestmentToDate),
                        formatCurrency(returnsToDate),
                        formatCurrency(balance)
                    ];
                    tableRows.push(rowData);
                    projectionBody.innerHTML += `<tr><td>${month}</td><td>${formatCurrency(totalInvestmentToDate)}</td><td>${formatCurrency(returnsToDate)}</td><td><strong>${formatCurrency(balance)}</strong></td></tr>`;
                }
            }

            lastCalcResult = {
                P, rate: rateInput.value, periodValue, isYears,
                totalValue, totalInvested, totalReturns, mult,
                tableHeaders: isYears ? ['Year', 'Invested Amount', 'Est. Returns', 'Ending Balance'] : ['Month', 'Invested Amount', 'Est. Returns', 'Ending Balance'],
                tableRows
            };
        }

        function updatePeriodControls() {
            const isYears = periodTypeYears.checked;
            let currentValue = parseFloat(periodInput.value) || (isYears ? 1 : 12);
            if (isYears) {
                periodSlider.min = 1; periodSlider.max = 40; periodInput.min = 1; periodInput.max = 40;
                periodUnitLabel.textContent = 'Years';
                if (currentValue > 40) periodInput.value = Math.round(currentValue / 12);
            } else {
                periodSlider.min = 1; periodSlider.max = 480; periodInput.min = 1; periodInput.max = 480;
                periodUnitLabel.textContent = 'Months';
                if (currentValue <= 40) periodInput.value = currentValue * 12;
            }
            syncAndCalculate(periodInput, periodSlider);
        }

        function syncAndCalculate(source, target) {
            if (target) target.value = source.value;
            calculateAndDisplay();
        }

        monthlySlider.addEventListener('input', () => syncAndCalculate(monthlySlider, monthlyInput));
        monthlyInput.addEventListener('input', () => syncAndCalculate(monthlyInput, monthlySlider));
        rateSlider.addEventListener('input', () => syncAndCalculate(rateSlider, rateInput));
        rateInput.addEventListener('input', () => syncAndCalculate(rateInput, rateSlider));
        periodSlider.addEventListener('input', () => syncAndCalculate(periodSlider, periodInput));
        periodInput.addEventListener('input', () => syncAndCalculate(periodInput, periodSlider));
        periodTypeYears.addEventListener('change', updatePeriodControls);
        periodTypeMonths.addEventListener('change', updatePeriodControls);
        if (inflationToggle) inflationToggle.addEventListener('change', calculateAndDisplay);

        // Toolbar Buttons
        document.getElementById('btnExportPDF').addEventListener('click', () => {
            if (!lastCalcResult) return;
            exportCalculatorPDF({
                docTitle: `SIP Investment Report (${formatCurrency(lastCalcResult.P)}/mo @ ${lastCalcResult.rate}% for ${lastCalcResult.periodValue} ${lastCalcResult.isYears ? 'Yrs' : 'Mos'})`,
                summaryData: [
                    { label: 'Monthly Investment', value: formatCurrency(lastCalcResult.P) },
                    { label: 'Total Invested', value: formatCurrency(lastCalcResult.totalInvested) },
                    { label: 'Estimated Returns', value: formatCurrency(lastCalcResult.totalReturns) },
                    { label: 'Future Value', value: formatCurrency(lastCalcResult.totalValue), highlight: true }
                ],
                tableHeaders: lastCalcResult.tableHeaders,
                tableRows: lastCalcResult.tableRows,
                chartCanvasId: 'sipPieChart',
                filename: 'sip_investment_report'
            });
        });

        document.getElementById('btnExportCSV').addEventListener('click', () => {
            exportTableToCSV('sip_investment_schedule', 'projectionTable');
        });

        document.getElementById('btnShareWA').addEventListener('click', () => {
            if (!lastCalcResult) return;
            const summary = `💰 *Monthly SIP:* ${formatCurrency(lastCalcResult.P)}\n📈 *Return Rate:* ${lastCalcResult.rate}% p.a.\n⏳ *Duration:* ${lastCalcResult.periodValue} ${lastCalcResult.isYears ? 'Years' : 'Months'}\n\n💵 *Total Invested:* ${formatCurrency(lastCalcResult.totalInvested)}\n🎉 *Est. Returns:* ${formatCurrency(lastCalcResult.totalReturns)}\n🏆 *Future Corpus:* ${formatCurrency(lastCalcResult.totalValue)} (${lastCalcResult.mult}x wealth growth!)`;
            shareViaWhatsApp('SIP Wealth Projection Report', summary);
        });

        document.getElementById('btnCopyLink').addEventListener('click', copyShareableURL);

        document.getElementById('btnSaveCalc').addEventListener('click', () => {
            if (!lastCalcResult) return;
            const name = prompt('Enter a name for this calculation (e.g., "Retirement SIP ₹10k")', `SIP ${formatCurrency(lastCalcResult.P)} (${lastCalcResult.periodValue}Y)`);
            if (name) {
                saveCalculation(name, {
                    monthly: lastCalcResult.P,
                    futureValue: formatCurrency(lastCalcResult.totalValue)
                });
            }
        });

        calculateAndDisplay();
    });
</script>


<%- include('partials/header') %>
<div class="form-card">
    <div class="p-3 mb-3 rounded-3 border" style="background: rgba(13, 110, 253, 0.05); border-color: rgba(13, 110, 253, 0.2) !important;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span style="font-size: 1.25rem;">📑</span>
                <div>
                    <strong class="text-body-emphasis small d-block">CBDT & Income Tax Department TDS Compliance Engine</strong>
                    <span class="text-muted" style="font-size: 0.78rem;">Calculates statutory withholding tax deductions under Section 194C, 194J, 194I, 194A, and Section 206AA (FY 2026-27).</span>
                </div>
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.75rem;">✓ 100% Verified Tax Logic</span>
        </div>
    </div>

    <h1 class="h3 fw-bold mb-1">TDS Calculator (Tax Deducted at Source FY 2026-27)</h1>
    <p class="text-secondary mb-4" style="font-size:0.95rem;">Calculate accurate statutory TDS deduction rates, net payable amount, and threshold limits under Section 194C, 194J, 194I, 194A, and 194H.</p>
    
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="mb-3">
                <label class="form-label fw-bold">TDS Section & Nature of Payment</label>
                <select class="form-select fw-semibold" id="tdsSection" onchange="calculate()">
                    <option value="194J_tech" selected>194J: Technical / Royalty / Call Centre (2%)</option>
                    <option value="194J_prof">194J: Professional Fees / Legal / Medical / CA (10%)</option>
                    <option value="194C_ind">194C: Contractor / Sub-contractor (Individual / HUF) (1%)</option>
                    <option value="194C_corp">194C: Contractor (Company / Partnership Firm) (2%)</option>
                    <option value="194I_rent">194I: Rent on Land & Building / Furniture (10%)</option>
                    <option value="194I_plant">194I: Rent on Plant & Machinery (2%)</option>
                    <option value="194H_comm">194H: Commission or Brokerage (5%)</option>
                    <option value="194A_int">194A: Bank Interest / Fixed Deposit (10%)</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label fw-bold">Gross Invoice / Payment Amount (₹)</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control fw-bold" id="tdsGross" value="150000" step="5000" oninput="calculate()"></div>
                <div id="tdsWords" class="words-helper" style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;"></div>
            </div>
            <div class="mb-4">
                <div class="form-check form-switch p-3 rounded border" style="background:var(--bg-input, rgba(255,255,255,0.02));">
                    <input class="form-check-input ms-0 me-3" type="checkbox" id="tdsNoPan" onchange="calculate()" style="cursor:pointer;">
                    <label class="form-check-label fw-semibold text-danger" for="tdsNoPan" style="cursor:pointer;">
                        ⚠️ PAN Not Furnished by Payee (Deduct Flat 20% under Section 206AA)
                    </label>
                </div>
            </div>
            <div class="highlight-box p-3 rounded" style="background:var(--bg-input, rgba(255,255,255,0.03)); border:1px solid var(--border);">
                <h6 class="fw-bold text-primary mb-1">📜 Due Dates & Compliance</h6>
                <p class="small text-muted mb-0">TDS deducted must be deposited to the government treasury by the <strong>7th of the following month</strong> (30th April for March deductions). Quarterly Form 16A TDS certificates must be issued to the payee within 15 days of filing quarterly TDS returns.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div id="resultsState">
                <div class="emi-result-display mb-3 p-3 text-center rounded-3" style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.2);">
                    <p class="label small text-muted text-uppercase fw-bold mb-1">Net Disbursed / Payable Amount</p>
                    <p class="amount display-6 fw-extrabold mb-0 text-success" id="tdsNetPay">₹1,47,000</p>
                </div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">Gross Invoice / Fee Amount</div><div class="value" id="rGross">₹1,50,000</div></div>
                    <div class="summary-item"><div class="label">Statutory TDS Rate</div><div class="value" style="color:var(--gold, #f59e0b);" id="rRateApplied">2.00%</div></div>
                    <div class="summary-item"><div class="label">TDS Amount to Withhold (Challan ITNS 281)</div><div class="value text-danger fw-bold" id="rTdsAmount">₹3,000</div></div>
                    <div class="summary-item border-top pt-2"><div class="label fw-bold">Net Payout to Beneficiary</div><div class="value text-success fw-bold" id="rNet">₹1,47,000</div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- AEO Quick Definition Box -->
    <div class="card p-4 rounded-4 my-4 border" style="background: var(--bg-card, #0f172a);">
        <h2 class="h4 fw-bold mb-3" style="color: var(--heading-color, #f8fafc);">What is Tax Deducted at Source (TDS)?</h2>
        <p class="lead mb-3 text-secondary" style="font-size: 1.02rem; line-height: 1.7;">
            <strong>Tax Deducted at Source (TDS)</strong> is an indirect mechanism introduced by the Central Board of Direct Taxes (CBDT) under the Indian Income Tax Act to collect tax right at the origin of income. Any person, firm, or company making specified payments (such as professional fees, contractor charges, rent, commission, or bank interest) is statutorily required to deduct a predetermined percentage of tax and remit it to the central government.
        </p>
        <p class="text-muted small mb-0">
            The deducted amount reflects in the payee’s <strong>Form 26AS and Annual Information Statement (AIS)</strong>, allowing them to claim it as a credit against their final tax liability when filing their annual Income Tax Return (ITR).
        </p>
    </div>

    <!-- TDS Rate & Threshold Limits Table for FY 2026-27 -->
    <div class="card p-4 rounded-4 my-4 border" style="background: var(--bg-card, #0f172a);">
        <h3 class="h5 fw-bold mb-3" style="color: var(--heading-color, #f8fafc);">📊 TDS Rates & Annual Threshold Exemption Limits (FY 2026-27)</h3>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th class="text-start">Section</th>
                        <th class="text-start">Nature of Payment</th>
                        <th>Standard Rate</th>
                        <th>Annual Exemption Threshold</th>
                    </tr>
                </thead>
                <tbody class="text-muted">
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194J</td>
                        <td class="text-start">Professional Fees (Doctor, Lawyer, CA, Architect)</td>
                        <td>10%</td>
                        <td>₹30,000 per financial year</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194J</td>
                        <td class="text-start">Technical Services / Royalty / Call Centre Ops</td>
                        <td>2%</td>
                        <td>₹30,000 per financial year</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194C</td>
                        <td class="text-start">Contractor / Sub-contractor (Individual/HUF)</td>
                        <td>1%</td>
                        <td>₹30,000 single bill / ₹1,00,000 aggregate</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194C</td>
                        <td class="text-start">Contractor / Sub-contractor (Company/Firm)</td>
                        <td>2%</td>
                        <td>₹30,000 single bill / ₹1,00,000 aggregate</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194I</td>
                        <td class="text-start">Rent on Land, Building, or Furniture</td>
                        <td>10%</td>
                        <td>₹2,40,000 per financial year</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194I</td>
                        <td class="text-start">Rent on Plant, Machinery, or Equipment</td>
                        <td>2%</td>
                        <td>₹2,40,000 per financial year</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194A</td>
                        <td class="text-start">Bank Interest / Fixed Deposit (Individual)</td>
                        <td>10%</td>
                        <td>₹40,000 (₹50,000 for Senior Citizens)</td>
                    </tr>
                    <tr>
                        <td class="text-start fw-semibold text-body-emphasis">194H</td>
                        <td class="text-start">Commission or Brokerage</td>
                        <td>5%</td>
                        <td>₹15,000 per financial year</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- FAQs Section -->
    <h3 class="h4 fw-bold mt-5 mb-3" style="color: var(--heading-color, #f8fafc);">❓ Frequently Asked Questions (TDS FAQs)</h3>
    <div class="accordion" id="tdsFaqAccordion">
        <div class="accordion-item">
            <h4 class="accordion-header" id="tdsH1">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#tdsC1" aria-expanded="true">
                    What happens if the payee does not furnish a PAN card?
                </button>
            </h4>
            <div id="tdsC1" class="accordion-collapse collapse show" data-bs-parent="#tdsFaqAccordion">
                <div class="accordion-body text-muted">
                    Under Section 206AA of the Income Tax Act, if the recipient/payee fails to furnish a valid Permanent Account Number (PAN), the deductor must deduct TDS at the higher of the following rates: (1) The rate specified in the relevant Act provision, or (2) At a flat penal rate of <strong>20%</strong>.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h4 class="accordion-header" id="tdsH2">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tdsC2">
                    How do I claim a refund for excess TDS deducted?
                </button>
            </h4>
            <div id="tdsC2" class="accordion-collapse collapse" data-bs-parent="#tdsFaqAccordion">
                <div class="accordion-body text-muted">
                    If your total annual tax liability computed in your ITR is less than the cumulative TDS deducted during the financial year, the excess amount is automatically refunded directly to your validated bank account with interest under Section 244A after filing your Income Tax Return.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h4 class="accordion-header" id="tdsH3">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tdsC3">
                    Is GST included when calculating TDS on professional bills?
                </button>
            </h4>
            <div id="tdsC3" class="accordion-collapse collapse" data-bs-parent="#tdsFaqAccordion">
                <div class="accordion-body text-muted">
                    As per CBDT Circular No. 23/2017, wherever in terms of the agreement or contract between the deductor and the deductee, the GST component (CGST/SGST/IGST) is indicated separately on the invoice, <strong>TDS shall be deducted exclusively on the value of goods/services excluding the GST component</strong>.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h4 class="accordion-header" id="tdsH4">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tdsC4">
                    What is the penalty for late deposit of TDS?
                </button>
            </h4>
            <div id="tdsC4" class="accordion-collapse collapse" data-bs-parent="#tdsFaqAccordion">
                <div class="accordion-body text-muted">
                    If TDS is deducted but not deposited by the 7th of the following month, mandatory interest of <strong>1.5% per month (or part of a month)</strong> is levied under Section 201(1A) from the date of deduction to the actual date of payment.
                </div>
            </div>
        </div>
    </div>

    <!-- Embedded FAQPage JSON-LD -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "What happens if the payee does not furnish a PAN card?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Under Section 206AA, failure to furnish a valid PAN requires mandatory TDS deduction at a flat penal rate of 20%."
                }
            },
            {
                "@type": "Question",
                "name": "How do I claim a refund for excess TDS deducted?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Any excess TDS deducted beyond your total annual tax liability is automatically refunded with interest upon filing your annual Income Tax Return."
                }
            },
            {
                "@type": "Question",
                "name": "Is GST included when calculating TDS on professional bills?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "No. Under CBDT Circular 23/2017, if GST is shown separately on the invoice, TDS is deducted only on the base value excluding GST."
                }
            },
            {
                "@type": "Question",
                "name": "What is the penalty for late deposit of TDS?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Late deposit of deducted TDS attracts mandatory penal interest of 1.5% per month or part of a month under Section 201(1A)."
                }
            }
        ]
    }
    </script>

    <div class="related-section mt-5"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/freelance-tax-calculator" class="related-card"><span class="icon">💻</span><div class="title">Freelance Tax</div><div class="desc">Section 44ADA savings</div></a></div>
            <div class="col-md-4"><a href="/gst-calculator" class="related-card"><span class="icon">🏷️</span><div class="title">GST Calculator</div><div class="desc">Invoice tax calculation</div></a></div>
            <div class="col-md-4"><a href="/income-tax-calculator" class="related-card"><span class="icon">🧾</span><div class="title">Income Tax</div><div class="desc">Claim TDS credit in ITR</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>
<!-- Toolbar -->
<div class="action-toolbar" id="tdsToolbar">
    <span class="toolbar-label">Tools:</span>
    <button type="button" class="btn-action-tool" id="tdsBtnSave">💾 Save Calculation</button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="tdsBtnShare">💬 Share on WhatsApp</button>
    <button type="button" class="btn-action-tool" id="tdsBtnCopy">🔗 Copy Link</button>
</div>
<script>
const fmt = n => new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function calculate() {
    const gross = parseFloat(document.getElementById('tdsGross').value)||0;
    const sec = document.getElementById('tdsSection').value;
    const noPan = document.getElementById('tdsNoPan').checked;

    if(typeof attachNumberToWords === 'function') {
        const el = document.getElementById('tdsWords');
        if(el) el.textContent = convertNumberToIndianWords(gross);
    }

    if(gross <= 0) return;

    let rate = 0.02; // default
    if(noPan) {
        rate = 0.20; // 20% under 206AA
    } else {
        if(sec === '194J_tech') rate = 0.02;
        else if(sec === '194J_prof') rate = 0.10;
        else if(sec === '194C_ind') rate = 0.01;
        else if(sec === '194C_corp') rate = 0.02;
        else if(sec === '194I_rent') rate = 0.10;
        else if(sec === '194I_plant') rate = 0.02;
        else if(sec === '194H_comm') rate = 0.05;
        else if(sec === '194A_int') rate = 0.10;
    }

    const tdsAmount = gross * rate;
    const netPay = gross - tdsAmount;

    document.getElementById('tdsNetPay').textContent = fmt(netPay);
    document.getElementById('rGross').textContent = fmt(gross);
    document.getElementById('rRateApplied').textContent = (rate * 100).toFixed(1) + '%' + (noPan ? ' (No PAN)' : '');
    document.getElementById('rTdsAmount').textContent = fmt(tdsAmount);
    document.getElementById('rNet').textContent = fmt(netPay);

    window._lastTDS = { gross, rate: rate*100, tdsAmount, netPay, sec };
}
document.addEventListener('DOMContentLoaded', () => {
    calculate();
    document.getElementById('tdsBtnSave').addEventListener('click', () => {
        const d = window._lastTDS; if(!d) return;
        const name = prompt('Save as:', `TDS ${fmt(d.tdsAmount)}`);
        if(name) saveCalculation(name, { Gross: fmt(d.gross), TDS: fmt(d.tdsAmount), NetPayable: fmt(d.netPay) });
    });
    document.getElementById('tdsBtnShare').addEventListener('click', () => {
        const d = window._lastTDS; if(!d) return;
        shareViaWhatsApp('TDS Calculator', `Gross Invoice: ${fmt(d.gross)}\nTDS Rate: ${d.rate}%\nTDS Deducted: ${fmt(d.tdsAmount)}\nNet Disbursed: ${fmt(d.netPay)}`);
    });
    document.getElementById('tdsBtnCopy').addEventListener('click', copyShareableURL);
});
</script>

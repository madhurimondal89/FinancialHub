<%- include('partials/header') %>
<div class="form-card">
    <h3 class="mb-1">🏅 Gratuity Calculator</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">Calculate your gratuity amount as per the Payment of Gratuity Act, 1972</p>
<%- include('partials/ad_unit') %>
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="mb-4">
                <label class="form-label">Last Drawn Basic Salary + DA (Monthly)</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="salary" placeholder="e.g., 50000" oninput="calculate()"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Years of Service</label>
                <div class="input-group"><input type="number" class="form-control" id="years" placeholder="e.g., 10" step="0.5" oninput="calculate()"><span class="input-group-text" style="border-radius:0 var(--radius-sm) var(--radius-sm) 0;">Years</span></div>
                <small style="color:var(--text-muted);font-size:0.78rem;">Minimum 5 years required to be eligible</small>
            </div>
            <div class="mb-4">
                <label class="form-label">Employment Type</label>
                <select class="form-select" id="empType" onchange="calculate()">
                    <option value="covered">Covered under Gratuity Act (Organization ≥ 10 employees)</option>
                    <option value="notcovered">Not covered under Gratuity Act</option>
                </select>
            </div>
            <div class="highlight-box">
                <h4>📌 Gratuity Formula</h4>
                <p><strong>Covered:</strong> (Salary × 15 × Years) ÷ 26<br>
                <strong>Not Covered:</strong> (Salary × 15 × Years) ÷ 30<br>
                Max gratuity tax-free: <strong>₹20 Lakhs</strong></p>
            </div>
        </div>
        <div class="col-lg-6">
            <div id="initialState" class="d-flex align-items-center justify-content-center text-center p-5" style="background:rgba(15,23,42,0.4);border:1px solid var(--border);border-radius:14px;min-height:300px;">
                <div><div style="font-size:3rem;">🏅</div><p style="color:var(--text-muted);margin-top:12px;">Enter salary and service details to calculate gratuity</p></div>
            </div>
            <div id="resultsState" style="display:none;">
                <div class="emi-result-display"><p class="label">Gratuity Amount</p><p class="amount" id="gratuityAmt">₹0</p></div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">Monthly Salary (Basic+DA)</div><div class="value" id="r1">₹0</div></div>
                    <div class="summary-item"><div class="label">Years of Service</div><div class="value" id="r2">0</div></div>
                    <div class="summary-item"><div class="label">Calculation Formula</div><div class="value" style="font-size:0.85rem;" id="r3">—</div></div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item"><div class="label">Gratuity (Calculated)</div><div class="value" style="color:var(--gold);font-weight:800;font-size:1.2rem;" id="r4">₹0</div></div>
                    <div class="summary-item"><div class="label">Tax-Free Limit</div><div class="value" style="color:var(--accent);" id="r5">₹20,00,000</div></div>
                    <div class="summary-item"><div class="label">Taxable Gratuity</div><div class="value" style="color:var(--accent-red);" id="r6">₹0</div></div>
                    <div id="ineligible" style="display:none;padding:12px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;color:#fca5a5;font-size:0.9rem;text-align:center;margin-top:12px;">⚠️ Minimum 5 years of service required for gratuity</div>
                </div>
            </div>
        </div>
    </div>
    <div class="related-section"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/retirement-calculator" class="related-card"><span class="icon">🌅</span><div class="title">Retirement Planning</div><div class="desc">Plan post-retirement</div></a></div>
            <div class="col-md-4"><a href="/income-tax-calculator" class="related-card"><span class="icon">📋</span><div class="title">Income Tax</div><div class="desc">Tax on gratuity</div></a></div>
            <div class="col-md-4"><a href="/nps-calculator" class="related-card"><span class="icon">🏛️</span><div class="title">NPS Calculator</div><div class="desc">Pension corpus planning</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>
<script>
const fmt=n=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function calculate(){
    const sal=parseFloat(document.getElementById('salary').value)||0;
    const yrs=parseFloat(document.getElementById('years').value)||0;
    const covered=document.getElementById('empType').value==='covered';
    if(!sal||!yrs){document.getElementById('initialState').style.display='flex';document.getElementById('resultsState').style.display='none';return;}
    document.getElementById('initialState').style.display='none';
    document.getElementById('resultsState').style.display='block';
    const roundedYrs=Math.floor(yrs);
    const div=covered?26:30;
    const gratuity=(sal*15*roundedYrs)/div;
    const taxFreeLimit=2000000;
    const taxable=Math.max(0,gratuity-taxFreeLimit);
    document.getElementById('gratuityAmt').textContent=fmt(gratuity);
    document.getElementById('r1').textContent=fmt(sal);
    document.getElementById('r2').textContent=yrs+' Years';
    document.getElementById('r3').textContent='('+fmt(sal)+' × 15 × '+roundedYrs+') ÷ '+div;
    document.getElementById('r4').textContent=fmt(gratuity);
    document.getElementById('r6').textContent=fmt(taxable);
    document.getElementById('ineligible').style.display=yrs<5?'block':'none';
}
</script>
<%- include('partials/footer') %>

<%- include('partials/header') %>

<div class="form-card">
    <h3 class="mb-1">💰 Income Tax Calculator</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">FY 2024-25 (AY 2025-26) — Old Regime vs New Regime Comparison</p>
<%- include('partials/ad_unit') %>

    <div class="row g-5">
        <!-- Left: Inputs -->
        <div class="col-lg-6">
            <div class="mb-4">
                <label class="form-label">Annual Gross Income</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="grossIncome" placeholder="e.g., 1200000" min="0">
                </div>
            </div>

            <hr style="border-color:var(--border);">
            <p style="font-size:0.82rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">Old Regime Deductions</p>

            <div class="mb-3">
                <label class="form-label">80C Deductions (max ₹1,50,000)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deduction80c" placeholder="PPF, ELSS, LIC, etc." min="0" max="150000">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">80D Health Insurance (max ₹25,000)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deduction80d" placeholder="Medical insurance premium" min="0" max="25000">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">HRA Exemption</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deductionHRA" placeholder="House Rent Allowance" min="0">
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label">Other Deductions (80E, 80G, etc.)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deductionOther" placeholder="Loan interest, donations, etc." min="0">
                </div>
            </div>

            <button class="btn-calculate" onclick="calculateTax()" id="calcBtn">Compare Tax Regimes →</button>
        </div>

        <!-- Right: Results -->
        <div class="col-lg-6">
            <div id="initialState" class="d-flex align-items-center justify-content-center text-center p-4" style="background:rgba(15,23,42,0.5); border:1px solid var(--border); border-radius:14px; min-height:300px;">
                <div>
                    <div style="font-size:3rem;">⚖️</div>
                    <p style="color:var(--text-muted); margin-top:12px;">Enter your income details to compare Old vs New Tax Regime</p>
                </div>
            </div>

            <div id="resultsState" style="display:none;">
                <!-- Recommendation Banner -->
                <div id="recommendationBanner" class="mb-3 p-3 text-center" style="border-radius:12px; font-weight:700; font-size:1rem;"></div>

                <!-- Comparison Table -->
                <div class="emi-summary-card">
                    <div class="summary-item">
                        <div class="label">Metric</div>
                        <div style="display:flex; gap:20px; font-size:0.8rem; font-weight:700;">
                            <span style="color:var(--gold); min-width:80px; text-align:right;">Old Regime</span>
                            <span style="color:#38bdf8; min-width:80px; text-align:right;">New Regime</span>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item">
                        <div class="label">Gross Income</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldGross" style="min-width:80px; text-align:right;"></span>
                            <span id="newGross" style="min-width:80px; text-align:right;"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Total Deductions</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldDeductions" style="min-width:80px; text-align:right; color:var(--accent);"></span>
                            <span id="newDeductions" style="min-width:80px; text-align:right; color:var(--accent);"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Taxable Income</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem; font-weight:600;">
                            <span id="oldTaxable" style="min-width:80px; text-align:right;"></span>
                            <span id="newTaxable" style="min-width:80px; text-align:right;"></span>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item">
                        <div class="label">Tax Before Cess</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldBaseTax" style="min-width:80px; text-align:right;"></span>
                            <span id="newBaseTax" style="min-width:80px; text-align:right;"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Health & Ed. Cess (4%)</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldCess" style="min-width:80px; text-align:right;"></span>
                            <span id="newCess" style="min-width:80px; text-align:right;"></span>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item" style="font-size:1.1rem;">
                        <div class="label" style="font-weight:700; color:var(--text-primary);">Total Tax Payable</div>
                        <div style="display:flex; gap:20px;">
                            <span id="oldTotal" style="min-width:80px; text-align:right; font-weight:800; color:var(--gold);"></span>
                            <span id="newTotal" style="min-width:80px; text-align:right; font-weight:800; color:#38bdf8;"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Effective Tax Rate</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldRate" style="min-width:80px; text-align:right;"></span>
                            <span id="newRate" style="min-width:80px; text-align:right;"></span>
                        </div>
                    </div>
                    <div class="summary-item" style="font-size:1rem;">
                        <div class="label">Monthly Take-Home</div>
                        <div style="display:flex; gap:20px; font-weight:700;">
                            <span id="oldMonthly" style="min-width:80px; text-align:right; color:var(--accent);"></span>
                            <span id="newMonthly" style="min-width:80px; text-align:right; color:var(--accent);"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Accordion -->
    <div class="info-accordion">
        <div class="accordion" id="taxAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#taxC1">New Regime Tax Slabs (FY 2024-25)</button></h2>
                <div id="taxC1" class="accordion-collapse collapse show" data-bs-parent="#taxAccordion">
                    <div class="accordion-body">
                        <table class="table table-sm" style="color:var(--text-secondary);">
                            <thead><tr><th>Income Range</th><th>Tax Rate</th></tr></thead>
                            <tbody>
                                <tr><td>Up to ₹3,00,000</td><td>Nil</td></tr>
                                <tr><td>₹3,00,001 – ₹7,00,000</td><td>5%</td></tr>
                                <tr><td>₹7,00,001 – ₹10,00,000</td><td>10%</td></tr>
                                <tr><td>₹10,00,001 – ₹12,00,000</td><td>15%</td></tr>
                                <tr><td>₹12,00,001 – ₹15,00,000</td><td>20%</td></tr>
                                <tr><td>Above ₹15,00,000</td><td>30%</td></tr>
                            </tbody>
                        </table>
                        <p style="font-size:0.85rem; color:var(--text-muted);">✅ Standard Deduction of ₹75,000 is available in New Regime. Income up to ₹7 lakh is effectively tax-free due to Section 87A rebate.</p>
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#taxC2">Old Regime Tax Slabs (FY 2024-25)</button></h2>
                <div id="taxC2" class="accordion-collapse collapse" data-bs-parent="#taxAccordion">
                    <div class="accordion-body">
                        <table class="table table-sm" style="color:var(--text-secondary);">
                            <thead><tr><th>Income Range</th><th>Tax Rate</th></tr></thead>
                            <tbody>
                                <tr><td>Up to ₹2,50,000</td><td>Nil</td></tr>
                                <tr><td>₹2,50,001 – ₹5,00,000</td><td>5%</td></tr>
                                <tr><td>₹5,00,001 – ₹10,00,000</td><td>20%</td></tr>
                                <tr><td>Above ₹10,00,000</td><td>30%</td></tr>
                            </tbody>
                        </table>
                        <p style="font-size:0.85rem; color:var(--text-muted);">🧾 Old Regime allows deductions: Standard Deduction ₹50,000, 80C up to ₹1.5L, 80D up to ₹25,000, HRA, 80E, 80G and more. Income up to ₹5 lakh is effectively tax-free due to Section 87A rebate.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Calculators -->
    <div class="related-section">
        <h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/hra-calculator" class="related-card"><span class="icon">🏢</span><div class="title">HRA Calculator</div><div class="desc">Calculate your HRA exemption</div></a></div>
            <div class="col-md-4"><a href="/budget-calculator" class="related-card"><span class="icon">📅</span><div class="title">Budget Planner</div><div class="desc">Plan your post-tax budget</div></a></div>
            <div class="col-md-4"><a href="/sip-calculator" class="related-card"><span class="icon">📊</span><div class="title">SIP Calculator</div><div class="desc">Invest your tax savings</div></a></div>
        </div>
    </div>

<%- include('partials/ad_unit') %>
</div>

<script>
const fmt = (n) => new Intl.NumberFormat('en-IN', { style:'currency', currency:'INR', maximumFractionDigits:0 }).format(n);
const pct = (n) => n.toFixed(2) + '%';

function calcOldRegimeTax(taxable) {
    let tax = 0;
    if (taxable <= 250000) return 0;
    if (taxable <= 500000) tax = (taxable - 250000) * 0.05;
    else if (taxable <= 1000000) tax = 12500 + (taxable - 500000) * 0.20;
    else tax = 112500 + (taxable - 1000000) * 0.30;
    // 87A rebate: if taxable <= 5L, tax = 0
    if (taxable <= 500000) tax = 0;
    return tax;
}

function calcNewRegimeTax(taxable) {
    let tax = 0;
    if (taxable <= 300000) return 0;
    if (taxable <= 700000) tax = (taxable - 300000) * 0.05;
    else if (taxable <= 1000000) tax = 20000 + (taxable - 700000) * 0.10;
    else if (taxable <= 1200000) tax = 50000 + (taxable - 1000000) * 0.15;
    else if (taxable <= 1500000) tax = 80000 + (taxable - 1200000) * 0.20;
    else tax = 140000 + (taxable - 1500000) * 0.30;
    // 87A rebate: if taxable <= 7L, tax = 0
    if (taxable <= 700000) tax = 0;
    return tax;
}

function calculateTax() {
    const gross = parseFloat(document.getElementById('grossIncome').value) || 0;
    if (gross <= 0) return;

    // Old Regime
    const std50k = 50000;
    const d80c  = Math.min(parseFloat(document.getElementById('deduction80c').value)  || 0, 150000);
    const d80d  = Math.min(parseFloat(document.getElementById('deduction80d').value)  || 0, 25000);
    const dHRA  = parseFloat(document.getElementById('deductionHRA').value)  || 0;
    const dOth  = parseFloat(document.getElementById('deductionOther').value) || 0;
    const oldTotalDed = std50k + d80c + d80d + dHRA + dOth;
    const oldTaxable  = Math.max(0, gross - oldTotalDed);
    const oldBase     = calcOldRegimeTax(oldTaxable);
    const oldCess     = oldBase * 0.04;
    const oldTotal    = oldBase + oldCess;

    // New Regime
    const newStd      = 75000;
    const newTaxable  = Math.max(0, gross - newStd);
    const newBase     = calcNewRegimeTax(newTaxable);
    const newCess     = newBase * 0.04;
    const newTotal    = newBase + newCess;

    // Show results
    document.getElementById('initialState').style.display = 'none';
    document.getElementById('resultsState').style.display = 'block';

    document.getElementById('oldGross').textContent   = fmt(gross);
    document.getElementById('newGross').textContent   = fmt(gross);
    document.getElementById('oldDeductions').textContent = '- ' + fmt(oldTotalDed);
    document.getElementById('newDeductions').textContent = '- ' + fmt(newStd);
    document.getElementById('oldTaxable').textContent = fmt(oldTaxable);
    document.getElementById('newTaxable').textContent = fmt(newTaxable);
    document.getElementById('oldBaseTax').textContent = fmt(oldBase);
    document.getElementById('newBaseTax').textContent = fmt(newBase);
    document.getElementById('oldCess').textContent    = fmt(oldCess);
    document.getElementById('newCess').textContent    = fmt(newCess);
    document.getElementById('oldTotal').textContent   = fmt(oldTotal);
    document.getElementById('newTotal').textContent   = fmt(newTotal);
    document.getElementById('oldRate').textContent    = pct((oldTotal/gross)*100);
    document.getElementById('newRate').textContent    = pct((newTotal/gross)*100);
    document.getElementById('oldMonthly').textContent = fmt((gross - oldTotal)/12);
    document.getElementById('newMonthly').textContent = fmt((gross - newTotal)/12);

    // Recommendation
    const banner = document.getElementById('recommendationBanner');
    const saving = Math.abs(oldTotal - newTotal);
    if (oldTotal < newTotal) {
        banner.style.background = 'linear-gradient(135deg, rgba(245,158,11,0.15), rgba(245,158,11,0.05))';
        banner.style.border = '1px solid rgba(245,158,11,0.3)';
        banner.style.color = '#fcd34d';
        banner.innerHTML = `✅ <strong>Old Regime</strong> saves you <strong>${fmt(saving)}/year</strong>`;
    } else if (newTotal < oldTotal) {
        banner.style.background = 'linear-gradient(135deg, rgba(56,189,248,0.15), rgba(56,189,248,0.05))';
        banner.style.border = '1px solid rgba(56,189,248,0.3)';
        banner.style.color = '#7dd3fc';
        banner.innerHTML = `✅ <strong>New Regime</strong> saves you <strong>${fmt(saving)}/year</strong>`;
    } else {
        banner.style.background = 'rgba(100,116,139,0.15)';
        banner.style.border = '1px solid var(--border)';
        banner.style.color = 'var(--text-secondary)';
        banner.innerHTML = `⚖️ Both regimes result in the <strong>same tax</strong>`;
    }
}

// Allow Enter key
document.addEventListener('keydown', (e) => { if(e.key === 'Enter') calculateTax(); });
</script>

<%- include('partials/footer') %>

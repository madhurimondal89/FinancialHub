<%- include('partials/header') %>

<div class="page-title-section fade-in-up">
    <h1>Income Tax Calculator (FY 2024-25 / AY 2025-26)</h1>
    <p>Compare New Tax Regime vs Old Tax Regime with standard deductions, 80C, 80D, HRA exemptions, and export a detailed tax comparison report.</p>
</div>

<div class="form-card fade-in-up">
    <%- include('partials/ad_unit') %>

    <div class="row g-5">
        <!-- Left: Inputs -->
        <div class="col-lg-6">
            <div class="mb-4">
                <label for="grossIncome" class="form-label fw-bold">Annual Gross Income</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="grossIncome" placeholder="e.g., 12,00,000" min="0">
                </div>
                <div id="grossWords" class="number-words-preview"></div>
                <div id="incomePresets"></div>
            </div>

            <hr style="border-color:var(--border);">
            <p style="font-size:0.82rem; color:var(--gold); font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:16px;">
                Old Regime Deductions & Exemptions
            </p>

            <div class="mb-3">
                <label for="deduction80c" class="form-label">80C Deductions (PPF, ELSS, EPF, LIC - Max ₹1.5L)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deduction80c" placeholder="e.g., 150000" min="0" max="150000">
                </div>
                <div id="ded80cWords" class="number-words-preview"></div>
            </div>

            <div class="mb-3">
                <label for="deduction80d" class="form-label">80D Health Insurance (Self & Parents - Max ₹25K/₹50K)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deduction80d" placeholder="e.g., 25000" min="0">
                </div>
            </div>

            <div class="mb-3">
                <label for="deductionHRA" class="form-label">HRA Exemption Amount</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deductionHRA" placeholder="e.g., 120000" min="0">
                </div>
            </div>

            <div class="mb-4">
                <label for="deductionOther" class="form-label">Other Deductions (Home Loan Int. Sec 24, 80E, 80CCD)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="deductionOther" placeholder="e.g., 50000" min="0">
                </div>
            </div>

            <button class="btn btn-custom w-100 py-2 fw-bold" onclick="calculateTax()" id="calcBtn">
                Compare Tax Regimes →
            </button>
        </div>

        <!-- Right: Results -->
        <div class="col-lg-6">
            <div id="initialState" class="d-flex align-items-center justify-content-center text-center p-4" style="background:var(--bg-input); border:1px solid var(--border); border-radius:14px; min-height:320px;">
                <div>
                    <div style="font-size:3rem;">⚖️</div>
                    <h5 class="mt-2 text-gold-custom">Old vs New Tax Regime</h5>
                    <p style="color:var(--text-muted); font-size:0.9rem;">Enter your annual CTC/income to see which regime saves you more tax.</p>
                </div>
            </div>

            <div id="resultsState" style="display:none;">
                <!-- Recommendation Banner -->
                <div id="recommendationBanner" class="mb-3 p-3 text-center" style="border-radius:12px; font-weight:700; font-size:1rem;"></div>

                <!-- Comparison Table -->
                <div class="emi-summary-card">
                    <div class="summary-item">
                        <div class="label fw-bold">Metric</div>
                        <div style="display:flex; gap:20px; font-size:0.85rem; font-weight:700;">
                            <span style="color:var(--gold); min-width:85px; text-align:right;">Old Regime</span>
                            <span style="color:#38bdf8; min-width:85px; text-align:right;">New Regime</span>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item">
                        <div class="label">Gross Income</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldGross" style="min-width:85px; text-align:right;"></span>
                            <span id="newGross" style="min-width:85px; text-align:right;"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Total Deductions</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldDeductions" style="min-width:85px; text-align:right; color:var(--accent);"></span>
                            <span id="newDeductions" style="min-width:85px; text-align:right; color:var(--accent);"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Taxable Income</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem; font-weight:600;">
                            <span id="oldTaxable" style="min-width:85px; text-align:right;"></span>
                            <span id="newTaxable" style="min-width:85px; text-align:right;"></span>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item">
                        <div class="label">Tax Before Cess</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldBaseTax" style="min-width:85px; text-align:right;"></span>
                            <span id="newBaseTax" style="min-width:85px; text-align:right;"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Health & Ed. Cess (4%)</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldCess" style="min-width:85px; text-align:right;"></span>
                            <span id="newCess" style="min-width:85px; text-align:right;"></span>
                        </div>
                    </div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item" style="font-size:1.1rem;">
                        <div class="label" style="font-weight:700; color:var(--text-primary);">Total Tax Payable</div>
                        <div style="display:flex; gap:20px;">
                            <span id="oldTotal" style="min-width:85px; text-align:right; font-weight:800; color:var(--gold);"></span>
                            <span id="newTotal" style="min-width:85px; text-align:right; font-weight:800; color:#38bdf8;"></span>
                        </div>
                    </div>
                    <div class="summary-item">
                        <div class="label">Effective Tax Rate</div>
                        <div style="display:flex; gap:20px; font-size:0.88rem;">
                            <span id="oldRate" style="min-width:85px; text-align:right;"></span>
                            <span id="newRate" style="min-width:85px; text-align:right;"></span>
                        </div>
                    </div>
                    <div class="summary-item" style="font-size:1rem;">
                        <div class="label fw-bold">Monthly Take-Home</div>
                        <div style="display:flex; gap:20px; font-weight:700;">
                            <span id="oldMonthly" style="min-width:85px; text-align:right; color:var(--accent);"></span>
                            <span id="newMonthly" style="min-width:85px; text-align:right; color:var(--accent);"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="action-toolbar" id="taxActionToolbar" style="display: none;">
        <span class="toolbar-label">Tools & Export:</span>
        <button type="button" class="btn-action-tool" id="btnExportPDF">
            <span>📄</span> Download Tax Comparison PDF
        </button>
        <button type="button" class="btn-action-tool btn-whatsapp" id="btnShareWA">
            <span>💬</span> Share on WhatsApp
        </button>
        <button type="button" class="btn-action-tool" id="btnCopyLink">
            <span>🔗</span> Copy Link
        </button>
        <button type="button" class="btn-action-tool" id="btnSaveCalc">
            <span>💾</span> Save Tax Calculation
        </button>
    </div>

    <!-- Related Calculators Section -->
    <div class="related-calculators-section">
        <h5 class="related-calc-title">💡 Related Tax & Savings Calculators</h5>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <a href="/hra-calculator" class="related-mini-card">
                    <span class="icon">🏢</span>
                    <div>
                        <div class="title">HRA Calculator</div>
                        <div class="desc">Rent Exemption</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/ppf-calculator" class="related-mini-card">
                    <span class="icon">🏛️</span>
                    <div>
                        <div class="title">PPF Calculator</div>
                        <div class="desc">Sec 80C Tax-Free</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/nps-calculator" class="related-mini-card">
                    <span class="icon">🛡️</span>
                    <div>
                        <div class="title">NPS Calculator</div>
                        <div class="desc">Sec 80CCD Extra ₹50K</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/gst-calculator" class="related-mini-card">
                    <span class="icon">🏷️</span>
                    <div>
                        <div class="title">GST Calculator</div>
                        <div class="desc">Business Invoicing</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Tax Slabs Guide Accordion -->
    <div class="info-accordion mt-5">
        <div class="accordion" id="taxAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#taxC1">New Regime Tax Slabs (FY 2024-25)</button></h2>
                <div id="taxC1" class="accordion-collapse collapse show" data-bs-parent="#taxAccordion">
                    <div class="accordion-body">
                        <table class="table table-sm" style="color:var(--text-secondary);">
                            <thead><tr><th>Income Range</th><th>Tax Rate</th></tr></thead>
                            <tbody>
                                <tr><td>Up to ₹3,00,000</td><td>Nil</td></tr>
                                <tr><td>₹3,00,001 – ₹7,00,000</td><td>5%</td></tr>
                                <tr><td>₹7,00,001 – ₹10,00,000</td><td>10%</td></tr>
                                <tr><td>₹10,00,001 – ₹12,00,000</td><td>15%</td></tr>
                                <tr><td>₹12,00,001 – ₹15,00,000</td><td>20%</td></tr>
                                <tr><td>Above ₹15,00,000</td><td>30%</td></tr>
                            </tbody>
                        </table>
                        <p style="font-size:0.85rem; color:var(--text-muted);">✅ Standard Deduction of ₹75,000 is available in New Regime. Income up to ₹7.75 lakh (including standard deduction) is effectively tax-free due to Section 87A rebate.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('partials/ad_unit') %>
</div>

<script>
    const fmt = (n) => new Intl.NumberFormat('en-IN', { style:'currency', currency:'INR', maximumFractionDigits:0 }).format(n);
    const pct = (n) => (isNaN(n) ? '0.00%' : n.toFixed(2) + '%');

    let lastTaxData = null;

    // Attach Number to Words
    attachNumberToWords('grossIncome', 'grossWords');
    attachNumberToWords('deduction80c', 'ded80cWords');

    // Preset Chips for Income
    createPresetChips('incomePresets', 'grossIncome', null, [
        { label: '₹7.5 Lakhs', value: 750000 },
        { label: '₹10 Lakhs', value: 1000000 },
        { label: '₹15 Lakhs', value: 1500000 },
        { label: '₹20 Lakhs', value: 2000000 },
        { label: '₹30 Lakhs', value: 3000000 },
        { label: '₹50 Lakhs', value: 5000000 }
    ], calculateTax);

    function calcOldRegimeTax(taxable) {
        let tax = 0;
        if (taxable <= 250000) return 0;
        if (taxable <= 500000) tax = (taxable - 250000) * 0.05;
        else if (taxable <= 1000000) tax = 12500 + (taxable - 500000) * 0.20;
        else tax = 112500 + (taxable - 1000000) * 0.30;
        if (taxable <= 500000) tax = 0;
        return tax;
    }

    function calcNewRegimeTax(taxable) {
        let tax = 0;
        if (taxable <= 300000) return 0;
        if (taxable <= 700000) tax = (taxable - 300000) * 0.05;
        else if (taxable <= 1000000) tax = 20000 + (taxable - 700000) * 0.10;
        else if (taxable <= 1200000) tax = 50000 + (taxable - 1000000) * 0.15;
        else if (taxable <= 1500000) tax = 80000 + (taxable - 1200000) * 0.20;
        else tax = 140000 + (taxable - 1500000) * 0.30;
        if (taxable <= 700000) tax = 0;
        return tax;
    }

    function calculateTax() {
        const gross = parseFloat(document.getElementById('grossIncome').value) || 0;
        const initial = document.getElementById('initialState');
        const results = document.getElementById('resultsState');
        const toolbar = document.getElementById('taxActionToolbar');

        if (gross <= 0) {
            initial.style.display = 'flex';
            results.style.display = 'none';
            if (toolbar) toolbar.style.display = 'none';
            return;
        }

        const std50k = 50000;
        const d80c  = Math.min(parseFloat(document.getElementById('deduction80c').value)  || 0, 150000);
        const d80d  = Math.min(parseFloat(document.getElementById('deduction80d').value)  || 0, 50000);
        const dHRA  = parseFloat(document.getElementById('deductionHRA').value)  || 0;
        const dOth  = parseFloat(document.getElementById('deductionOther').value) || 0;
        const oldTotalDed = std50k + d80c + d80d + dHRA + dOth;
        const oldTaxable  = Math.max(0, gross - oldTotalDed);
        const oldBase     = calcOldRegimeTax(oldTaxable);
        const oldCess     = oldBase * 0.04;
        const oldTotal    = oldBase + oldCess;

        const newStd      = 75000;
        const newTaxable  = Math.max(0, gross - newStd);
        const newBase     = calcNewRegimeTax(newTaxable);
        const newCess     = newBase * 0.04;
        const newTotal    = newBase + newCess;

        initial.style.display = 'none';
        results.style.display = 'block';
        if (toolbar) toolbar.style.display = 'flex';

        document.getElementById('oldGross').textContent   = fmt(gross);
        document.getElementById('newGross').textContent   = fmt(gross);
        document.getElementById('oldDeductions').textContent = '- ' + fmt(oldTotalDed);
        document.getElementById('newDeductions').textContent = '- ' + fmt(newStd);
        document.getElementById('oldTaxable').textContent = fmt(oldTaxable);
        document.getElementById('newTaxable').textContent = fmt(newTaxable);
        document.getElementById('oldBaseTax').textContent = fmt(oldBase);
        document.getElementById('newBaseTax').textContent = fmt(newBase);
        document.getElementById('oldCess').textContent    = fmt(oldCess);
        document.getElementById('newCess').textContent    = fmt(newCess);
        document.getElementById('oldTotal').textContent   = fmt(oldTotal);
        document.getElementById('newTotal').textContent   = fmt(newTotal);
        document.getElementById('oldRate').textContent    = pct((oldTotal/gross)*100);
        document.getElementById('newRate').textContent    = pct((newTotal/gross)*100);
        document.getElementById('oldMonthly').textContent = fmt((gross - oldTotal)/12);
        document.getElementById('newMonthly').textContent = fmt((gross - newTotal)/12);

        // Recommendation
        const banner = document.getElementById('recommendationBanner');
        const saving = Math.abs(oldTotal - newTotal);
        let bestRegime = '';

        if (oldTotal < newTotal) {
            banner.style.background = 'linear-gradient(135deg, rgba(245,158,11,0.15), rgba(245,158,11,0.05))';
            banner.style.border = '1px solid rgba(245,158,11,0.3)';
            banner.style.color = '#fcd34d';
            banner.innerHTML = `✅ <strong>Old Regime</strong> saves you <strong>${fmt(saving)}/year</strong>!`;
            bestRegime = `Old Regime (Saves ${fmt(saving)})`;
        } else if (newTotal < oldTotal) {
            banner.style.background = 'linear-gradient(135deg, rgba(56,189,248,0.15), rgba(56,189,248,0.05))';
            banner.style.border = '1px solid rgba(56,189,248,0.3)';
            banner.style.color = '#7dd3fc';
            banner.innerHTML = `✅ <strong>New Regime</strong> saves you <strong>${fmt(saving)}/year</strong>!`;
            bestRegime = `New Regime (Saves ${fmt(saving)})`;
        } else {
            banner.style.background = 'rgba(100,116,139,0.15)';
            banner.style.border = '1px solid var(--border)';
            banner.style.color = 'var(--text-secondary)';
            banner.innerHTML = `⚖️ Both regimes result in the <strong>same tax (${fmt(oldTotal)})</strong>`;
            bestRegime = `Both Equal (${fmt(oldTotal)})`;
        }

        // Sync URL
        syncParamsToURL({
            income: gross,
            d80c, d80d, hra: dHRA, oth: dOth
        });

        lastTaxData = {
            gross, oldTotalDed, oldTaxable, oldTotal,
            newStd, newTaxable, newTotal, saving, bestRegime,
            oldMonthly: (gross - oldTotal)/12,
            newMonthly: (gross - newTotal)/12
        };
    }

    // Load from URL
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = loadParamsFromURL();
        if (urlParams.income) document.getElementById('grossIncome').value = urlParams.income;
        if (urlParams.d80c) document.getElementById('deduction80c').value = urlParams.d80c;
        if (urlParams.d80d) document.getElementById('deduction80d').value = urlParams.d80d;
        if (urlParams.hra) document.getElementById('deductionHRA').value = urlParams.hra;
        if (urlParams.oth) document.getElementById('deductionOther').value = urlParams.oth;

        if (urlParams.income) calculateTax();

        // Live input triggers
        ['grossIncome', 'deduction80c', 'deduction80d', 'deductionHRA', 'deductionOther'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.addEventListener('input', calculateTax);
        });

        // Toolbar
        document.getElementById('btnExportPDF').addEventListener('click', () => {
            if (!lastTaxData) return;
            exportCalculatorPDF({
                docTitle: `Income Tax Report FY 2024-25 (Gross: ${fmt(lastTaxData.gross)})`,
                summaryData: [
                    { label: 'Annual Gross Income', value: fmt(lastTaxData.gross) },
                    { label: 'Old Regime Tax', value: fmt(lastTaxData.oldTotal) },
                    { label: 'New Regime Tax', value: fmt(lastTaxData.newTotal) },
                    { label: 'Best Choice', value: lastTaxData.bestRegime, highlight: true }
                ],
                tableHeaders: ['Tax Metric', 'Old Regime', 'New Regime'],
                tableRows: [
                    ['Gross Income', fmt(lastTaxData.gross), fmt(lastTaxData.gross)],
                    ['Total Deductions', fmt(lastTaxData.oldTotalDed), fmt(lastTaxData.newStd)],
                    ['Net Taxable Income', fmt(lastTaxData.oldTaxable), fmt(lastTaxData.newTaxable)],
                    ['Total Tax Payable (Inc. Cess)', fmt(lastTaxData.oldTotal), fmt(lastTaxData.newTotal)],
                    ['Monthly Take-Home Salary', fmt(lastTaxData.oldMonthly), fmt(lastTaxData.newMonthly)]
                ],
                filename: 'income_tax_report_fy24_25'
            });
        });

        document.getElementById('btnShareWA').addEventListener('click', () => {
            if (!lastTaxData) return;
            const summary = `💼 *Gross Income:* ${fmt(lastTaxData.gross)}\n\n🟡 *Old Regime Tax:* ${fmt(lastTaxData.oldTotal)} (Take-Home: ${fmt(lastTaxData.oldMonthly)}/mo)\n🔵 *New Regime Tax:* ${fmt(lastTaxData.newTotal)} (Take-Home: ${fmt(lastTaxData.newMonthly)}/mo)\n\n🏆 *Verdict:* ${lastTaxData.bestRegime}`;
            shareViaWhatsApp('Income Tax Comparison (Old vs New Regime)', summary);
        });

        document.getElementById('btnCopyLink').addEventListener('click', copyShareableURL);

        document.getElementById('btnSaveCalc').addEventListener('click', () => {
            if (!lastTaxData) return;
            const name = prompt('Label this tax scenario:', `Tax for CTC ${fmt(lastTaxData.gross)}`);
            if (name) {
                saveCalculation(name, {
                    gross: fmt(lastTaxData.gross),
                    bestRegime: lastTaxData.bestRegime
                });
            }
        });
    });
</script>

<%- include('partials/footer') %>

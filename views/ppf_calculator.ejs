<%- include('partials/header') %>

<div class="page-title-section fade-in-up">
    <h1>PPF (Public Provident Fund) Calculator</h1>
    <p>Calculate your 15-year PPF maturity corpus, EEE tax exemption benefits, and download a complete year-by-year statement.</p>
</div>

<div class="form-card fade-in-up">
    <%- include('partials/ad_unit') %>

    <div class="row g-5">
        <!-- Left: Inputs -->
        <div class="col-lg-5">
            <div class="slider-container">
                <label for="investInput" class="form-label d-flex justify-content-between fw-bold">Yearly Investment (₹)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="investInput" value="150000" min="500" max="150000" step="500">
                </div>
                <div id="ppfWords" class="number-words-preview"></div>
                <input type="range" id="investSlider" min="500" max="150000" step="500" value="150000" class="form-range mt-2">
                <div id="ppfPresets"></div>
                <small style="color:var(--text-muted); font-size:0.78rem;">Min ₹500 / Max ₹1,50,000 per financial year (80C limit)</small>
            </div>

            <div class="mb-3">
                <label for="ppfRate" class="form-label d-flex justify-content-between fw-bold">Govt PPF Interest Rate (%)</label>
                <div class="input-group">
                    <input type="number" class="form-control" id="ppfRate" value="7.1" step="0.1">
                    <span class="input-group-text">%</span>
                </div>
                <small style="color:var(--text-muted); font-size:0.78rem;">Guaranteed Sovereign Backed Rate: 7.1% p.a.</small>
            </div>

            <div class="mb-4">
                <label for="tenure" class="form-label fw-bold">Investment Tenure</label>
                <select class="form-select" id="tenure">
                    <option value="15" selected>15 Years (Standard Lock-in)</option>
                    <option value="20">20 Years (1 Extension of 5 Yrs)</option>
                    <option value="25">25 Years (2 Extensions)</option>
                    <option value="30">30 Years (3 Extensions)</option>
                </select>
            </div>

            <div class="highlight-box p-3 rounded" style="background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3);">
                <h6 class="text-success fw-bold">🛡️ EEE (100% Tax-Free) Status</h6>
                <p style="font-size:0.85rem; margin:0;">Investments qualify for Section 80C deductions, all yearly interest earned is tax-free, and final maturity withdrawal is 100% tax-free!</p>
            </div>
        </div>

        <!-- Right: Results -->
        <div class="col-lg-7">
            <div class="emi-result-display mb-3">
                <p class="label">Tax-Free Maturity Corpus</p>
                <p class="amount" id="maturityAmt">₹0</p>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-6"><div class="summary-card"><div class="label">Total Invested</div><div class="value gold" id="totalInvested">₹0</div></div></div>
                <div class="col-6"><div class="summary-card"><div class="label">Total Interest Earned</div><div class="value profit" id="totalInterest" style="color:#10b981;">₹0</div></div></div>
                <div class="col-6"><div class="summary-card"><div class="label">Wealth Multiplier</div><div class="value gold" id="multiplier">0x</div></div></div>
                <div class="col-6"><div class="summary-card"><div class="label">Tax Saved (30% slab)</div><div class="value profit" id="taxSaved" style="color:#10b981;">₹0</div></div></div>
            </div>

            <div class="chart-container" style="max-height: 240px;">
                <canvas id="ppfChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="action-toolbar" id="ppfActionToolbar">
        <span class="toolbar-label">Tools & Export:</span>
        <button type="button" class="btn-action-tool" id="btnExportPDF">
            <span>📄</span> Download PPF Statement PDF
        </button>
        <button type="button" class="btn-action-tool btn-whatsapp" id="btnShareWA">
            <span>💬</span> Share on WhatsApp
        </button>
        <button type="button" class="btn-action-tool" id="btnCopyLink">
            <span>🔗</span> Copy Link
        </button>
        <button type="button" class="btn-action-tool" id="btnSaveCalc">
            <span>💾</span> Save Calculation
        </button>
    </div>

    <!-- Related Section -->
    <div class="related-calculators-section">
        <h5 class="related-calc-title">💡 Related Retirement & Savings Calculators</h5>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <a href="/ssy-calculator" class="related-mini-card">
                    <span class="icon">👧</span>
                    <div>
                        <div class="title">SSY Scheme</div>
                        <div class="desc">8.2% Tax-Free for Girl</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/nps-calculator" class="related-mini-card">
                    <span class="icon">🛡️</span>
                    <div>
                        <div class="title">NPS Calculator</div>
                        <div class="desc">National Pension</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/sip-calculator" class="related-mini-card">
                    <span class="icon">📊</span>
                    <div>
                        <div class="title">SIP Calculator</div>
                        <div class="desc">Equity Mutual Funds</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/income-tax-calculator" class="related-mini-card">
                    <span class="icon">🧾</span>
                    <div>
                        <div class="title">Income Tax</div>
                        <div class="desc">Maximize 80C</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

<%- include('partials/ad_unit') %>
</div>

<script>
    const fmt = (n) => new Intl.NumberFormat('en-IN', { style:'currency', currency:'INR', maximumFractionDigits:0 }).format(n);
    let ppfChart = null;
    let lastPPFData = null;

    // Attach Number to Words
    attachNumberToWords('investInput', 'ppfWords');

    // Preset Chips
    createPresetChips('ppfPresets', 'investInput', 'investSlider', [
        { label: '₹12,000 (1K/mo)', value: 12000 },
        { label: '₹50,000', value: 50000 },
        { label: '₹1 Lakh', value: 100000 },
        { label: '₹1.5 Lakhs (Max 80C)', value: 150000 }
    ], calculatePPF);

    const invIn = document.getElementById('investInput'), invSl = document.getElementById('investSlider');
    const rateEl = document.getElementById('ppfRate'), tenureEl = document.getElementById('tenure');

    invSl.addEventListener('input', () => { invIn.value = invSl.value; calculatePPF(); });
    invIn.addEventListener('input', () => { invSl.value = invIn.value; calculatePPF(); });
    rateEl.addEventListener('input', calculatePPF);
    tenureEl.addEventListener('change', calculatePPF);

    // URL Load
    const urlParams = loadParamsFromURL();
    if (urlParams.p) invIn.value = invSl.value = urlParams.p;
    if (urlParams.r) rateEl.value = urlParams.r;
    if (urlParams.t) tenureEl.value = urlParams.t;

    function calculatePPF() {
        const annual = parseFloat(invIn.value) || 0;
        const rate = (parseFloat(rateEl.value) || 7.1) / 100;
        const years = parseInt(tenureEl.value) || 15;

        if (annual <= 0 || years <= 0) return;

        let balance = 0;
        const yearLabels = [], balances = [], investedData = [];
        let totalInterestAll = 0;
        const tableRows = [];

        for (let y = 1; y <= years; y++) {
            balance += annual;
            const interest = balance * rate;
            totalInterestAll += interest;
            balance += interest;
            yearLabels.push('Y' + y);
            balances.push(Math.round(balance));
            investedData.push(Math.round(annual * y));

            tableRows.push([
                `Year ${y}`,
                fmt(annual * y),
                fmt(interest),
                fmt(balance)
            ]);
        }

        const totalInvested = annual * years;
        const mult = totalInvested > 0 ? (balance / totalInvested).toFixed(2) : '1.0';
        const taxSaved = Math.min(annual, 150000) * years * 0.30;

        document.getElementById('maturityAmt').textContent = fmt(balance);
        document.getElementById('totalInvested').textContent = fmt(totalInvested);
        document.getElementById('totalInterest').textContent = fmt(totalInterestAll);
        document.getElementById('multiplier').textContent = `${mult}x`;
        document.getElementById('taxSaved').textContent = fmt(taxSaved);

        // Sync URL
        syncParamsToURL({ p: annual, r: rateEl.value, t: years });

        // Chart
        const ctx = document.getElementById('ppfChart').getContext('2d');
        if (ppfChart) ppfChart.destroy();
        ppfChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: yearLabels,
                datasets: [
                    { label: 'Total Balance (Maturity)', data: balances, backgroundColor: '#f59e0b', borderRadius: 4 },
                    { label: 'Amount Invested', data: investedData, backgroundColor: '#0d6efd', borderRadius: 4 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: { legend: { labels: { color: '#94a3b8' } } },
                scales: {
                    x: { ticks: { color: '#64748b', maxTicksLimit: 10 } },
                    y: { ticks: { color: '#64748b', callback: v => formatCompactIndianCurrency(v) } }
                }
            }
        });

        lastPPFData = {
            annual, rate: rateEl.value, years, balance, totalInvested, totalInterestAll, mult, taxSaved,
            tableRows
        };
    }

    // Toolbar
    document.getElementById('btnExportPDF').addEventListener('click', () => {
        if (!lastPPFData) return;
        exportCalculatorPDF({
            docTitle: `PPF (Public Provident Fund) Statement (${fmt(lastPPFData.annual)}/year for ${lastPPFData.years} Years)`,
            summaryData: [
                { label: 'Yearly Deposit', value: fmt(lastPPFData.annual) },
                { label: 'Total Invested', value: fmt(lastPPFData.totalInvested) },
                { label: 'Total Tax-Free Interest', value: fmt(lastPPFData.totalInterestAll) },
                { label: 'Maturity Corpus', value: fmt(lastPPFData.balance), highlight: true }
            ],
            tableHeaders: ['Year', 'Total Invested', 'Interest Earned', 'End Balance'],
            tableRows: lastPPFData.tableRows,
            filename: 'ppf_maturity_statement'
        });
    });

    document.getElementById('btnShareWA').addEventListener('click', () => {
        if (!lastPPFData) return;
        const summary = `🏛️ *PPF Annual Deposit:* ${fmt(lastPPFData.annual)}\n⏳ *Duration:* ${lastPPFData.years} Years (7.1% Tax-Free)\n\n💵 *Total Invested:* ${fmt(lastPPFData.totalInvested)}\n✨ *Total Interest:* ${fmt(lastPPFData.totalInterestAll)}\n🏆 *Tax-Free Maturity Corpus:* ${fmt(lastPPFData.balance)} (${lastPPFData.mult}x growth!)\n🛡️ *Tax Saved (80C):* ${fmt(lastPPFData.taxSaved)}`;
        shareViaWhatsApp('Public Provident Fund (PPF) Projection', summary);
    });

    document.getElementById('btnCopyLink').addEventListener('click', copyShareableURL);

    document.getElementById('btnSaveCalc').addEventListener('click', () => {
        if (!lastPPFData) return;
        const name = prompt('Label this PPF plan:', `PPF ${fmt(lastPPFData.annual)}/yr (${lastPPFData.years}Y)`);
        if (name) {
            saveCalculation(name, {
                annual: fmt(lastPPFData.annual),
                maturity: fmt(lastPPFData.balance)
            });
        }
    });

    calculatePPF();
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<div class="page-title-section fade-in-up">
    <h1>Compound Interest Calculator</h1>
    <p>Visualize the exponential power of compounding on your investments with customizable compounding frequencies, Effective Annual Rate (EAR), and PDF export.</p>
</div>

<div class="form-card fade-in-up">
    <%- include('partials/ad_unit') %>

    <div class="row g-5">
        <!-- Left Column: Inputs -->
        <div class="col-lg-6">
            <!-- Principal Amount -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label for="principalInput" class="form-label mb-0 fw-bold">Principal Amount</label>
                    </div>
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" class="form-control" id="principalInput" min="1000" max="50000000" step="5000" placeholder="e.g., 1,00,000">
                        </div>
                    </div>
                </div>
                <div id="principalWords" class="number-words-preview"></div>
                <input type="range" min="5000" max="5000000" step="5000" class="form-range mt-2" id="principalSlider">
                <div id="principalPresets"></div>
            </div>

            <!-- Annual Interest Rate -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label for="rateInput" class="form-label mb-0 fw-bold">Interest Rate</label>
                    </div>
                    <div class="col-md-7">
                        <div class="input-group">
                            <input type="number" class="form-control" id="rateInput" min="1" max="35" step="0.1" placeholder="e.g., 12">
                            <span class="input-group-text">% p.a.</span>
                        </div>
                    </div>
                </div>
                <input type="range" min="1" max="30" step="0.1" class="form-range mt-2" id="rateSlider">
                <div id="ratePresets"></div>
            </div>

            <!-- Time Period -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label for="timeInput" class="form-label mb-0 fw-bold">Time Period</label>
                    </div>
                    <div class="col-md-7">
                        <div class="input-group">
                            <input type="number" class="form-control" id="timeInput" min="1" max="40" step="1" placeholder="e.g., 10">
                            <span class="input-group-text">Years</span>
                        </div>
                    </div>
                </div>
                <input type="range" min="1" max="40" step="1" class="form-range mt-2" id="timeSlider">
                <div id="timePresets"></div>
            </div>

            <!-- Compounding Frequency -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label for="compoundingFrequency" class="form-label mb-0 fw-bold">Compounding</label>
                    </div>
                    <div class="col-md-7">
                        <select class="form-select" id="compoundingFrequency">
                            <option value="12">Monthly</option>
                            <option value="4">Quarterly</option>
                            <option value="2">Semi-Annually</option>
                            <option value="1" selected>Annually (Yearly)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-lg-6 d-flex flex-column">
            <div id="initialState" class="d-flex flex-grow-1 align-items-center justify-content-center h-100 text-center text-muted p-4" style="background-color: var(--bg-input); border-radius: 12px; border: 1px solid var(--border);">
                <h4>Enter your investment details to see compounding growth.</h4>
            </div>

            <div id="resultsState" class="flex-grow-1" style="display: none;">
                <div class="emi-result-display mb-3">
                    <div class="label">Total Maturity Value</div>
                    <div class="amount" id="totalMaturityValue">₹0</div>
                </div>

                <div class="row g-3 align-items-center">
                    <div class="col-md-7">
                        <div class="emi-summary-card">
                            <div class="summary-item">
                                <div>
                                    <span class="dot" style="background-color: #0d6efd;"></span>
                                    <span class="label">Principal Amount</span>
                                </div>
                                <div class="value" id="totalPrincipal">₹0</div>
                            </div>
                            <div class="summary-item">
                                <div>
                                    <span class="dot" style="background-color: #10b981;"></span>
                                    <span class="label">Total Interest Earned</span>
                                </div>
                                <div class="value" id="totalInterest" style="color: #10b981;">₹0</div>
                            </div>
                            <div class="summary-item mt-2 p-2 rounded" style="background: rgba(245, 158, 11, 0.1); border: 1px solid var(--border);">
                                <div class="label fw-bold text-gold-custom">Effective Annual Rate (EAR)</div>
                                <div class="value text-gold-custom" id="effectiveAnnualRate">0%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 d-flex align-items-center justify-content-center" style="max-height: 200px;">
                        <canvas id="ciPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="action-toolbar" id="ciActionToolbar" style="display: none;">
        <span class="toolbar-label">Tools & Export:</span>
        <button type="button" class="btn-action-tool" id="btnExportPDF">
            <span>📄</span> Download PDF Report
        </button>
        <button type="button" class="btn-action-tool" id="btnExportCSV">
            <span>📊</span> Export Excel/CSV
        </button>
        <button type="button" class="btn-action-tool btn-whatsapp" id="btnShareWA">
            <span>💬</span> Share on WhatsApp
        </button>
        <button type="button" class="btn-action-tool" id="btnCopyLink">
            <span>🔗</span> Copy Link
        </button>
        <button type="button" class="btn-action-tool" id="btnSaveCalc">
            <span>💾</span> Save Calculation
        </button>
    </div>
    
    <!-- Yearly Breakdown Table -->
    <div id="yearlyBreakdownSection" class="mt-5" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0">Year-by-Year Compounding Schedule</h4>
            <button type="button" class="btn btn-sm btn-outline-warning" onclick="exportTableToCSV('compound_interest_schedule', 'ciTable')">
                📥 Download CSV Table
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered text-center" id="ciTable">
                <thead class="table-dark">
                    <tr><th>Year</th><th>Interest Earned</th><th>End of Year Balance</th></tr>
                </thead>
                <tbody id="yearlyBreakdownBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Related Calculators Section -->
    <div class="related-calculators-section">
        <h5 class="related-calc-title">💡 Related Investment Calculators</h5>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <a href="/sip-calculator" class="related-mini-card">
                    <span class="icon">📊</span>
                    <div>
                        <div class="title">SIP Calculator</div>
                        <div class="desc">Monthly Compounding</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/fd-calculator" class="related-mini-card">
                    <span class="icon">🏦</span>
                    <div>
                        <div class="title">FD Calculator</div>
                        <div class="desc">Bank Fixed Deposit</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/cagr-calculator" class="related-mini-card">
                    <span class="icon">📐</span>
                    <div>
                        <div class="title">CAGR Calculator</div>
                        <div class="desc">True Annual Return</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/simple-interest" class="related-mini-card">
                    <span class="icon">🧮</span>
                    <div>
                        <div class="title">Simple Interest</div>
                        <div class="desc">Linear Growth Check</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Information Accordion -->
    <div class="info-accordion mt-5">
        <div class="accordion" id="calculatorInfoAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
                        The Power of Compounding & Rule of 72
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show">
                    <div class="accordion-body">
                        <p><strong>Formula:</strong> <code>A = P(1 + r/n)^(nt)</code></p>
                        <p><strong>Rule of 72:</strong> Divide 72 by the annual return rate to find the exact number of years it takes for your money to double (e.g. at 12%, money doubles in ~6 years!).</p>
                    </div>
                </div>
            </div>
        </div>
        <%- include('partials/ad_unit') %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const principalSlider = document.getElementById('principalSlider'), rateSlider = document.getElementById('rateSlider'), timeSlider = document.getElementById('timeSlider');
        const principalInput = document.getElementById('principalInput'), rateInput = document.getElementById('rateInput'), timeInput = document.getElementById('timeInput');
        const compoundingFrequency = document.getElementById('compoundingFrequency');
        
        const initialState = document.getElementById('initialState'), resultsState = document.getElementById('resultsState'), yearlyBreakdownSection = document.getElementById('yearlyBreakdownSection');
        const actionToolbar = document.getElementById('ciActionToolbar');
        const totalPrincipal = document.getElementById('totalPrincipal'), totalInterest = document.getElementById('totalInterest'), totalMaturityValue = document.getElementById('totalMaturityValue');
        const effectiveAnnualRate = document.getElementById('effectiveAnnualRate');
        const yearlyBreakdownBody = document.getElementById('yearlyBreakdownBody'), pieChartCanvas = document.getElementById('ciPieChart');
        
        let ciPieChart;
        let lastCIData = null;
        const formatCurrency = (num) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num);

        // 1. Number to Words
        attachNumberToWords('principalInput', 'principalWords');

        // 2. Preset Chips
        createPresetChips('principalPresets', 'principalInput', 'principalSlider', [
            { label: '₹50K', value: 50000 },
            { label: '₹1 Lakh', value: 100000 },
            { label: '₹5 Lakhs', value: 500000 },
            { label: '₹10 Lakhs', value: 1000000 },
            { label: '₹25 Lakhs', value: 2500000 }
        ], calculateAndDisplay);

        createPresetChips('ratePresets', 'rateInput', 'rateSlider', [
            { label: '7% (FD/Safe)', value: 7 },
            { label: '10% (Balanced)', value: 10 },
            { label: '12% (Nifty Index)', value: 12 },
            { label: '15% (Aggressive)', value: 15 }
        ], calculateAndDisplay);

        createPresetChips('timePresets', 'timeInput', 'timeSlider', [
            { label: '3 Yrs', value: 3 },
            { label: '5 Yrs', value: 5 },
            { label: '10 Yrs', value: 10 },
            { label: '15 Yrs', value: 15 },
            { label: '20 Yrs', value: 20 }
        ], calculateAndDisplay);

        // 3. Load from URL
        const urlParams = loadParamsFromURL();
        if (urlParams.p) principalInput.value = principalSlider.value = urlParams.p;
        else principalInput.value = principalSlider.value = 100000;

        if (urlParams.r) rateInput.value = rateSlider.value = urlParams.r;
        else rateInput.value = rateSlider.value = 12;

        if (urlParams.t) timeInput.value = timeSlider.value = urlParams.t;
        else timeInput.value = timeSlider.value = 10;

        if (urlParams.freq) compoundingFrequency.value = urlParams.freq;

        function calculateAndDisplay() {
            const P = parseFloat(principalInput.value);
            const R_annual = parseFloat(rateInput.value) / 100;
            const T = parseFloat(timeInput.value);
            const n = parseFloat(compoundingFrequency.value);

            if (isNaN(P) || isNaN(R_annual) || isNaN(T) || isNaN(n) || P <= 0 || R_annual < 0 || T <= 0) {
                initialState.style.display = 'flex';
                resultsState.style.display = 'none';
                yearlyBreakdownSection.style.display = 'none';
                if (actionToolbar) actionToolbar.style.display = 'none';
                if (ciPieChart) ciPieChart.destroy();
                return;
            }

            initialState.style.display = 'none';
            resultsState.style.display = 'block';
            yearlyBreakdownSection.style.display = 'block';
            if (actionToolbar) actionToolbar.style.display = 'flex';

            const totalAmount = P * Math.pow(1 + (R_annual / n), n * T);
            const totalInterestAmount = totalAmount - P;
            const ear = (Math.pow(1 + (R_annual / n), n) - 1) * 100;

            totalPrincipal.textContent = formatCurrency(P);
            totalInterest.textContent = formatCurrency(totalInterestAmount);
            totalMaturityValue.textContent = formatCurrency(totalAmount);
            effectiveAnnualRate.textContent = `${ear.toFixed(2)}%`;

            // Sync URL
            syncParamsToURL({
                p: P,
                r: rateInput.value,
                t: T,
                freq: compoundingFrequency.value
            });

            if (ciPieChart) ciPieChart.destroy();
            ciPieChart = new Chart(pieChartCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Principal Amount', 'Total Interest'],
                    datasets: [{
                        data: [P, totalInterestAmount],
                        backgroundColor: ['#0d6efd', '#10b981'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });

            yearlyBreakdownBody.innerHTML = '';
            let previousYearBalance = P;
            const tableRows = [];

            for (let year = 1; year <= T; year++) {
                const endOfYearBalance = P * Math.pow(1 + (R_annual / n), n * year);
                const interestForYear = endOfYearBalance - previousYearBalance;
                const rowData = [
                    `Year ${year}`,
                    formatCurrency(interestForYear),
                    formatCurrency(endOfYearBalance)
                ];
                tableRows.push(rowData);
                yearlyBreakdownBody.innerHTML += `<tr><td>${year}</td><td>${formatCurrency(interestForYear)}</td><td><strong>${formatCurrency(endOfYearBalance)}</strong></td></tr>`;
                previousYearBalance = endOfYearBalance;
            }

            lastCIData = {
                P, rate: rateInput.value, T, freq: compoundingFrequency.options[compoundingFrequency.selectedIndex].text,
                totalAmount, totalInterestAmount, ear: ear.toFixed(2),
                tableHeaders: ['Year', 'Interest Earned', 'End of Year Balance'],
                tableRows
            };
        }

        function syncAndCalculate(source, target) {
            target.value = source.value;
            calculateAndDisplay();
        }

        principalSlider.addEventListener('input', () => syncAndCalculate(principalSlider, principalInput));
        principalInput.addEventListener('input', () => syncAndCalculate(principalInput, principalSlider));
        rateSlider.addEventListener('input', () => syncAndCalculate(rateSlider, rateInput));
        rateInput.addEventListener('input', () => syncAndCalculate(rateInput, rateSlider));
        timeSlider.addEventListener('input', () => syncAndCalculate(timeSlider, timeInput));
        timeInput.addEventListener('input', () => syncAndCalculate(timeInput, timeSlider));
        compoundingFrequency.addEventListener('change', calculateAndDisplay);

        // Toolbar
        document.getElementById('btnExportPDF').addEventListener('click', () => {
            if (!lastCIData) return;
            exportCalculatorPDF({
                docTitle: `Compound Interest Report (${formatCurrency(lastCIData.P)} @ ${lastCIData.rate}% for ${lastCIData.T} Yrs)`,
                summaryData: [
                    { label: 'Initial Deposit', value: formatCurrency(lastCIData.P) },
                    { label: 'Total Interest', value: formatCurrency(lastCIData.totalInterestAmount) },
                    { label: 'Maturity Value', value: formatCurrency(lastCIData.totalAmount), highlight: true },
                    { label: 'Effective Rate (EAR)', value: `${lastCIData.ear}%` }
                ],
                tableHeaders: lastCIData.tableHeaders,
                tableRows: lastCIData.tableRows,
                filename: 'compound_interest_report'
            });
        });

        document.getElementById('btnExportCSV').addEventListener('click', () => {
            exportTableToCSV('compound_interest_schedule', 'ciTable');
        });

        document.getElementById('btnShareWA').addEventListener('click', () => {
            if (!lastCIData) return;
            const summary = `💰 *Principal:* ${formatCurrency(lastCIData.P)}\n📈 *Interest Rate:* ${lastCIData.rate}% (${lastCIData.freq})\n⏳ *Time Period:* ${lastCIData.T} Years\n\n💵 *Total Interest:* ${formatCurrency(lastCIData.totalInterestAmount)}\n🏆 *Final Maturity Value:* ${formatCurrency(lastCIData.totalAmount)}\n✨ *Effective Annual Rate:* ${lastCIData.ear}%`;
            shareViaWhatsApp('Compound Interest Growth Report', summary);
        });

        document.getElementById('btnCopyLink').addEventListener('click', copyShareableURL);

        document.getElementById('btnSaveCalc').addEventListener('click', () => {
            if (!lastCIData) return;
            const name = prompt('Enter a label (e.g. "Mutual Fund Lumpsum 10Y")', `Compound ${formatCurrency(lastCIData.P)} (${lastCIData.T}Y)`);
            if (name) {
                saveCalculation(name, {
                    principal: formatCurrency(lastCIData.P),
                    maturity: formatCurrency(lastCIData.totalAmount)
                });
            }
        });

        calculateAndDisplay();
    });
</script>

<%- include('partials/footer') %>
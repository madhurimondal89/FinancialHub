<%- include('partials/header') %>
<div class="form-card">
    <h3 class="mb-1">📅 RD Calculator (Recurring Deposit)</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">Calculate maturity amount and quarterly compounded interest on Bank & Post Office RDs</p>
<%- include('partials/ad_unit') %>
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="mb-4">
                <label class="form-label">Monthly Deposit Amount (₹)</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="rdMonthly" value="5000" step="500" oninput="calculate()"></div>
                <div id="rdWords" class="words-helper" style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Annual Interest Rate (%)</label>
                <div class="input-group"><input type="number" class="form-control" id="rdRate" value="7.1" step="0.1" oninput="calculate()"><span class="input-group-text">% p.a.</span></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Time Period (Years)</label>
                <div class="input-group"><input type="number" class="form-control" id="rdYears" value="5" step="0.5" min="0.5" max="10" oninput="calculate()"><span class="input-group-text">Years</span></div>
            </div>
            <div class="highlight-box">
                <h4>🏦 Quarterly Compounding Standard</h4>
                <p>Most Indian commercial banks and Post Office calculate RD interest with <strong>quarterly compounding</strong> as per standard banking rules.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div id="resultsState">
                <div class="emi-result-display"><p class="label">Total Maturity Value</p><p class="amount" id="rdMaturity">₹3,60,453</p></div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">Total Amount Invested</div><div class="value" id="rInvested">₹3,00,000</div></div>
                    <div class="summary-item"><div class="label">Total Interest Earned</div><div class="value" style="color:var(--accent-green);" id="rInterest">₹60,453</div></div>
                    <div class="summary-item"><div class="label">Maturity Amount</div><div class="value" style="color:var(--gold);" id="rMaturity">₹3,60,453</div></div>
                    <div class="summary-item"><div class="label">Total Monthly Installments</div><div class="value" id="rMonths">60 Months</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="related-section"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/fd-calculator" class="related-card"><span class="icon">🏦</span><div class="title">FD Calculator</div><div class="desc">Fixed deposit maturity</div></a></div>
            <div class="col-md-4"><a href="/sip-calculator" class="related-card"><span class="icon">📊</span><div class="title">SIP Calculator</div><div class="desc">Mutual fund monthly plan</div></a></div>
            <div class="col-md-4"><a href="/ppf-calculator" class="related-card"><span class="icon">🏛️</span><div class="title">PPF Calculator</div><div class="desc">15-year tax-free savings</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>
<!-- Toolbar -->
<div class="action-toolbar" id="rdToolbar">
    <span class="toolbar-label">Tools:</span>
    <button type="button" class="btn-action-tool" id="rdBtnSave">💾 Save Calculation</button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="rdBtnShare">💬 Share on WhatsApp</button>
    <button type="button" class="btn-action-tool" id="rdBtnCopy">🔗 Copy Link</button>
</div>
<script>
const fmt = n => new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function calculate() {
    const P = parseFloat(document.getElementById('rdMonthly').value)||0;
    const rateAnnual = (parseFloat(document.getElementById('rdRate').value)||0) / 100;
    const years = parseFloat(document.getElementById('rdYears').value)||0;
    const N = years * 12; // number of months

    if(typeof attachNumberToWords === 'function') {
        const el = document.getElementById('rdWords');
        if(el) el.textContent = convertNumberToIndianWords(P);
    }

    if(P <= 0 || years <= 0 || rateAnnual <= 0) return;

    // RD Maturity Formula with Quarterly Compounding:
    // M = P * ((1+i)^n - 1) / (1 - (1+i)^(-1/3)) where i = rate / 4 (quarterly rate)
    const i = rateAnnual / 4;
    let maturity = 0;
    for(let m = 1; m <= N; m++) {
        // Each installment compounds for remaining (N - m + 1) months
        const quarters = (N - m + 1) / 3;
        maturity += P * Math.pow(1 + i, quarters);
    }

    const totalInvested = P * N;
    const totalInterest = maturity - totalInvested;

    document.getElementById('rdMaturity').textContent = fmt(maturity);
    document.getElementById('rInvested').textContent = fmt(totalInvested);
    document.getElementById('rInterest').textContent = '+' + fmt(totalInterest);
    document.getElementById('rMaturity').textContent = fmt(maturity);
    document.getElementById('rMonths').textContent = N + ' Months (' + years + ' Years)';

    window._lastRD = { P, rateAnnual: rateAnnual*100, years, totalInvested, totalInterest, maturity };
}
document.addEventListener('DOMContentLoaded', () => {
    calculate();
    document.getElementById('rdBtnSave').addEventListener('click', () => {
        const d = window._lastRD; if(!d) return;
        const name = prompt('Save as:', `RD ${fmt(d.P)}/mo (${d.years}Y)`);
        if(name) saveCalculation(name, { Monthly: fmt(d.P), TotalInvested: fmt(d.totalInvested), Interest: fmt(d.totalInterest), Maturity: fmt(d.maturity) });
    });
    document.getElementById('rdBtnShare').addEventListener('click', () => {
        const d = window._lastRD; if(!d) return;
        shareViaWhatsApp('RD Calculator', `Monthly Deposit: ${fmt(d.P)}\nTenure: ${d.years} Years\nTotal Invested: ${fmt(d.totalInvested)}\nInterest Earned: ${fmt(d.totalInterest)}\nMaturity Value: ${fmt(d.maturity)}`);
    });
    document.getElementById('rdBtnCopy').addEventListener('click', copyShareableURL);
});
</script>
<%- include('partials/footer') %>

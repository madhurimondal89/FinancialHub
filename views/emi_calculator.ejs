<%- include('partials/header') %>

<div class="page-title-section fade-in-up">
    <h1>Loan EMI Calculator</h1>
    <p>Calculate your exact monthly EMI for Home Loans, Car Loans, or Personal Loans with complete amortization breakdown, PDF download, and WhatsApp share.</p>
</div>

<div class="form-card fade-in-up">

    <div class="row g-5">
        <!-- Left Column: Inputs -->
        <div class="col-lg-6">
            <!-- Loan Amount -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label for="principalInput" class="form-label mb-0 fw-bold">Loan Amount</label>
                    </div>
                    <div class="col-md-7">
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" class="form-control" id="principalInput" min="10000" max="50000000" step="10000" placeholder="e.g., 25,00,000">
                        </div>
                    </div>
                </div>
                <div id="principalWords" class="number-words-preview"></div>
                <input type="range" min="50000" max="10000000" step="25000" class="form-range mt-2" id="principalSlider">
                <div id="principalPresets"></div>
            </div>

            <!-- Interest Rate -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label for="rateInput" class="form-label mb-0 fw-bold">Interest Rate</label>
                    </div>
                    <div class="col-md-7">
                        <div class="input-group">
                            <input type="number" class="form-control" id="rateInput" min="1" max="25" step="0.05" placeholder="e.g., 8.5">
                            <span class="input-group-text">% p.a.</span>
                        </div>
                    </div>
                </div>
                <input type="range" min="5" max="20" step="0.1" class="form-range mt-2" id="rateSlider">
                <div id="ratePresets"></div>
            </div>

            <!-- Loan Tenure -->
            <div class="slider-container">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <label class="form-label mb-0 fw-bold">Loan Tenure</label>
                    </div>
                    <div class="col-md-7">
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="tenureType" id="tenureTypeYears" autocomplete="off" checked>
                            <label class="btn btn-outline-primary btn-sm" for="tenureTypeYears">Years</label>
                            <input type="radio" class="btn-check" name="tenureType" id="tenureTypeMonths" autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="tenureTypeMonths">Months</label>
                        </div>
                    </div>
                </div>
                <div class="input-group mt-2">
                    <input type="number" class="form-control" id="tenureInput" min="1" max="35" step="1" placeholder="e.g., 20">
                    <span class="input-group-text" id="tenureUnitLabel">Years</span>
                </div>
                <input type="range" min="1" max="30" step="1" class="form-range mt-2" id="tenureSlider">
                <div id="tenurePresets"></div>
            </div>
        </div>

        <!-- Right Column: Results -->
        <div class="col-lg-6 d-flex flex-column">
            <div id="initialState" class="d-flex flex-grow-1 align-items-center justify-content-center h-100 text-center text-muted p-4" style="background-color: var(--bg-input); border-radius: 12px; border: 1px solid var(--border);">
                <h4>Enter your loan details to calculate EMI and interest breakdown.</h4>
            </div>

            <div id="resultsState" class="flex-grow-1" style="display: none;">
                <div class="emi-result-display mb-3">
                    <div class="label">Monthly Loan EMI</div>
                    <div class="amount" id="emiResult">₹0</div>
                </div>

                <div class="row g-3 align-items-center">
                    <div class="col-md-7">
                        <div class="emi-summary-card">
                            <div class="summary-item">
                                <div>
                                    <span class="dot" style="background-color: #0d6efd;"></span>
                                    <span class="label">Principal Amount</span>
                                </div>
                                <div class="value" id="totalPrincipal">₹0</div>
                            </div>
                            <div class="summary-item">
                                <div>
                                    <span class="dot" style="background-color: #ef4444;"></span>
                                    <span class="label">Total Interest</span>
                                </div>
                                <div class="value" id="totalInterest" style="color: #ef4444;">₹0</div>
                            </div>
                            <hr style="border-color: var(--border); margin: 8px 0;">
                            <div class="summary-item fw-bold">
                                <div>
                                    <span class="label">Total Amount Payable</span>
                                </div>
                                <div class="value" id="totalPayment">₹0</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 d-flex align-items-center justify-content-center" style="max-height: 200px;">
                        <canvas id="emiPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Toolbar -->
    <div class="action-toolbar" id="emiActionToolbar" style="display: none;">
        <span class="toolbar-label">Export & Share:</span>
        <button type="button" class="btn-action-tool" id="btnExportPDF">
            <span>📄</span> Download EMI Schedule PDF
        </button>
        <button type="button" class="btn-action-tool" id="btnExportCSV">
            <span>📊</span> Export Excel/CSV
        </button>
        <button type="button" class="btn-action-tool btn-whatsapp" id="btnShareWA">
            <span>💬</span> Share on WhatsApp
        </button>
        <button type="button" class="btn-action-tool" id="btnCopyLink">
            <span>🔗</span> Copy Link
        </button>
        <button type="button" class="btn-action-tool" id="btnSaveCalc">
            <span>💾</span> Save Calculation
        </button>
    </div>
    
    <!-- Amortization Schedule Table -->
    <div id="amortizationSection" class="mt-5" style="display: none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0" id="amortizationTitle">Amortization Schedule</h4>
            <button type="button" class="btn btn-sm btn-outline-warning" onclick="exportTableToCSV('loan_amortization_schedule', 'amortizationTable')">
                📥 Download CSV Table
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-bordered text-center" id="amortizationTable">
                <thead class="table-dark" id="amortizationHead"></thead>
                <tbody id="amortizationBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Related Calculators Section -->
    <div class="related-calculators-section">
        <h5 class="related-calc-title">💡 Related Loan & Tax Calculators</h5>
        <div class="row g-3">
            <div class="col-md-3 col-6">
                <a href="/loan-prepayment-calculator" class="related-mini-card">
                    <span class="icon">⚡</span>
                    <div>
                        <div class="title">Loan Prepayment</div>
                        <div class="desc">Save Lakhs in Interest</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/car-loan-calculator" class="related-mini-card">
                    <span class="icon">🚗</span>
                    <div>
                        <div class="title">Car Loan EMI</div>
                        <div class="desc">With Down Payment</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/hra-calculator" class="related-mini-card">
                    <span class="icon">🏢</span>
                    <div>
                        <div class="title">HRA Exemption</div>
                        <div class="desc">Section 10(13A) Tax</div>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="/budget-calculator" class="related-mini-card">
                    <span class="icon">📋</span>
                    <div>
                        <div class="title">Budget 50/30/20</div>
                        <div class="desc">Plan Loan vs Savings</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Guide, AEO Definitions, Loan Comparison Table & SEO Accordion -->
    <div class="info-accordion mt-5">
        <!-- E-E-A-T Authority & Editorial Trust Card -->
        <div class="p-3 mb-4 rounded-3 border" style="background: rgba(13, 110, 253, 0.05); border-color: rgba(13, 110, 253, 0.2) !important;">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span style="font-size: 1.3rem;">🏦</span>
                    <div>
                        <strong class="text-body-emphasis small d-block">RBI Standard Reducing Balance Calculation Engine</strong>
                        <span class="text-muted" style="font-size: 0.78rem;">Complies with Reserve Bank of India retail lending guidelines and standard amortization schedules (FY 2026-27).</span>
                    </div>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill" style="font-size: 0.75rem;">✓ 100% Private & Verified</span>
            </div>
        </div>

        <!-- AEO Quick Definition Box (Targeted for Google AI Overviews & Direct Answers) -->
        <div class="card p-4 rounded-4 mb-4 border" style="background: var(--bg-card, #0f172a);">
            <h2 class="h4 fw-bold mb-3" style="color: var(--heading-color, #f8fafc);">What is an Equated Monthly Installment (EMI)?</h2>
            <p class="lead mb-3 text-secondary" style="font-size: 1.02rem; line-height: 1.7;">
                An <strong>Equated Monthly Installment (EMI)</strong> is a fixed payment amount made by a borrower to a lender (bank or NBFC) on a specified date of every calendar month until the borrowed loan principal and accrued interest are fully paid off.
            </p>
            <p class="text-muted small mb-0">
                In standard retail loans, each EMI comprises two parts: the <strong>principal portion</strong> and the <strong>interest portion</strong>. During the initial tenure, the interest component forms the bulk of your EMI; as tenure progresses, the principal component increases while the interest portion tapers down.
            </p>
        </div>

        <!-- Reducing Balance EMI Mathematical Formula -->
        <div class="card p-4 rounded-4 mb-4 border" style="background: var(--bg-card, #0f172a);">
            <h3 class="h5 fw-bold mb-2" style="color: var(--heading-color, #f8fafc);">📐 Reducing Balance EMI Calculation Formula</h3>
            <p class="small text-muted mb-3">All major banks in India (SBI, HDFC, ICICI, Axis Bank) compute monthly installments using the standardized reducing balance formula:</p>
            <div class="p-3 rounded-3 font-monospace fw-bold text-primary mb-3 text-center" style="background: rgba(13,110,253,0.08); font-size: 1.1rem; overflow-x: auto;">
                EMI = [P × R × (1 + R)ᴺ] / [ (1 + R)ᴺ – 1 ]
            </div>
            <div class="row g-2 small text-muted">
                <div class="col-md-4"><strong>P (Principal):</strong> Total loan amount borrowed from the bank.</div>
                <div class="col-md-4"><strong>R (Monthly Rate):</strong> Annual interest rate divided by 12 and 100 (e.g. 8.5% / 12 / 100).</div>
                <div class="col-md-4"><strong>N (Tenure):</strong> Total number of monthly installments (Years × 12).</div>
            </div>
        </div>

        <!-- Comparison Table: Home Loan vs Car Loan vs Personal Loan -->
        <div class="card p-4 rounded-4 mb-4 border" style="background: var(--bg-card, #0f172a);">
            <h3 class="h5 fw-bold mb-3" style="color: var(--heading-color, #f8fafc);">📊 Retail Loan Comparison: Home Loan vs Car Loan vs Personal Loan</h3>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-center" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Loan Parameter</th>
                            <th>Home Loan</th>
                            <th>Car / Auto Loan</th>
                            <th>Personal Loan</th>
                        </tr>
                    </thead>
                    <tbody class="text-muted">
                        <tr>
                            <td class="text-start fw-semibold text-body-emphasis">Typical Interest Rate</td>
                            <td>8.35% – 9.50% p.a.</td>
                            <td>8.75% – 10.50% p.a.</td>
                            <td>10.50% – 16.00% p.a.</td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold text-body-emphasis">Maximum Tenure</td>
                            <td>Up to 30 Years</td>
                            <td>Up to 7–8 Years</td>
                            <td>Up to 5 Years</td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold text-body-emphasis">Collateral / Security</td>
                            <td>Mortgage on property</td>
                            <td>Hypothecation of vehicle</td>
                            <td>None (Unsecured)</td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold text-body-emphasis">Tax Deductions (Old Regime)</td>
                            <td>Sec 24(b) ₹2 Lakh + Sec 80C</td>
                            <td>None (Unless business asset)</td>
                            <td>None (Unless used for home/biz)</td>
                        </tr>
                        <tr>
                            <td class="text-start fw-semibold text-body-emphasis">Prepayment Penalty</td>
                            <td>Zero (On floating rate)</td>
                            <td>0% – 5% (Bank policy)</td>
                            <td>2% – 5% depending on bank</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FAQ Accordion Section -->
        <h3 class="h4 fw-bold mt-5 mb-3" style="color: var(--heading-color, #f8fafc);">❓ Frequently Asked Questions (EMI FAQs)</h3>
        <div class="accordion" id="calculatorInfoAccordion">
            <div class="accordion-item">
                <h4 class="accordion-header" id="headingOne">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true">
                        How can I reduce my monthly loan EMI?
                    </button>
                </h4>
                <div id="collapseOne" class="accordion-collapse collapse show">
                    <div class="accordion-body text-muted">
                        You can lower your EMI by: (1) Increasing your loan tenure (though this increases total interest paid), (2) Making a higher upfront down payment to reduce the borrowed principal, (3) Negotiating a lower interest rate based on a good CIBIL credit score (750+), or (4) Transferring your outstanding loan to another lender with lower interest via our <a href="/loan-transfer-calculator" class="text-primary fw-semibold">Loan Balance Transfer Calculator</a>.
                    </div>
                </div>
            </div>
            
            <div class="accordion-item">
                <h4 class="accordion-header" id="headingTwo">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                        Does making loan prepayments really save interest?
                    </button>
                </h4>
                <div id="collapseTwo" class="accordion-collapse collapse">
                    <div class="accordion-body text-muted">
                        Yes, substantially! Making periodic prepayments directly reduces the loan principal balance. Since subsequent interest is calculated solely on the reduced principal, even paying just <strong>one extra EMI per year</strong> can reduce a 20-year home loan by 3 to 4 years and save lakhs in cumulative interest. Use our <a href="/loan-prepayment-calculator" class="text-primary fw-semibold">Loan Prepayment Calculator</a> to simulate your exact savings.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h4 class="accordion-header" id="headingThree">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                        What is the difference between Flat Interest Rate and Reducing Balance Rate?
                    </button>
                </h4>
                <div id="collapseThree" class="accordion-collapse collapse">
                    <div class="accordion-body text-muted">
                        In a <strong>Flat Interest Rate</strong>, interest is calculated on the full original principal for the entire duration, making it significantly more expensive (a 9% flat rate is equivalent to approximately 16% reducing rate!). In contrast, our calculator uses the <strong>Reducing Balance Rate</strong>, where interest is calculated each month only on the remaining unpaid principal.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h4 class="accordion-header" id="headingFour">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour">
                        Are there any foreclosure or prepayment charges on home loans?
                    </button>
                </h4>
                <div id="collapseFour" class="accordion-collapse collapse">
                    <div class="accordion-body text-muted">
                        As per Reserve Bank of India (RBI) regulations, banks and housing finance companies (HFCs) are strictly prohibited from levying any prepayment or foreclosure penalties on <strong>floating interest rate home loans</strong> sanctioned to individual borrowers.
                    </div>
                </div>
            </div>
        </div>

        <!-- Embedded FAQPage JSON-LD for Google Rich Snippets -->
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
                {
                    "@type": "Question",
                    "name": "How can I reduce my monthly loan EMI?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "You can lower your EMI by extending loan tenure, increasing upfront down payment, negotiating a lower interest rate with a high CIBIL score (750+), or opting for a loan balance transfer."
                    }
                },
                {
                    "@type": "Question",
                    "name": "Does making loan prepayments really save interest?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Yes. Prepayments directly cut down principal debt, reducing the base on which future interest is calculated. Even one extra EMI annually can shave 3 to 4 years off a 20-year home loan."
                    }
                },
                {
                    "@type": "Question",
                    "name": "What is the difference between Flat Interest Rate and Reducing Balance Rate?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Flat rates charge interest on the total original principal for the entire loan period. Reducing balance rates charge interest only on the outstanding principal balance each month, resulting in much lower total interest."
                    }
                },
                {
                    "@type": "Question",
                    "name": "Are there any foreclosure or prepayment charges on home loans?",
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": "Under RBI guidelines, lenders cannot charge prepayment or foreclosure penalties on floating-rate retail home loans taken by individuals."
                    }
                }
            ]
        }
        </script>

        <%- include('partials/ad_unit') %>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const principalSlider = document.getElementById('principalSlider'), rateSlider = document.getElementById('rateSlider'), tenureSlider = document.getElementById('tenureSlider');
        const principalInput = document.getElementById('principalInput'), rateInput = document.getElementById('rateInput'), tenureInput = document.getElementById('tenureInput');
        const tenureTypeYears = document.getElementById('tenureTypeYears'), tenureTypeMonths = document.getElementById('tenureTypeMonths');
        const tenureUnitLabel = document.getElementById('tenureUnitLabel');
        
        const initialState = document.getElementById('initialState'), resultsState = document.getElementById('resultsState'), amortizationSection = document.getElementById('amortizationSection');
        const actionToolbar = document.getElementById('emiActionToolbar');
        const emiResult = document.getElementById('emiResult'), totalPrincipal = document.getElementById('totalPrincipal'), totalInterest = document.getElementById('totalInterest'), totalPayment = document.getElementById('totalPayment');
        const amortizationTitle = document.getElementById('amortizationTitle'), amortizationHead = document.getElementById('amortizationHead'), amortizationBody = document.getElementById('amortizationBody'), pieChartCanvas = document.getElementById('emiPieChart');
        
        let emiPieChart;
        let lastEMIData = null;
        const formatCurrency = (num) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(num);

        // 1. Attach Live Number to Words
        attachNumberToWords('principalInput', 'principalWords');

        // 2. Preset Chips
        createPresetChips('principalPresets', 'principalInput', 'principalSlider', [
            { label: '₹5 Lakhs', value: 500000 },
            { label: '₹10 Lakhs', value: 1000000 },
            { label: '₹25 Lakhs', value: 2500000 },
            { label: '₹50 Lakhs', value: 5000000 },
            { label: '₹1 Crore', value: 10000000 }
        ], calculateAndDisplayEMI);

        createPresetChips('ratePresets', 'rateInput', 'rateSlider', [
            { label: '8.5% (Home)', value: 8.5 },
            { label: '9.5% (Car)', value: 9.5 },
            { label: '12% (Personal)', value: 12 }
        ], calculateAndDisplayEMI);

        createPresetChips('tenurePresets', 'tenureInput', 'tenureSlider', [
            { label: '5 Yrs', value: 5 },
            { label: '10 Yrs', value: 10 },
            { label: '15 Yrs', value: 15 },
            { label: '20 Yrs', value: 20 },
            { label: '30 Yrs', value: 30 }
        ], calculateAndDisplayEMI);

        // 3. Load from URL
        const urlParams = loadParamsFromURL();
        if (urlParams.p) principalInput.value = principalSlider.value = urlParams.p;
        else principalInput.value = principalSlider.value = 2500000;

        if (urlParams.r) rateInput.value = rateSlider.value = urlParams.r;
        else rateInput.value = rateSlider.value = 8.5;

        if (urlParams.t) {
            tenureInput.value = tenureSlider.value = urlParams.t;
            if (urlParams.type === 'm') tenureTypeMonths.checked = true;
        } else {
            tenureInput.value = tenureSlider.value = 20;
        }

        function calculateAndDisplayEMI() {
            const P = parseFloat(principalInput.value);
            const R = parseFloat(rateInput.value) / 100 / 12;
            const tenureValue = parseFloat(tenureInput.value);
            const isYears = tenureTypeYears.checked;
            const N = isYears ? tenureValue * 12 : tenureValue;

            if (isNaN(P) || isNaN(R) || isNaN(N) || P <= 0 || R < 0 || N <= 0) {
                initialState.style.display = 'flex';
                resultsState.style.display = 'none';
                amortizationSection.style.display = 'none';
                if (actionToolbar) actionToolbar.style.display = 'none';
                if (emiPieChart) emiPieChart.destroy();
                return;
            }

            initialState.style.display = 'none';
            resultsState.style.display = 'block';
            amortizationSection.style.display = 'block';
            if (actionToolbar) actionToolbar.style.display = 'flex';

            const emi = (P * R * Math.pow(1 + R, N)) / (Math.pow(1 + R, N) - 1);
            const totalAmountPayable = emi * N;
            const interestAmount = totalAmountPayable - P;

            emiResult.textContent = formatCurrency(emi);
            totalPrincipal.textContent = formatCurrency(P);
            totalInterest.textContent = formatCurrency(interestAmount);
            totalPayment.textContent = formatCurrency(totalAmountPayable);

            // Sync URL
            syncParamsToURL({
                p: P,
                r: rateInput.value,
                t: tenureValue,
                type: isYears ? 'y' : 'm'
            });

            // Pie Chart
            if (emiPieChart) emiPieChart.destroy();
            emiPieChart = new Chart(pieChartCanvas, {
                type: 'doughnut',
                data: {
                    labels: ['Principal Amount', 'Total Interest'],
                    datasets: [{
                        data: [P, interestAmount],
                        backgroundColor: ['#0d6efd', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: { legend: { display: false } }
                }
            });

            let balance = P;
            amortizationBody.innerHTML = '';
            const tableRows = [];

            if (isYears) {
                amortizationTitle.textContent = 'Yearly Amortization Schedule';
                amortizationHead.innerHTML = `<tr><th>Year</th><th>Principal Paid</th><th>Interest Paid</th><th>Total Payment</th><th>Balance at Year End</th></tr>`;
                let yearlyData = {};
                for (let i = 1; i <= N; i++) {
                    const year = Math.ceil(i / 12);
                    if (!yearlyData[year]) yearlyData[year] = { principal: 0, interest: 0 };
                    const interestForMonth = balance * R;
                    const principalForMonth = emi - interestForMonth;
                    balance -= principalForMonth;
                    yearlyData[year].principal += principalForMonth;
                    yearlyData[year].interest += interestForMonth;
                    yearlyData[year].balance = balance < 0 ? 0 : balance;
                }
                for (const year in yearlyData) {
                    const data = yearlyData[year];
                    const rowData = [
                        `Year ${year}`,
                        formatCurrency(data.principal),
                        formatCurrency(data.interest),
                        formatCurrency(data.principal + data.interest),
                        formatCurrency(data.balance)
                    ];
                    tableRows.push(rowData);
                    amortizationBody.innerHTML += `<tr><td>${year}</td><td>${formatCurrency(data.principal)}</td><td>${formatCurrency(data.interest)}</td><td>${formatCurrency(data.principal + data.interest)}</td><td><strong>${formatCurrency(data.balance)}</strong></td></tr>`;
                }
            } else {
                amortizationTitle.textContent = 'Monthly Amortization Schedule';
                amortizationHead.innerHTML = `<tr><th>Month</th><th>Principal Paid</th><th>Interest Paid</th><th>Total Payment</th><th>Balance at Month End</th></tr>`;
                for (let i = 1; i <= N; i++) {
                    const interestForMonth = balance * R;
                    const principalForMonth = emi - interestForMonth;
                    balance -= principalForMonth;
                    const rowData = [
                        `Month ${i}`,
                        formatCurrency(principalForMonth),
                        formatCurrency(interestForMonth),
                        formatCurrency(emi),
                        formatCurrency(balance < 0 ? 0 : balance)
                    ];
                    tableRows.push(rowData);
                    amortizationBody.innerHTML += `<tr><td>${i}</td><td>${formatCurrency(principalForMonth)}</td><td>${formatCurrency(interestForMonth)}</td><td>${formatCurrency(emi)}</td><td><strong>${formatCurrency(balance < 0 ? 0 : balance)}</strong></td></tr>`;
                }
            }

            lastEMIData = {
                P, rate: rateInput.value, tenureValue, isYears, emi,
                totalAmountPayable, interestAmount,
                tableHeaders: isYears ? ['Year', 'Principal Paid', 'Interest Paid', 'Total Payment', 'Balance'] : ['Month', 'Principal Paid', 'Interest Paid', 'Total Payment', 'Balance'],
                tableRows
            };
        }

        function updateTenureControls() {
            const isYears = tenureTypeYears.checked;
            let currentValue = parseFloat(tenureInput.value) || (isYears ? 1 : 12);
            if (isYears) {
                tenureSlider.min = 1; tenureSlider.max = 30; tenureInput.min = 1; tenureInput.max = 30;
                tenureUnitLabel.textContent = 'Years';
                if (currentValue > 30) tenureInput.value = Math.round(currentValue / 12);
            } else {
                tenureSlider.min = 1; tenureSlider.max = 360; tenureInput.min = 1; tenureInput.max = 360;
                tenureUnitLabel.textContent = 'Months';
                if (currentValue <= 30) tenureInput.value = currentValue * 12;
            }
            syncAndCalculate(tenureInput, tenureSlider);
        }

        tenureTypeYears.addEventListener('change', updateTenureControls);
        tenureTypeMonths.addEventListener('change', updateTenureControls);

        function syncAndCalculate(source, target) {
            target.value = source.value;
            calculateAndDisplayEMI();
        }

        principalSlider.addEventListener('input', () => syncAndCalculate(principalSlider, principalInput));
        principalInput.addEventListener('input', () => syncAndCalculate(principalInput, principalSlider));
        rateSlider.addEventListener('input', () => syncAndCalculate(rateSlider, rateInput));
        rateInput.addEventListener('input', () => syncAndCalculate(rateInput, rateSlider));
        tenureSlider.addEventListener('input', () => syncAndCalculate(tenureSlider, tenureInput));
        tenureInput.addEventListener('input', () => syncAndCalculate(tenureInput, tenureSlider));

        // Toolbar
        document.getElementById('btnExportPDF').addEventListener('click', () => {
            if (!lastEMIData) return;
            exportCalculatorPDF({
                docTitle: `Loan EMI Statement (${formatCurrency(lastEMIData.P)} @ ${lastEMIData.rate}% for ${lastEMIData.tenureValue} ${lastEMIData.isYears ? 'Yrs' : 'Mos'})`,
                summaryData: [
                    { label: 'Monthly EMI', value: formatCurrency(lastEMIData.emi), highlight: true },
                    { label: 'Principal Loan', value: formatCurrency(lastEMIData.P) },
                    { label: 'Total Interest', value: formatCurrency(lastEMIData.interestAmount) },
                    { label: 'Total Payment', value: formatCurrency(lastEMIData.totalAmountPayable) }
                ],
                tableHeaders: lastEMIData.tableHeaders,
                tableRows: lastEMIData.tableRows,
                filename: 'loan_emi_schedule'
            });
        });

        document.getElementById('btnExportCSV').addEventListener('click', () => {
            exportTableToCSV('loan_amortization_schedule', 'amortizationTable');
        });

        document.getElementById('btnShareWA').addEventListener('click', () => {
            if (!lastEMIData) return;
            const summary = `🏠 *Loan Amount:* ${formatCurrency(lastEMIData.P)}\n📊 *Interest Rate:* ${lastEMIData.rate}%\n⏳ *Tenure:* ${lastEMIData.tenureValue} ${lastEMIData.isYears ? 'Years' : 'Months'}\n\n💳 *Monthly EMI:* ${formatCurrency(lastEMIData.emi)}\n🔴 *Total Interest:* ${formatCurrency(lastEMIData.interestAmount)}\n💵 *Total Payable:* ${formatCurrency(lastEMIData.totalAmountPayable)}`;
            shareViaWhatsApp('Loan EMI Calculation Schedule', summary);
        });

        document.getElementById('btnCopyLink').addEventListener('click', copyShareableURL);

        document.getElementById('btnSaveCalc').addEventListener('click', () => {
            if (!lastEMIData) return;
            const name = prompt('Enter a label (e.g. "SBI Home Loan 25L")', `EMI ${formatCurrency(lastEMIData.P)} (${lastEMIData.tenureValue}Y)`);
            if (name) {
                saveCalculation(name, {
                    emi: formatCurrency(lastEMIData.emi),
                    loanAmount: formatCurrency(lastEMIData.P)
                });
            }
        });

        calculateAndDisplayEMI();
    });
</script>

<%- include('partials/footer') %>
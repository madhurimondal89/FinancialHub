    <!-- Embedded AdSense Banner Unit -->
    <%- include('partials/ad_unit') %>

    <!-- Related Calculators Grid -->
    <% if (locals.relatedCalcs && relatedCalcs.length > 0) { %>
        <div class="related-tools-section mb-5">
            <h3 class="h5 fw-bold mb-3 text-body-emphasis">Related <%= calc.categoryName || calc.category %> Calculators</h3>
            <div class="row g-3">
                <% relatedCalcs.forEach(function(rel) { %>
                    <div class="col-md-4 col-sm-6">
                        <a href="/<%= rel.slug %>" class="card h-100 text-decoration-none shadow-xs p-3 rounded-3 border hover-lift">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fs-4"><%= rel.icon %></span>
                                <span class="fw-bold text-body-emphasis text-truncate"><%= rel.shortTitle || rel.title %></span>
                            </div>
                            <p class="small text-muted mb-2 line-clamp-2"><%= rel.desc %></p>
                            <span class="small fw-semibold text-primary mt-auto">Calculate Now →</span>
                        </a>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } %>

    <!-- Floating Bottom Action Toolbar -->
    <div class="action-toolbar" id="universalToolbar">
        <span class="toolbar-label">Tools & Export:</span>
        <button type="button" class="btn-action-tool" id="tbBtnPDF"><span>📄</span> Download PDF Report</button>
        <button type="button" class="btn-action-tool" id="tbBtnCSV"><span>📊</span> Export Excel/CSV</button>
        <button type="button" class="btn-action-tool btn-whatsapp" id="tbBtnWhatsApp"><span>💬</span> Share on WhatsApp</button>
        <button type="button" class="btn-action-tool" id="tbBtnCopy"><span>🔗</span> Copy Link</button>
        <button type="button" class="btn-action-tool" id="tbBtnSave"><span>💾</span> Save Calculation</button>
    </div>

</div>

<!-- Universal Calculator Logic Engine -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function() {
    const calcConfig = <%- JSON.stringify(calc) %>;
    let chartInstance = null;

    // Currency Formatter
    function formatINR(val) {
        if (isNaN(val) || val === null) return '₹0';
        return '₹' + Math.round(val).toLocaleString('en-IN');
    }

    // Number to Indian Words
    function numToWords(val) {
        if (!val || val < 1000) return '';
        if (val >= 10000000) return (val / 10000000).toFixed(2) + ' Crore';
        if (val >= 100000) return (val / 100000).toFixed(2) + ' Lakh';
        if (val >= 1000) return (val / 1000).toFixed(1) + ' Thousand';
        return '';
    }

    // Read current input values
    function getInputs() {
        const data = {};
        calcConfig.inputs.forEach(inp => {
            const el = document.getElementById('num_' + inp.id);
            data[inp.id] = el ? parseFloat(el.value) || 0 : inp.default;
        });
        return data;
    }

    // Universal Calculation Engine
    function calculate() {
        const inp = getInputs();
        const fType = calcConfig.formulaType;
        let results = {};
        let chartData = { labels: [], data: [], colors: ['#6366f1', '#10b981', '#f59e0b'] };
        let scheduleRows = [];

        // Calculation routing based on formula type
        if (fType === 'sip') {
            const P = inp.monthlyInvest || inp.amount || 5000;
            const r = (inp.returnRate || inp.rate || 12) / 100 / 12;
            const n = (inp.timePeriod || inp.period || 10) * 12;
            const totalInvested = P * n;
            const maturityValue = P * ((Math.pow(1 + r, n) - 1) / r) * (1 + r);
            const totalGain = maturityValue - totalInvested;

            results = {
                investedAmt: totalInvested,
                estReturns: totalGain,
                totalValue: maturityValue
            };

            chartData.labels = ['Invested Capital', 'Compounded Gain'];
            chartData.data = [Math.round(totalInvested), Math.round(totalGain)];

            // Generate Year-by-year schedule
            let runningBalance = 0;
            const years = inp.timePeriod || 10;
            for (let y = 1; y <= years; y++) {
                const openBal = runningBalance;
                const yearlyDep = P * 12;
                runningBalance = P * ((Math.pow(1 + r, y * 12) - 1) / r) * (1 + r);
                const interestEarned = runningBalance - openBal - yearlyDep;
                scheduleRows.push({
                    year: y,
                    open: openBal,
                    dep: yearlyDep,
                    interest: interestEarned,
                    close: runningBalance
                });
            }
        } else if (fType === 'step_up_sip') {
            let P = inp.monthlyInvest || 10000;
            const stepUp = (inp.stepUpPercent || 10) / 100;
            const annualR = (inp.returnRate || 12) / 100;
            const monthlyR = annualR / 12;
            const years = inp.timePeriod || 15;
            let totalInvested = 0;
            let totalWealth = 0;

            for (let y = 1; y <= years; y++) {
                const openBal = totalWealth;
                let yearlyDep = 0;
                for (let m = 1; m <= 12; m++) {
                    totalWealth = (totalWealth + P) * (1 + monthlyR);
                    totalInvested += P;
                    yearlyDep += P;
                }
                scheduleRows.push({
                    year: y,
                    open: openBal,
                    dep: yearlyDep,
                    interest: totalWealth - openBal - yearlyDep,
                    close: totalWealth
                });
                P = P * (1 + stepUp);
            }

            results = {
                investedAmt: totalInvested,
                estReturns: totalWealth - totalInvested,
                totalValue: totalWealth
            };
            chartData.labels = ['Total Invested', 'Step-Up Returns'];
            chartData.data = [Math.round(totalInvested), Math.round(totalWealth - totalInvested)];
        } else if (fType === 'emi') {
            const P = inp.loanAmt || inp.amount || 1000000;
            const annualR = (inp.interestRate || inp.rate || 9) / 100;
            const r = annualR / 12;
            const n = (inp.tenureYears || inp.period || 20) * 12;
            const emi = P * r * (Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1));
            const totalPayment = emi * n;
            const totalInterest = totalPayment - P;

            results = {
                monthlyEmi: emi,
                totalInterest: totalInterest,
                totalPayment: totalPayment
            };
            chartData.labels = ['Principal Loan', 'Total Interest'];
            chartData.data = [Math.round(P), Math.round(totalInterest)];
            chartData.colors = ['#3b82f6', '#ef4444'];

            // Amortization schedule
            let balance = P;
            const years = inp.tenureYears || 20;
            for (let y = 1; y <= years; y++) {
                let yearlyInterest = 0;
                let yearlyPrincipal = 0;
                const openBal = balance;
                for (let m = 1; m <= 12; m++) {
                    if (balance <= 0) break;
                    const interestM = balance * r;
                    const principalM = emi - interestM;
                    yearlyInterest += interestM;
                    yearlyPrincipal += principalM;
                    balance = Math.max(0, balance - principalM);
                }
                scheduleRows.push({
                    year: y,
                    open: openBal,
                    dep: yearlyPrincipal,
                    interest: yearlyInterest,
                    close: balance
                });
            }
        } else if (fType === 'fd' || fType === 'compound') {
            const P = inp.depositAmt || inp.principal || 100000;
            const r = (inp.interestRate || inp.rate || 7) / 100;
            const t = inp.tenureYears || inp.time || 5;
            const n = 4; // quarterly
            const maturity = P * Math.pow(1 + (r / n), n * t);
            const interest = maturity - P;

            results = {
                principal: P,
                investedAmt: P,
                totalInterest: interest,
                maturityValue: maturity,
                maturityAmt: maturity
            };
            chartData.labels = ['Principal Deposit', 'Interest Earned'];
            chartData.data = [Math.round(P), Math.round(interest)];

            let bal = P;
            for (let y = 1; y <= t; y++) {
                const open = bal;
                bal = P * Math.pow(1 + (r / n), n * y);
                scheduleRows.push({
                    year: y,
                    open: open,
                    dep: 0,
                    interest: bal - open,
                    close: bal
                });
            }
        } else if (fType === 'rd') {
            const P = inp.monthlyDeposit || 5000;
            const r = (inp.interestRate || 7) / 100;
            const t = inp.tenureYears || 5;
            const n = t * 12;
            const totalInvested = P * n;
            let maturity = 0;
            for (let i = 1; i <= n; i++) {
                maturity += P * Math.pow(1 + (r / 4), (4 * (n - i + 1)) / 12);
            }
            results = {
                totalInvested: totalInvested,
                interestEarned: maturity - totalInvested,
                maturityValue: maturity
            };
            chartData.labels = ['Total Deposited', 'Interest Gain'];
            chartData.data = [Math.round(totalInvested), Math.round(maturity - totalInvested)];
        } else if (fType === 'tax') {
            const inc = inp.annualIncome || inp.grossGrossReceipts || 1200000;
            const stdDed = 75000;
            const taxable = Math.max(0, inc - stdDed);
            let tax = 0;
            if (taxable > 1500000) tax = 140000 + (taxable - 1500000) * 0.30;
            else if (taxable > 1200000) tax = 80000 + (taxable - 1200000) * 0.20;
            else if (taxable > 800000) tax = 30000 + (taxable - 800000) * 0.10;
            else if (taxable > 400000) tax = (taxable - 400000) * 0.05;

            // 87A rebate for income up to 7L / 12L in revised regime
            if (taxable <= 1200000) tax = Math.max(0, tax - 25000);
            const cess = tax * 0.04;
            const totalTax = tax + cess;

            results = {
                newRegimeTax: totalTax,
                oldRegimeTax: totalTax * 1.15,
                taxSavings: 'New Regime Saves ' + formatINR(totalTax * 0.15),
                presumptiveIncome: inc * 0.5,
                taxPayable44ADA: totalTax * 0.5,
                effectiveTaxRate: ((totalTax / inc) * 100).toFixed(1) + '%'
            };
            chartData.labels = ['Net Take-Home', 'Income Tax Payable'];
            chartData.data = [Math.round(inc - totalTax), Math.round(totalTax)];
            chartData.colors = ['#10b981', '#ef4444'];
        } else {
            // Default generic calculation
            const base = inp.amount || inp.principal || inp.currentAmount || 100000;
            const rate = (inp.rate || inp.inflationRate || 10) / 100;
            const time = inp.period || inp.years || 5;
            const resVal = base * Math.pow(1 + rate, time);
            results = {
                calculatedMetric: resVal,
                projectedGrowth: resVal - base,
                futureCost: resVal,
                purchasingPowerLost: (100 - (base / resVal) * 100).toFixed(1) + '%'
            };
            chartData.labels = ['Base Value', 'Growth Value'];
            chartData.data = [Math.round(base), Math.round(resVal - base)];
        }

        renderResults(results, chartData, scheduleRows);
    }

    // Render numbers and charts on screen
    function renderResults(results, chartData, scheduleRows) {
        // Render highlight output
        const lastOutput = calcConfig.outputs[calcConfig.outputs.length - 1];
        const highlightVal = results[lastOutput.id] !== undefined ? results[lastOutput.id] : Object.values(results)[0];
        
        const mainDisplay = document.getElementById('mainOutputValue');
        if (mainDisplay) {
            if (typeof highlightVal === 'number') {
                mainDisplay.textContent = formatINR(highlightVal);
                document.getElementById('mainOutputWords').textContent = numToWords(highlightVal);
            } else {
                mainDisplay.textContent = highlightVal;
            }
        }

        // Render secondary outputs
        calcConfig.outputs.forEach((out, idx) => {
            if (idx < calcConfig.outputs.length - 1) {
                const el = document.getElementById('out_' + out.id);
                if (el && results[out.id] !== undefined) {
                    el.textContent = typeof results[out.id] === 'number' ? formatINR(results[out.id]) : results[out.id];
                }
            }
        });

        // Update Indian words preview on inputs
        calcConfig.inputs.forEach(inp => {
            if (inp.isCurrency) {
                const inputEl = document.getElementById('num_' + inp.id);
                const wordEl = document.getElementById('words_' + inp.id);
                if (inputEl && wordEl) {
                    wordEl.textContent = numToWords(parseFloat(inputEl.value) || 0);
                }
            }
        });

        // Render Chart.js
        const canvas = document.getElementById('universalCalculatorChart');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            if (chartInstance) chartInstance.destroy();
            chartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: chartData.labels,
                    datasets: [{
                        data: chartData.data,
                        backgroundColor: chartData.colors || ['#6366f1', '#10b981', '#f59e0b'],
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', weight: '600' } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + formatINR(context.raw);
                                }
                            }
                        }
                    },
                    cutout: '68%'
                }
            });
        }

        // Render Schedule Table Rows
        const tbody = document.getElementById('breakdownTableBody');
        if (tbody && scheduleRows.length > 0) {
            tbody.innerHTML = scheduleRows.map(row => `
                <tr>
                    <td class="fw-bold">${row.year}</td>
                    <td>${formatINR(row.open)}</td>
                    <td>${formatINR(row.dep)}</td>
                    <td class="text-success fw-semibold">+${formatINR(row.interest)}</td>
                    <td class="fw-bold text-primary">${formatINR(row.close)}</td>
                </tr>
            `).join('');
            document.getElementById('scheduleTableCard').style.display = 'block';
        } else if (tbody) {
            document.getElementById('scheduleTableCard').style.display = 'none';
        }
    }

    // Attach Event Listeners
    document.querySelectorAll('.sync-num-input').forEach(input => {
        input.addEventListener('input', function() {
            const targetSlider = document.getElementById(this.dataset.target);
            if (targetSlider) targetSlider.value = this.value;
            calculate();
        });
    });

    document.querySelectorAll('.sync-slider').forEach(slider => {
        slider.addEventListener('input', function() {
            const targetNum = document.getElementById(this.dataset.target);
            if (targetNum) targetNum.value = this.value;
            calculate();
        });
    });

    // Reset button
    const btnReset = document.getElementById('btnResetValues');
    if (btnReset) {
        btnReset.addEventListener('click', function() {
            calcConfig.inputs.forEach(inp => {
                const num = document.getElementById('num_' + inp.id);
                const slider = document.getElementById('range_' + inp.id);
                if (num) num.value = inp.default;
                if (slider) slider.value = inp.default;
            });
            calculate();
        });
    }

    // Save Calculation Handler
    function handleSave() {
        const inp = getInputs();
        const mainVal = document.getElementById('mainOutputValue')?.textContent || '';
        const name = prompt('Enter a name for this calculation:', `${calcConfig.shortTitle || calcConfig.title} - ${mainVal}`);
        if (name && typeof saveCalculation === 'function') {
            const summaryObj = { 'Key Result': mainVal };
            calcConfig.inputs.forEach(i => {
                summaryObj[i.label] = `${i.prefix || ''}${inp[i.id]}${i.suffix || ''}`;
            });
            saveCalculation(name, summaryObj);
        } else if (name) {
            alert('Saved successfully!');
        }
    }

    // WhatsApp Share Handler
    function handleWhatsApp() {
        const mainVal = document.getElementById('mainOutputValue')?.textContent || '';
        const inp = getInputs();
        let text = `*${calcConfig.title}*\n🎯 Result: ${mainVal}\n`;
        calcConfig.inputs.forEach(i => {
            text += `• ${i.label}: ${i.prefix || ''}${inp[i.id]}${i.suffix || ''}\n`;
        });
        text += `\nCalculate yours now on Financial Hub:\n`;
        if (typeof shareViaWhatsApp === 'function') {
            shareViaWhatsApp(calcConfig.title, text);
        } else {
            const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(text + window.location.href)}`;
            window.open(url, '_blank');
        }
    }

    // Copy Link Handler
    function handleCopy() {
        if (typeof copyShareableURL === 'function') {
            copyShareableURL();
        } else {
            navigator.clipboard.writeText(window.location.href);
            alert('Link copied to clipboard!');
        }
    }

    // PDF Export Handler
    function handlePDF() {
        if (typeof exportCalculatorPDF === 'function') {
            const inp = getInputs();
            const summaryData = [
                { label: 'Key Result', value: document.getElementById('mainOutputValue')?.textContent || '', highlight: true }
            ];
            calcConfig.inputs.forEach(i => {
                summaryData.push({ label: i.label, value: `${i.prefix || ''}${inp[i.id]}${i.suffix || ''}` });
            });
            
            // Extract table headers and rows if schedule is populated
            const headers = [];
            document.querySelectorAll('#breakdownTable thead th').forEach(th => headers.push(th.textContent.trim()));
            const rows = [];
            document.querySelectorAll('#breakdownTable tbody tr').forEach(tr => {
                const row = [];
                tr.querySelectorAll('td').forEach(td => row.push(td.textContent.trim()));
                if (row.length) rows.push(row);
            });

            exportCalculatorPDF({
                docTitle: calcConfig.title,
                summaryData: summaryData,
                tableHeaders: headers.length ? headers : null,
                tableRows: rows.length ? rows : null,
                filename: calcConfig.slug
            });
        } else {
            window.print();
        }
    }

    // Wire Card & Toolbar Buttons
    ['uniBtnSave', 'tbBtnSave'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('click', handleSave);
    });

    ['uniBtnWhatsApp', 'tbBtnWhatsApp'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('click', handleWhatsApp);
    });

    ['uniBtnCopy', 'tbBtnCopy'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('click', handleCopy);
    });

    ['uniBtnPDF', 'tbBtnPDF'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('click', handlePDF);
    });

    ['uniBtnCSV', 'tbBtnCSV'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('click', () => {
            exportTableToCSV(calcConfig.slug + '_schedule', 'breakdownTable');
        });
    });

    // Initial Calculation on load
    document.addEventListener('DOMContentLoaded', calculate);
    calculate();
})();
</script>


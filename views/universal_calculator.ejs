<%- include('partials/header') %>

<div class="calculator-page-container container my-4 my-md-5">
    
    <!-- Breadcrumb & Status Strip -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/category/<%= calc.category %>" class="text-decoration-none text-capitalize"><%= calc.categoryName || calc.category %></a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= calc.shortTitle || calc.title %></li>
        </ol>
    </nav>

    <!-- Page Title Header -->
    <div class="page-title-section mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="calc-hero-icon"><%= calc.icon || '📊' %></span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-bold text-uppercase"><%= calc.badge || 'SMART TOOL' %></span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">⚡ Instant Live Results</span>
        </div>
        <h1 class="calc-page-heading mb-2"><%= calc.title %></h1>
        <p class="calc-page-desc text-muted"><%= calc.desc %></p>
    </div>

    <!-- Main Calculator Interactive Grid -->
    <div class="row g-4 mb-5">
        
        <!-- Left: Dynamic Input Controls Card -->
        <div class="col-lg-6">
            <div class="card form-card shadow-sm p-4 p-md-4 rounded-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                    <h2 class="h5 fw-bold mb-0 text-body-emphasis">Adjust Parameters</h2>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold text-primary" id="btnResetValues">Reset to Default</button>
                </div>

                <form id="universalCalcForm" onsubmit="return false;">
                    <% calc.inputs.forEach(function(inp, index) { %>
                        <div class="calculator-input-group mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label for="num_<%= inp.id %>" class="form-label mb-0 fw-semibold text-secondary"><%= inp.label %></label>
                                <div class="input-group input-group-sm w-auto" style="max-width: 180px;">
                                    <% if (inp.prefix) { %>
                                        <span class="input-group-text bg-body-tertiary fw-bold text-secondary"><%= inp.prefix %></span>
                                    <% } %>
                                    <input type="number" 
                                           class="form-control text-end fw-bold sync-num-input" 
                                           id="num_<%= inp.id %>" 
                                           data-target="range_<%= inp.id %>" 
                                           data-input-id="<%= inp.id %>"
                                           data-is-currency="<%= inp.isCurrency ? 'true' : 'false' %>"
                                           min="<%= inp.min %>" 
                                           max="<%= inp.max %>" 
                                           step="<%= inp.step %>" 
                                           value="<%= inp.default %>">
                                    <% if (inp.suffix) { %>
                                        <span class="input-group-text bg-body-tertiary text-secondary"><%= inp.suffix.trim() %></span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Range Slider -->
                            <input type="range" 
                                   class="form-range sync-slider" 
                                   id="range_<%= inp.id %>" 
                                   data-target="num_<%= inp.id %>" 
                                   data-input-id="<%= inp.id %>"
                                   min="<%= inp.min %>" 
                                   max="<%= inp.max %>" 
                                   step="<%= inp.step %>" 
                                   value="<%= inp.default %>">

                            <div class="d-flex justify-content-between text-muted" style="font-size: 0.75rem;">
                                <span><%= inp.prefix || '' %><%= inp.min.toLocaleString('en-IN') %><%= inp.suffix || '' %></span>
                                <% if (inp.isCurrency) { %>
                                    <span class="words-helper text-primary fw-medium" id="words_<%= inp.id %>"></span>
                                <% } %>
                                <span><%= inp.prefix || '' %><%= inp.max.toLocaleString('en-IN') %><%= inp.suffix || '' %></span>
                            </div>
                        </div>
                    <% }); %>
                </form>

                <!-- Quick Presets -->
                <div class="preset-chips-wrap pt-2 mt-auto border-top">
                    <span class="text-muted small fw-semibold me-2">Quick Presets:</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 me-1 preset-btn" data-multiplier="0.5">Conservative</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 me-1 preset-btn active" data-multiplier="1.0">Standard</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 preset-btn" data-multiplier="1.5">Aggressive</button>
                </div>
            </div>
        </div>

        <!-- Right: Results, Visual Chart & Highlights -->
        <div class="col-lg-6">
            <div class="card summary-card shadow-sm p-4 p-md-4 rounded-4 h-100">
                
                <!-- Primary Highlight Box -->
                <div class="highlight-result-card p-3 p-md-4 rounded-3 text-center mb-4">
                    <span class="text-uppercase fw-bold letter-spacing-1 small text-muted d-block mb-1" id="mainOutputLabel"><%= calc.outputs[calc.outputs.length - 1].label %></span>
                    <div class="display-6 fw-extrabold text-primary mb-1 text-break" id="mainOutputValue">₹0</div>
                    <div class="small text-muted" id="mainOutputWords"></div>
                </div>

                <!-- Secondary Outputs Grid -->
                <div class="row g-3 mb-4" id="secondaryOutputsContainer">
                    <% calc.outputs.forEach(function(out, index) { %>
                        <% if (index < calc.outputs.length - 1) { %>
                            <div class="col-6">
                                <div class="p-3 bg-body-tertiary rounded-3 border">
                                    <span class="d-block small text-muted fw-semibold mb-1"><%= out.label %></span>
                                    <span class="h5 fw-bold text-body-emphasis mb-0 d-block text-truncate" id="out_<%= out.id %>">₹0</span>
                                </div>
                            </div>
                        <% } %>
                    <% }); %>
                </div>

                <!-- Chart Container -->
                <div class="chart-box position-relative my-auto" style="min-height: 220px; max-height: 250px;">
                    <canvas id="universalCalculatorChart"></canvas>
                </div>

                <!-- Actions Toolbar -->
                <div class="d-flex flex-wrap align-items-center justify-content-center mt-3 pt-3 border-top gap-2">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" id="uniBtnPDF" title="Download Official PDF Report">
                        📄 Download PDF Report
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" id="uniBtnCSV" title="Export Excel / CSV Spreadsheet">
                        📊 Export Excel/CSV
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" id="uniBtnWhatsApp" title="Share on WhatsApp">
                        💬 Share on WhatsApp
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" id="uniBtnCopy" title="Copy Link">
                        🔗 Copy Link
                    </button>
                    <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3" id="uniBtnSave" title="Save Calculation">
                        💾 Save Calculation
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Year-by-Year Schedule / Amortization Table -->
    <div class="card shadow-sm rounded-4 p-4 mb-5" id="scheduleTableCard">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
            <div>
                <h3 class="h5 fw-bold mb-1 text-body-emphasis">📅 Year-on-Year Growth & Payment Schedule</h3>
                <p class="text-muted small mb-0">Detailed breakdown of principal, compounding returns, and year-end balance.</p>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" id="btnToggleTable">
                Expand Full Schedule
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center" id="breakdownTable">
                <thead class="table-light">
                    <tr>
                        <th>Year</th>
                        <th>Opening Balance</th>
                        <th>Deposited / Paid in Year</th>
                        <th>Interest / Growth Earned</th>
                        <th>Closing Wealth Balance</th>
                    </tr>
                </thead>
                <tbody id="breakdownTableBody">
                    <!-- Injected dynamically by JS -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Editorial Content, Formula & FAQs -->
    <article class="card shadow-sm rounded-4 p-4 p-md-5 mb-5">
        <h2 class="h3 fw-bold text-body-emphasis mb-3">Understanding the <%= calc.title %></h2>
        <p class="lead text-secondary mb-4" style="font-size: 1.05rem;"><%= calc.desc %> Designed specifically for Indian investors, salaried professionals, business founders, and taxpayers under the latest RBI and Income Tax guidelines for FY 2026-27.</p>
        
        <!-- Mathematical Formula Breakdown Box -->
        <div class="card bg-body-tertiary border rounded-3 p-4 mb-4">
            <h3 class="h5 fw-bold text-body-emphasis mb-2">📐 Mathematical Formula & Calculation Logic</h3>
            <p class="small text-muted mb-3">The underlying actuarial compounding and financial formula executed in real-time by this tool:</p>
            
            <div class="bg-body p-3 rounded-2 border font-monospace text-primary fw-bold mb-3" style="font-size: 1.05rem; overflow-x: auto;">
                <% if (calc.formulaType === 'sip' || calc.formulaType === 'step_up_sip') { %>
                    M = P × [ (1 + i)ⁿ - 1 ] / i × (1 + i)
                <% } else if (calc.formulaType === 'emi') { %>
                    EMI = [P × r × (1 + r)ⁿ] / [ (1 + r)ⁿ - 1 ]
                <% } else if (calc.formulaType === 'fd' || calc.formulaType === 'rd' || calc.formulaType === 'compound') { %>
                    A = P × (1 + r/n)ⁿᵗ
                <% } else { %>
                    Result = Base_Amount × [ 1 + (Rate_p.a. × Tenure) / 100 ]
                <% } %>
            </div>

            <div class="row g-2 small text-muted">
                <div class="col-sm-6"><strong>P:</strong> Principal / Initial Capital or Periodic Investment</div>
                <div class="col-sm-6"><strong>r / i:</strong> Periodic Rate of Return / Interest Rate</div>
                <div class="col-sm-6"><strong>n / t:</strong> Number of Compounding Cycles / Tenure in Months/Years</div>
                <div class="col-sm-6"><strong>M / A:</strong> Total Wealth Accumulation / Maturity Value</div>
            </div>
        </div>

        <!-- Realistic Practical Case Study -->
        <div class="my-4 p-3 bg-body-tertiary rounded-3 border-start border-4 border-primary">
            <h3 class="h6 fw-bold text-primary mb-1">💡 Practical Example (Case Study)</h3>
            <p class="mb-0 small text-muted">
                <% if (calc.formulaType === 'sip' || calc.formulaType === 'step_up_sip') { %>
                    If an investor contributes <strong>₹10,000 per month</strong> in an equity mutual fund delivering an average historical return of <strong>12% p.a.</strong> over <strong>15 years</strong>, the total amount invested will be <strong>₹18,00,000</strong>, while the estimated wealth accumulated will grow to over <strong>₹50,45,760</strong> (compounded wealth gain of ₹32,45,760).
                <% } else if (calc.formulaType === 'emi') { %>
                    If you take a home loan of <strong>₹50,00,000</strong> at <strong>8.5% interest rate</strong> for a <strong>20-year tenure</strong>, your monthly EMI will be <strong>₹43,391</strong>. Total interest paid will be ₹54,13,879, making your total repayment ₹1,04,13,879.
                <% } else { %>
                    For a base allocation of <strong>₹1,00,000</strong> invested at <strong>8% annual compounding return</strong> over <strong>10 years</strong>, the final accumulated corpus reaches <strong>₹2,15,892</strong> with zero additional capital additions.
                <% } %>
            </p>
        </div>

        <!-- Key Strategic Benefits & Tax Guidelines -->
        <div class="row g-3 my-3">
            <div class="col-md-6">
                <div class="p-3 border rounded-3 h-100 bg-body">
                    <h4 class="h6 fw-bold text-body-emphasis mb-2">🎯 Strategic Benefits</h4>
                    <ul class="small text-muted ps-3 mb-0">
                        <li>Eliminates human calculation errors with sub-second accuracy.</li>
                        <li>Dynamic visualization with interactive Donut charts and growth schedule.</li>
                        <li>Supports annual step-up adjustments to counter long-term inflation.</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded-3 h-100 bg-body">
                    <h4 class="h6 fw-bold text-body-emphasis mb-2">🧾 Tax Implications (FY 2026-27)</h4>
                    <ul class="small text-muted ps-3 mb-0">
                        <li>Equity Mutual Funds: 12.5% Long-Term Capital Gains (LTCG) above ₹1.25 Lakh exemption.</li>
                        <li>Debt Funds & Bank FDs: Interest taxed at applicable income tax slab rates.</li>
                        <li>Section 80C / 80CCD: Up to ₹2,00,000 tax deduction under Old Tax Regime.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <h3 class="h4 fw-bold text-body-emphasis mt-5 mb-3">Frequently Asked Questions (FAQs)</h3>
        <div class="accordion" id="calcFaqAccordion">
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        How is the calculation performed in the <%= calc.title %>?
                    </button>
                </h4>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#calcFaqAccordion">
                    <div class="accordion-body text-muted">
                        Our engine computes results using standardized actuarial algorithms factoring in periodic compounding intervals (monthly, quarterly, or annually) aligned with RBI, SEBI, and CBDT benchmarks.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        Are my financial numbers safe and private?
                    </button>
                </h4>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#calcFaqAccordion">
                    <div class="accordion-body text-muted">
                        Yes, 100%! All calculations execute strictly client-side inside your browser. No financial data, salary info, or investment numbers are ever uploaded or transmitted to any server.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        Can I download the detailed amortization schedule in PDF and Excel?
                    </button>
                </h4>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#calcFaqAccordion">
                    <div class="accordion-body text-muted">
                        Yes. Simply click the "📄 Download PDF Report" button or "📊 Export Excel/CSV" button in the Action Toolbar below to save complete year-by-year schedules.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                        Is this updated for the latest FY 2026-27 tax rules?
                    </button>
                </h4>
                <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#calcFaqAccordion">
                    <div class="accordion-body text-muted">
                        Yes, all calculations reflect the latest Union Budget provisions including the revised New Tax Regime slab rates, updated standard deductions (₹75,000), and 12.5% LTCG capital gains rates.
                    </div>
                </div>
            </div>
        </div>
    </article>

    <!-- Embedded FAQPage JSON-LD for Google Rich Snippets -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {

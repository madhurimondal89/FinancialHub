<%- include('partials/header') %>

<div class="form-card">
    <h3 class="mb-1">🏢 HRA Exemption Calculator</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">Calculate your House Rent Allowance (HRA) tax exemption under Section 10(13A)</p>
<%- include('partials/ad_unit') %>

    <div class="row g-5">
        <!-- Left: Inputs -->
        <div class="col-lg-6">
            <div class="mb-3">
                <label class="form-label">Basic Salary (Annual)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="basicSalary" placeholder="e.g., 600000" oninput="calculate()">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">HRA Received from Employer (Annual)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="hraReceived" placeholder="e.g., 240000" oninput="calculate()">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Actual Rent Paid (Annual)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input type="number" class="form-control" id="rentPaid" placeholder="e.g., 180000" oninput="calculate()">
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label">City of Residence</label>
                <select class="form-select" id="cityType" onchange="calculate()">
                    <option value="metro">Metro City (Delhi, Mumbai, Kolkata, Chennai) — 50%</option>
                    <option value="nonmetro">Non-Metro City — 40%</option>
                </select>
            </div>

            <div class="highlight-box">
                <h4>📌 HRA Exemption Rule</h4>
                <p>The exemption is the <strong>minimum</strong> of three amounts:<br>
                1️⃣ Actual HRA received<br>
                2️⃣ Actual rent paid − 10% of Basic<br>
                3️⃣ 50% (Metro) / 40% (Non-Metro) of Basic</p>
            </div>
        </div>

        <!-- Right: Results -->
        <div class="col-lg-6">
            <div id="initialState" class="d-flex align-items-center justify-content-center text-center p-5" style="background:rgba(15,23,42,0.5); border:1px solid var(--border); border-radius:14px; min-height:320px;">
                <div>
                    <div style="font-size:3rem;">🏠</div>
                    <p style="color:var(--text-muted); margin-top:12px;">Enter your salary and rent details to calculate HRA exemption</p>
                </div>
            </div>

            <div id="resultsState" style="display:none;">
                <div class="emi-result-display">
                    <p class="label">HRA Exemption (Tax-Free)</p>
                    <p class="amount" id="hraExempt">₹0</p>
                </div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">HRA Received</div><div class="value" id="r1">₹0</div></div>
                    <div class="summary-item"><div class="label">Rent − 10% of Basic</div><div class="value" id="r2">₹0</div></div>
                    <div class="summary-item"><div class="label">50%/40% of Basic</div><div class="value" id="r3">₹0</div></div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item"><div class="label" style="color:var(--accent);">✅ HRA Exempt (Minimum)</div><div class="value" style="color:var(--accent);" id="r4">₹0</div></div>
                    <div class="summary-item"><div class="label" style="color:var(--accent-red);">⚠️ Taxable HRA</div><div class="value" style="color:var(--accent-red);" id="r5">₹0</div></div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item"><div class="label">Tax Saved (30% slab)</div><div class="value" style="color:var(--gold); font-weight:800;" id="r6">₹0</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="info-accordion">
        <div class="accordion" id="hraAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#hraC1">Who Can Claim HRA Exemption?</button></h2>
                <div id="hraC1" class="accordion-collapse collapse show" data-bs-parent="#hraAccordion">
                    <div class="accordion-body">
                        <ul>
                            <li>You must be a <strong>salaried employee</strong> receiving HRA as part of salary</li>
                            <li>You must be <strong>paying rent</strong> for a residential accommodation</li>
                            <li>You should <strong>not own</strong> the house you are living in</li>
                            <li>If annual rent exceeds ₹1,00,000, you must provide <strong>landlord's PAN</strong></li>
                            <li>HRA exemption is <strong>only available under Old Tax Regime</strong> — not in New Regime</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="related-section">
        <h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/income-tax-calculator" class="related-card"><span class="icon">📋</span><div class="title">Income Tax</div><div class="desc">Old vs New Tax Regime</div></a></div>
            <div class="col-md-4"><a href="/budget-calculator" class="related-card"><span class="icon">📅</span><div class="title">Budget Planner</div><div class="desc">Plan income & expenses</div></a></div>
            <div class="col-md-4"><a href="/emi-calculator" class="related-card"><span class="icon">🏠</span><div class="title">EMI Calculator</div><div class="desc">Home loan EMI vs rent</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>

<!-- Save & Share Toolbar -->
<div class="action-toolbar" id="hraToolbar" style="display:none;">
    <span class="toolbar-label">Tools:</span>
    <button type="button" class="btn-action-tool" id="hraBtnSave">💾 Save Calculation</button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="hraBtnShare">💬 Share on WhatsApp</button>
    <button type="button" class="btn-action-tool" id="hraBtnCopy">🔗 Copy Link</button>
</div>

<script>
const fmt = (n) => new Intl.NumberFormat('en-IN', { style:'currency', currency:'INR', maximumFractionDigits:0 }).format(n);

function calculate() {
    const basic   = parseFloat(document.getElementById('basicSalary').value)  || 0;
    const hraRcvd = parseFloat(document.getElementById('hraReceived').value)   || 0;
    const rent    = parseFloat(document.getElementById('rentPaid').value)      || 0;
    const metro   = document.getElementById('cityType').value === 'metro';

    if (!basic || !hraRcvd || !rent) {
        document.getElementById('initialState').style.display = 'flex';
        document.getElementById('resultsState').style.display = 'none';
        return;
    }

    const rule1 = hraRcvd;
    const rule2 = Math.max(0, rent - (basic * 0.10));
    const rule3 = basic * (metro ? 0.50 : 0.40);
    const exempt = Math.min(rule1, rule2, rule3);
    const taxable = hraRcvd - exempt;
    const taxSaved = exempt * 0.30;

    document.getElementById('initialState').style.display = 'none';
    document.getElementById('resultsState').style.display = 'block';
    document.getElementById('hraToolbar').style.display = 'flex';

    document.getElementById('hraExempt').textContent = fmt(exempt);
    document.getElementById('r1').textContent = fmt(rule1);
    document.getElementById('r2').textContent = fmt(rule2);
    document.getElementById('r3').textContent = fmt(rule3) + (metro ? ' (50%)' : ' (40%)');
    document.getElementById('r4').textContent = fmt(exempt);
    document.getElementById('r5').textContent = fmt(taxable);
    document.getElementById('r6').textContent = fmt(taxSaved);
    window._lastHra = { basic, hraRcvd, rent, exempt, taxable, taxSaved, metro };
}
document.addEventListener('DOMContentLoaded', function(){
    document.getElementById('hraBtnSave').addEventListener('click', function(){
        const d = window._lastHra; if(!d) return;
        const name = prompt('Save this HRA calculation as:', 'HRA Exempt: ' + fmt(d.exempt));
        if(name) saveCalculation(name, { basic: fmt(d.basic), hraReceived: fmt(d.hraRcvd), rentPaid: fmt(d.rent), hraExemption: fmt(d.exempt), taxSaved: fmt(d.taxSaved) });
    });
    document.getElementById('hraBtnShare').addEventListener('click', function(){
        const d = window._lastHra; if(!d) return;
        shareViaWhatsApp('HRA Exemption Calculator', 'Basic: ' + fmt(d.basic) + '\nHRA Received: ' + fmt(d.hraRcvd) + '\nRent Paid: ' + fmt(d.rent) + '\nHRA Exemption: ' + fmt(d.exempt) + '\nTax Saved (30%): ' + fmt(d.taxSaved));
    });
    document.getElementById('hraBtnCopy').addEventListener('click', copyShareableURL);
});
</script>

<%- include('partials/footer') %>

<%- include('partials/header') %>
<div class="form-card">
    <h3 class="mb-1">📐 CAGR Calculator</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">Compound Annual Growth Rate — Measure true investment performance</p>
<%- include('partials/ad_unit') %>
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="mb-4">
                <label class="form-label">Initial Investment Value</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="initialVal" placeholder="e.g., 100000" oninput="calculate()"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Final Investment Value</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="finalVal" placeholder="e.g., 250000" oninput="calculate()"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Investment Period</label>
                <div class="input-group"><input type="number" class="form-control" id="years" placeholder="e.g., 5" step="0.5" oninput="calculate()"><span class="input-group-text" style="border-radius:0 var(--radius-sm) var(--radius-sm) 0;">Years</span></div>
            </div>
            <div class="highlight-box">
                <h4>📌 What is CAGR?</h4>
                <p>CAGR = (Final Value / Initial Value)^(1/years) − 1<br>It tells you the steady annual return rate, ignoring volatility.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div id="initialState" class="d-flex align-items-center justify-content-center text-center p-5" style="background:rgba(15,23,42,0.4);border:1px solid var(--border);border-radius:14px;min-height:300px;">
                <div><div style="font-size:3rem;">📐</div><p style="color:var(--text-muted);margin-top:12px;">Enter initial value, final value and period to calculate CAGR</p></div>
            </div>
            <div id="resultsState" style="display:none;">
                <div class="emi-result-display"><p class="label">CAGR</p><p class="amount" id="cagrResult">0%</p></div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">Initial Value</div><div class="value" id="r1">₹0</div></div>
                    <div class="summary-item"><div class="label">Final Value</div><div class="value" id="r2">₹0</div></div>
                    <div class="summary-item"><div class="label">Total Gain</div><div class="value" style="color:var(--accent);" id="r3">₹0</div></div>
                    <div class="summary-item"><div class="label">Absolute Return</div><div class="value" id="r4">0%</div></div>
                    <div class="summary-item"><div class="label">Period</div><div class="value" id="r5">0 Years</div></div>
                    <hr style="border-color:var(--border);">
                    <div class="summary-item"><div class="label" style="color:var(--gold); font-weight:700;">CAGR</div><div class="value" style="color:var(--gold); font-size:1.3rem; font-weight:800;" id="r6">0%</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="related-section"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/sip-calculator" class="related-card"><span class="icon">📊</span><div class="title">SIP Calculator</div><div class="desc">Mutual fund returns</div></a></div>
            <div class="col-md-4"><a href="/compound-interest" class="related-card"><span class="icon">📈</span><div class="title">Compound Interest</div><div class="desc">Power of compounding</div></a></div>
            <div class="col-md-4"><a href="/inflation-calculator" class="related-card"><span class="icon">💸</span><div class="title">Inflation Calculator</div><div class="desc">Real return after inflation</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>
<script>
const fmt = n => new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function calculate() {
    const iv = parseFloat(document.getElementById('initialVal').value)||0;
    const fv = parseFloat(document.getElementById('finalVal').value)||0;
    const yr = parseFloat(document.getElementById('years').value)||0;
    if(!iv||!fv||!yr||fv<=0||iv<=0||yr<=0){document.getElementById('initialState').style.display='flex';document.getElementById('resultsState').style.display='none';return;}
    const cagr = (Math.pow(fv/iv, 1/yr) - 1)*100;
    const gain = fv - iv;
    const absReturn = ((fv-iv)/iv)*100;
    document.getElementById('initialState').style.display='none';
    document.getElementById('resultsState').style.display='block';
    document.getElementById('cagrResult').textContent = cagr.toFixed(2)+'%';
    document.getElementById('r1').textContent = fmt(iv);
    document.getElementById('r2').textContent = fmt(fv);
    document.getElementById('r3').textContent = fmt(gain);
    document.getElementById('r4').textContent = absReturn.toFixed(2)+'%';
    document.getElementById('r5').textContent = yr+' Years';
    document.getElementById('r6').textContent = cagr.toFixed(2)+'%';
}
</script>
<%- include('partials/footer') %>

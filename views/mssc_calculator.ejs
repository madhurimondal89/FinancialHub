<%- include('partials/header') %>
<div class="form-card">
    <h3 class="mb-1">👩 Mahila Samman Savings Certificate (MSSC) Calculator</h3>
    <p class="text-center mb-4" style="color:var(--text-secondary);font-size:0.9rem;">Calculate 7.5% p.a. quarterly compounded 2-year maturity returns for women investors</p>
<%- include('partials/ad_unit') %>
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="mb-4">
                <label class="form-label">Deposit Amount (₹) (Max ₹2,00,000)</label>
                <div class="input-group"><span class="input-group-text">₹</span><input type="number" class="form-control" id="msscDeposit" value="200000" step="5000" min="1000" max="200000" oninput="calculate()"></div>
                <div id="msscWords" class="words-helper" style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;"></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Govt Interest Rate (% p.a.)</label>
                <div class="input-group"><input type="number" class="form-control" id="msscRate" value="7.5" step="0.1" readonly><span class="input-group-text">% p.a. (Fixed)</span></div>
            </div>
            <div class="mb-4">
                <label class="form-label">Tenure</label>
                <div class="input-group"><input type="number" class="form-control" value="2" readonly><span class="input-group-text">Years (Fixed 24 Months)</span></div>
            </div>
            <div class="highlight-box">
                <h4>📜 Mahila Samman Scheme Rules</h4>
                <p>• <strong>Eligibility:</strong> Exclusively for women and minor girls.<br>• <strong>Partial Withdrawal:</strong> Up to 40% of the balance can be withdrawn after 1 year.</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div id="resultsState">
                <div class="emi-result-display"><p class="label">Total Maturity Amount (2 Years)</p><p class="amount" id="msscMaturity" style="color:var(--accent-green);">₹2,32,044</p></div>
                <div class="emi-summary-card">
                    <div class="summary-item"><div class="label">Principal Deposit</div><div class="value" id="rDeposit">₹2,00,000</div></div>
                    <div class="summary-item"><div class="label">Total Interest Earned</div><div class="value" style="color:var(--gold);" id="rTotalInterest">+₹32,044</div></div>
                    <div class="summary-item"><div class="label">Compounding Frequency</div><div class="value" id="rComp">Quarterly (8 Quarters)</div></div>
                    <div class="summary-item"><div class="label">Effective Annual Yield</div><div class="value" id="rYield">7.71% p.a.</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="related-section"><h5>🔗 Related Calculators</h5>
        <div class="row g-3">
            <div class="col-md-4"><a href="/ssy-calculator" class="related-card"><span class="icon">👧</span><div class="title">Sukanya Samriddhi (SSY)</div><div class="desc">8.2% Girl child scheme</div></a></div>
            <div class="col-md-4"><a href="/nsc-calculator" class="related-card"><span class="icon">📜</span><div class="title">NSC Calculator</div><div class="desc">7.7% 5-year savings</div></a></div>
            <div class="col-md-4"><a href="/fd-calculator" class="related-card"><span class="icon">🏦</span><div class="title">FD Calculator</div><div class="desc">Bank fixed deposits</div></a></div>
        </div>
    </div>
<%- include('partials/ad_unit') %>
</div>
<!-- Toolbar -->
<div class="action-toolbar" id="msscToolbar">
    <span class="toolbar-label">Tools:</span>
    <button type="button" class="btn-action-tool" id="msscBtnSave">💾 Save Calculation</button>
    <button type="button" class="btn-action-tool btn-whatsapp" id="msscBtnShare">💬 Share on WhatsApp</button>
    <button type="button" class="btn-action-tool" id="msscBtnCopy">🔗 Copy Link</button>
</div>
<script>
const fmt = n => new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
function calculate() {
    const P = parseFloat(document.getElementById('msscDeposit').value)||0;
    const rateAnnual = 0.075; // 7.5%

    if(typeof attachNumberToWords === 'function') {
        const el = document.getElementById('msscWords');
        if(el) el.textContent = convertNumberToIndianWords(P);
    }

    if(P <= 0) return;

    // MSSC: 2 years, quarterly compounding (n = 8 quarters)
    // A = P * (1 + r/4)^(4*2)
    const maturity = P * Math.pow(1 + (rateAnnual / 4), 8);
    const totalInterest = maturity - P;

    document.getElementById('msscMaturity').textContent = fmt(maturity);
    document.getElementById('rDeposit').textContent = fmt(P);
    document.getElementById('rTotalInterest').textContent = '+' + fmt(totalInterest);

    window._lastMSSC = { P, totalInterest, maturity };
}
document.addEventListener('DOMContentLoaded', () => {
    calculate();
    document.getElementById('msscBtnSave').addEventListener('click', () => {
        const d = window._lastMSSC; if(!d) return;
        const name = prompt('Save as:', `MSSC Deposit ${fmt(d.P)}`);
        if(name) saveCalculation(name, { Deposit: fmt(d.P), TotalInterest: fmt(d.totalInterest), Maturity: fmt(d.maturity) });
    });
    document.getElementById('msscBtnShare').addEventListener('click', () => {
        const d = window._lastMSSC; if(!d) return;
        shareViaWhatsApp('MSSC Calculator', `Deposit: ${fmt(d.P)}\nRate: 7.5% Quarterly Compounded\nInterest Earned: ${fmt(d.totalInterest)}\n2-Year Maturity Amount: ${fmt(d.maturity)}`);
    });
    document.getElementById('msscBtnCopy').addEventListener('click', copyShareableURL);
});
</script>
<%- include('partials/footer') %>
